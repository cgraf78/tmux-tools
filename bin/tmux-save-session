#!/usr/bin/env bash
# tmux-save-session -- save tmux session layout for later restoration.
#
# Captures window names, pane layouts, pane working directories, and the active
# window. Restore files are executable Bash scripts under the session save dir.

set -euo pipefail

_self="${BASH_SOURCE[0]}"
if [[ -L "$_self" ]]; then
  _target="$(readlink "$_self")"
  [[ "$_target" == /* ]] || _target="$(cd "$(dirname "$_self")" && pwd)/$_target"
  _self="$_target"
fi
# shellcheck source=lib/tmux-tools/session.sh
. "$(cd "$(dirname "$_self")/.." && pwd)/lib/tmux-tools/session.sh"
unset _self _target

_usage() {
  cat <<'EOF'
Usage: tmux-save-session [--dir DIR] [session-name]

Save a tmux session layout for later restoration.

Arguments:
  session-name       Session to save. Defaults to the current tmux session.

Options:
  -d, --dir DIR      Directory for saved restore scripts.
                    Defaults to $TMUX_TOOLS_SESSION_DIR, then
                    an absolute $XDG_DATA_HOME/tmux/sessions, then
                    ~/.local/share/tmux/sessions.
  -h, --help         Show this help.
EOF
}

_die() {
  printf 'tmux-save-session: %s\n' "$*" >&2
  exit 2
}

_quote() {
  printf '%q' "$1"
}

_validate_session_name() {
  local session="$1"
  [[ -n "$session" ]] || _die "session name is empty"
  if [[ "$session" != "${session//[^A-Za-z0-9._-]/}" ]]; then
    _die "session name contains unsafe characters: $session"
  fi
}

save_dir=""
save_dir_set=0
session=""

while (($#)); do
  case "$1" in
    -d | --dir)
      shift
      (($#)) || _die "--dir requires a value"
      save_dir="$1"
      save_dir_set=1
      shift
      ;;
    --dir=*)
      save_dir="${1#--dir=}"
      [[ -n "$save_dir" ]] || _die "--dir requires a value"
      save_dir_set=1
      shift
      ;;
    -h | --help)
      _usage
      exit 0
      ;;
    --)
      shift
      (($# <= 1)) || _die "expected at most one session name"
      session="${1:-}"
      shift "$#"
      ;;
    -*)
      _die "unknown option: $1"
      ;;
    *)
      [[ -z "$session" ]] || _die "expected at most one session name"
      session="$1"
      shift
      ;;
  esac
done

if ((save_dir_set == 0)); then
  tmux_tools_resolve_session_dir ||
    _die "HOME is not set and XDG_DATA_HOME is not absolute"
  save_dir="$REPLY"
fi
[[ -n "$save_dir" ]] || _die "save directory is empty"

if [[ -z "$session" ]]; then
  session=$(tmux display-message -p '#S' 2>/dev/null) ||
    _die "not in a tmux session; pass a session name"
fi

_validate_session_name "$session"

if ! tmux has-session -t "$session" 2>/dev/null; then
  _die "no such tmux session: $session"
fi

old_umask=$(umask)
umask 077
mkdir -p "$save_dir"
umask "$old_umask"
outfile="$(tmux_tools_session_file "$save_dir" "$session")"
[[ ! -d "$outfile" ]] || _die "save destination is a directory: $outfile"
tmpfile=""
tmp_prefix="$save_dir/.${session}.sh.tmp.$$"
tmp_identity=""
redirected=""
pending_signal=0

_file_identity() {
  local path="$1" identity

  [[ "$path" != -* ]] || path="./$path"
  if identity=$(stat -L -c '%d:%i' "$path" 2>/dev/null); then
    :
  elif identity=$(stat -L -f '%d:%i' "$path" 2>/dev/null); then
    :
  else
    return 1
  fi
  REPLY="$identity"
}

_owns_temporary_path() {
  local path="$1"

  [[ -n "$tmp_identity" && -f "$path" && ! -L "$path" ]] || return 1
  _file_identity "$path" && [[ "$REPLY" == "$tmp_identity" ]]
}

_creation_error() {
  # Close the check-to-error window while retaining the first recorded signal.
  trap '_record_signal 129; exit "$pending_signal"' HUP
  trap '_record_signal 130; exit "$pending_signal"' INT
  trap '_record_signal 143; exit "$pending_signal"' TERM
  if ((pending_signal)); then
    exit "$pending_signal"
  fi
  _die "$@"
}

_create_tmpfile() {
  local attempt old_umask had_noclobber=0

  [[ ! -o noclobber ]] || had_noclobber=1

  for ((attempt = 0; attempt < 100; attempt++)); do
    tmpfile="$tmp_prefix.$RANDOM.$RANDOM"
    old_umask=$(umask)
    umask 077
    set -o noclobber
    if { exec 3>"$tmpfile"; } 2>/dev/null; then
      ((had_noclobber)) || set +o noclobber
      umask "$old_umask"
      [[ -f "$tmpfile" && ! -L "$tmpfile" ]] ||
        _creation_error "temporary save changed during creation: $tmpfile"
      if ! _file_identity "$tmpfile"; then
        _creation_error "cannot identify temporary save: $tmpfile"
      fi
      tmp_identity="$REPLY"
      if ! _owns_temporary_path "$tmpfile"; then
        _creation_error "temporary save changed during creation: $tmpfile"
      fi
      return 0
    fi
    ((had_noclobber)) || set +o noclobber
    umask "$old_umask"
  done
  tmpfile=""
  _creation_error "cannot create an exclusive temporary save in: $save_dir"
}

# shellcheck disable=SC2317,SC2329 # Invoked indirectly by the EXIT trap.
_cleanup() {
  if [[ -n "$tmpfile" ]] && _owns_temporary_path "$tmpfile"; then
    rm -f -- "$tmpfile" || :
  fi
  if [[ -n "$redirected" ]] && _file_identity "$redirected" &&
    [[ -n "$tmp_identity" && "$REPLY" == "$tmp_identity" ]]; then
    rm -f -- "$redirected" || :
  fi
  exec 3>&- 2>/dev/null || :
}

# shellcheck disable=SC2317,SC2329 # Invoked indirectly by signal traps.
_record_signal() {
  if ((pending_signal == 0)); then
    pending_signal="$1"
  fi
}

trap _cleanup EXIT
# Cleanup cannot safely unlink the temporary path until its inode is recorded.
trap '_record_signal 129' HUP
trap '_record_signal 130' INT
trap '_record_signal 143' TERM
_create_tmpfile
trap '_record_signal 129; exit "$pending_signal"' HUP
trap '_record_signal 130; exit "$pending_signal"' INT
trap '_record_signal 143; exit "$pending_signal"' TERM
if ((pending_signal)); then
  exit "$pending_signal"
fi

# One session-scoped query keeps save latency proportional to the data returned,
# not to the number of windows. Length-prefix every field because window names
# and paths may contain any delimiter or newline. tmux's n: modifier reports
# byte lengths, so the parser uses the C locale for matching byte offsets.
session_format='#{n:window_id}:#{window_id}'
session_format+='#{n:window_index}:#{window_index}'
session_format+='#{n:window_name}:#{window_name}'
session_format+='#{n:window_layout}:#{window_layout}'
session_format+='#{n:window_active}:#{window_active}'
session_format+='#{n:pane_index}:#{pane_index}'
session_format+='#{n:pane_active}:#{pane_active}'
session_format+='#{n:pane_current_path}:#{pane_current_path}.'
session_data=$(tmux list-panes -s -t "$session" -F "$session_format")

_read_session_byte() {
  local LC_ALL=C
  IFS= read -r -d '' -n 1 REPLY <&4
}

_read_session_field() {
  local LC_ALL=C allow_eof="${1:-0}" byte length_text="" field_length

  if ! IFS= read -r -d '' -n 1 byte <&4; then
    ((allow_eof)) && return 1
    _die "tmux returned malformed session data"
  fi
  while [[ "$byte" != : ]]; do
    [[ "$byte" == [0-9] ]] || _die "tmux returned malformed session data"
    length_text+="$byte"
    IFS= read -r -d '' -n 1 byte <&4 ||
      _die "tmux returned malformed session data"
  done
  [[ -n "$length_text" ]] || _die "tmux returned malformed session data"

  field_length=$((10#$length_text))
  REPLY=""
  if ((field_length)); then
    IFS= read -r -d '' -n "$field_length" REPLY <&4 ||
      _die "tmux returned malformed session data"
    ((${#REPLY} == field_length)) || _die "tmux returned malformed session data"
  fi
}

_read_session_record() {
  _read_session_field 1 || return 1
  window_id=$REPLY
  _read_session_field
  window_index=$REPLY
  _read_session_field
  window_name=$REPLY
  _read_session_field
  window_layout=$REPLY
  _read_session_field
  window_active=$REPLY
  _read_session_field
  pane_index=$REPLY
  _read_session_field
  pane_active=$REPLY
  _read_session_field
  pane_dir=$REPLY

  _read_session_byte || _die "tmux returned malformed session data"
  [[ "$REPLY" == . ]] || _die "tmux returned malformed session data"
  if _read_session_byte; then
    [[ "$REPLY" == $'\n' ]] || _die "tmux returned malformed session data"
  fi
}

active_window_index=""
session_record_count=0
record_window_ids=()
record_window_indexes=()
record_window_names=()
record_window_layouts=()
record_pane_active=()
record_pane_dirs=()
exec 4< <(printf '%s' "$session_data")
while _read_session_record; do
  [[ -n "$window_id" && "$window_id" == @* &&
    -n "${window_id#@}" && "${window_id#@}" != *[!0-9]* &&
    -n "$window_index" && "$window_index" != *[!0-9]* &&
    -n "$window_layout" &&
    ("$window_active" == 0 || "$window_active" == 1) &&
    -n "$pane_index" && "$pane_index" != *[!0-9]* &&
    ("$pane_active" == 0 || "$pane_active" == 1) ]] ||
    _die "tmux returned malformed session data"
  session_record_count=$((session_record_count + 1))
  if [[ "$window_active" == 1 ]]; then
    if [[ -z "$active_window_index" ]]; then
      active_window_index="$window_index"
    elif [[ "$active_window_index" != "$window_index" ]]; then
      _die "tmux reported multiple active windows"
    fi
  fi
  record_window_ids+=("$window_id")
  record_window_indexes+=("$window_index")
  record_window_names+=("$window_name")
  record_window_layouts+=("$window_layout")
  record_pane_active+=("$pane_active")
  record_pane_dirs+=("$pane_dir")
done
exec 4<&-
unset session_data
((session_record_count > 0)) || _die "tmux returned no panes for session: $session"
[[ -n "$active_window_index" ]] || _die "tmux did not report an active window"

_emit_saved_window() {
  local p last_pane_position

  ((${#pane_dirs[@]} > 0)) || _die "tmux returned a window without panes"
  ((active_pane_count == 1)) ||
    _die "tmux did not report exactly one active pane for window: $current_window_index"

  printf 'window_indexes+=(%s)\n' "$(_quote "$current_window_index")"
  if ((saved_window_position == 0)); then
    # shellcheck disable=SC2016 # emitted into the generated restore script.
    printf 'window_id=$(_new_session_window %s %s)\n' \
      "$(_quote "$current_window_name")" "$(_quote "${pane_dirs[0]:-$HOME}")"
  else
    # shellcheck disable=SC2016 # emitted into the generated restore script.
    printf 'window_id=$(_new_window %s %s)\n' \
      "$(_quote "$current_window_name")" "$(_quote "${pane_dirs[0]:-$HOME}")"
  fi
  # shellcheck disable=SC2016 # emitted into the generated restore script.
  printf 'window_ids+=("$window_id")\n'

  for ((p = 1; p < ${#pane_dirs[@]}; p++)); do
    # shellcheck disable=SC2016 # emitted into the generated restore script.
    printf '_split_window "$window_id" %s\n' "$(_quote "${pane_dirs[$p]}")"
  done

  if ((${#pane_dirs[@]} > 1)); then
    # shellcheck disable=SC2016 # emitted into the generated restore script.
    printf 'tmux select-layout -t "$window_id" %s\n' \
      "$(_quote "$current_window_layout")"
  fi

  last_pane_position=$((${#pane_dirs[@]} - 1))
  if [[ "$active_pane_position" != "$last_pane_position" ]]; then
    # Every split selects its new pane, so avoid adding a restore-side tmux call
    # when the saved active pane is already the last pane created.
    # shellcheck disable=SC2016 # emitted into the generated restore script.
    printf '_select_pane_position "$window_id" %s\n' "$active_pane_position"
  fi

  printf '\n'
  saved_window_position=$((saved_window_position + 1))
}

{
  printf '#!/usr/bin/env bash\n'
  printf 'set -euo pipefail\n'
  printf '# Saved: %s\n' "$(date -Iseconds)"
  printf '# Session: %s\n\n' "$session"
  printf 'SESSION=%s\n' "$(_quote "$session")"
  printf 'ACTIVE_WINDOW_INDEX=%s\n\n' "$(_quote "$active_window_index")"
  cat <<'EOF'
_existing_dir() {
  local dir="$1"
  if [[ -d "$dir" ]]; then
    printf '%s\n' "$dir"
  else
    printf '%s\n' "${HOME:-/}"
  fi
}

_new_session_window() {
  local name="$1"
  local dir
  dir=$(_existing_dir "$2")
  tmux new-session -d -P -F '#{window_id}' -s "$SESSION" -n "$name" -c "$dir"
}

_new_window() {
  local name="$1"
  local dir
  dir=$(_existing_dir "$2")
  tmux new-window -P -F '#{window_id}' -t "$SESSION" -n "$name" -c "$dir"
}

_split_window() {
  local target="$1"
  local dir
  dir=$(_existing_dir "$2")
  tmux split-window -t "$target" -c "$dir"
}

_select_pane_position() {
  local target="$1" wanted="$2" panes pane_id position=0
  panes=$(tmux list-panes -t "$target" -F '#{pane_id}') || return
  while IFS= read -r pane_id; do
    if [[ "$position" == "$wanted" ]]; then
      tmux select-pane -t "$pane_id"
      return
    fi
    position=$((position + 1))
  done <<<"$panes"
  return 1
}

if tmux has-session -t "$SESSION" 2>/dev/null; then
  printf 'tmux session already exists: %s\n' "$SESSION" >&2
  exit 1
fi

window_ids=()
window_indexes=()

EOF

  current_window_id=""
  current_window_index=""
  current_window_name=""
  current_window_layout=""
  pane_dirs=()
  active_pane_position=""
  active_pane_count=0
  saved_window_position=0
  for ((record_position = 0; record_position < session_record_count; record_position++)); do
    window_id="${record_window_ids[$record_position]}"
    window_index="${record_window_indexes[$record_position]}"
    window_name="${record_window_names[$record_position]}"
    window_layout="${record_window_layouts[$record_position]}"
    pane_active="${record_pane_active[$record_position]}"
    pane_dir="${record_pane_dirs[$record_position]}"

    if [[ -n "$current_window_id" &&
      ("$window_id" != "$current_window_id" ||
      "$window_index" != "$current_window_index") ]]; then
      _emit_saved_window
      pane_dirs=()
      active_pane_position=""
      active_pane_count=0
    fi

    if [[ "$window_id" != "$current_window_id" ||
      "$window_index" != "$current_window_index" ]]; then
      current_window_id="$window_id"
      current_window_index="$window_index"
      current_window_name="$window_name"
      current_window_layout="$window_layout"
    elif [[ "$window_index" != "$current_window_index" ||
      "$window_name" != "$current_window_name" ||
      "$window_layout" != "$current_window_layout" ]]; then
      _die "tmux returned inconsistent data for window: $current_window_id"
    fi

    if [[ "$pane_active" == 1 ]]; then
      active_pane_position="${#pane_dirs[@]}"
      active_pane_count=$((active_pane_count + 1))
    fi
    pane_dirs+=("$pane_dir")
  done
  [[ -z "$current_window_id" ]] || _emit_saved_window

  cat <<'EOF'
for i in "${!window_indexes[@]}"; do
  if [[ "${window_indexes[$i]}" == "$ACTIVE_WINDOW_INDEX" ]]; then
    tmux select-window -t "${window_ids[$i]}"
    break
  fi
done
EOF
} >&3

bash -n "$tmpfile"
_owns_temporary_path "$tmpfile" ||
  _die "temporary save changed before publication: $tmpfile"
chmod 700 "$tmpfile" || _die "cannot secure temporary save: $tmpfile"
if ! _owns_temporary_path "$tmpfile"; then
  _die "temporary save changed before publication: $tmpfile"
fi
redirected="$outfile/${tmpfile##*/}"
# A signal delivered while Bash waits for mv runs its trap before the next
# command. Defer that signal until the installed inode tells us whether the
# atomic replacement committed.
trap '_record_signal 129' HUP
trap '_record_signal 130' INT
trap '_record_signal 143' TERM
mv_status=0
mv -- "$tmpfile" "$outfile" || mv_status=$?
redirected_owned=0
if _file_identity "$redirected" && [[ "$REPLY" == "$tmp_identity" ]]; then
  redirected_owned=1
fi
if ((redirected_owned == 0)) && {
  ((mv_status == 0)) || [[ ! -e "$tmpfile" && ! -L "$tmpfile" ]]
}; then
  tmpfile=""
  redirected=""
  exec 3>&- 2>/dev/null || :
  # The rename is the commit point. Nothing after it may report failure while
  # leaving the new save installed.
  trap '' HUP INT TERM
  trap - EXIT
  printf 'saved: %s\n' "$outfile" || :
  exit 0
else
  if ((redirected_owned)); then
    rm -f -- "$redirected" || :
  fi
  if ((pending_signal)); then
    exit "$pending_signal"
  fi
  if ((mv_status)); then
    _die "cannot publish save: $outfile"
  fi
  _die "save destination changed during publication: $outfile"
fi
