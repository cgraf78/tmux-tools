#!/usr/bin/env bash
# Copy the last N commands and their output from the current tmux pane to the
# clipboard, or print them for another command to route. Parses pane content
# for prompt boundaries to isolate command+output blocks.
#
# Prompt format (two-line):
#   [exit_code] user@host:path (branch)
#   $ command   (bash)
#   % command   (zsh)
#
# Usage: tmux-copy-last-output [--print] [--pane PANE] [--client CLIENT] [count]

set -euo pipefail

usage() {
  printf 'usage: tmux-copy-last-output [--print] [--pane PANE] [--client CLIENT] [positive-count]\n' >&2
  exit 64
}

# --print writes the blocks to stdout instead of the clipboard, so a binding
# can route them elsewhere, such as pasting into another pane.
print=false
pane=''
client=''
while (($#)); do
  case "$1" in
    --print)
      [[ "$print" == false ]] || usage
      print=true
      shift
      ;;
    --pane)
      (($# >= 2)) && [[ -z "$pane" && "$2" =~ ^%[0-9]+$ ]] || usage
      pane=$2
      shift 2
      ;;
    --client)
      (($# >= 2)) && [[ -z "$client" && -n "$2" ]] || usage
      client=$2
      shift 2
      ;;
    --*) usage ;;
    *) break ;;
  esac
done
[[ -z "$client" || -n "$pane" ]] || usage
(($# <= 1)) || usage
count="${1-1}"
if [[ ! "$count" =~ ^[0-9]+$ || ! "$count" =~ [1-9] ]]; then
  usage
fi
# Normalize leading zeroes so later string and arithmetic consumers always see
# an unambiguous base-10 value.
count="${count#"${count%%[!0]*}"}"

# Search the last 10,000 lines. The old 500-line window lost a command whose
# own output scrolled its prompt out of range, which is exactly when copying
# it matters, but the whole history is unbounded: a 90,000-line build log
# makes a 15 MB OSC 52 write that terminals drop (VS Code's limit is 10M
# characters) and a paste no agent wants. 10,000 lines stays near 1 MB.
capture_args=(-p -S -10000)
[[ -z "$pane" ]] || capture_args+=(-t "$pane")
content=$(tmux capture-pane "${capture_args[@]}")

output=$(printf '%s\n' "$content" | awk -v count="$count" '
# Two-line prompt detection:
#   Line 1: [optional exit code] user@host:path (git info) timing
#   Line 2: $ command
#
# Buffer line-1 candidates so output lines that happen to match the
# user@host: pattern are not silently dropped.

# Flush an unconfirmed line-1 candidate back into regular output.
function flush_candidate() {
  if (cand_nr > 0) {
    lines[cand_nr] = cand_line
    cand_nr = 0
  }
}

# Match prompt line 1: optional [N] then user@host:
/^(\[?[0-9]*\]? ?)?[a-zA-Z0-9_]+@[a-zA-Z0-9._-]+:/ {
  flush_candidate()
  cand_nr = NR
  cand_line = $0
  next
}

# Match prompt line 2: $ (bash) or % (zsh), with optional command,
# immediately after line 1.  tmux trims trailing whitespace, so a bare
# prompt with no command appears as just "$" or "%".
/^[$%]($| )/ {
  if (cand_nr > 0 && NR == cand_nr + 1) {
    n++
    prompts[n] = cand_nr
    cmd_lines[n] = (length($0) > 2) ? substr($0, 3) : ""
    shell_char[n] = substr($0, 1, 1)
    cand_nr = 0
    next
  }
  # Not preceded by a line-1 match — treat as regular output
  flush_candidate()
}

{ lines[NR] = $0 }

END {
  flush_candidate()
  if (n < 2) exit 1
  start = n - count
  if (start < 1) start = 1
  first = 1
  for (c = start; c < n; c++) {
    if (!first) print ""
    first = 0
    cmd = cmd_lines[c]
    if (cmd != "") print shell_char[c] " " cmd
    out_start = prompts[c] + 2
    out_end = prompts[c+1] - 1
    for (i = out_start; i <= out_end; i++)
      if (i in lines) print lines[i]
  }
}
') || true

if [[ -z "$output" ]]; then
  tmux display-message "No command output found"
  # Both modes report it, but only a printing caller gets a status, so a
  # pipeline routes nothing while a clipboard keybinding stays quiet. Status 3
  # stays distinct from the 1 that an unexpected failure exits with.
  [[ "$print" == false ]] || exit 3
  exit 0
fi

if [[ "$print" == true ]]; then
  printf '%s\n' "$output"
  exit 0
fi

fail_copy() {
  local backend="$1"
  local details="${2:-unknown error}"

  details="${details//$'\n'/ }"
  tmux display-message "Clipboard copy failed via $backend: $details"
  exit 0
}

copy_with() {
  { printf '%s' "$output" | "$@" >/dev/null; } 2>&1
}

copy_errors=()
copied=false
if command -v clip &>/dev/null; then
  copy_args=(copy)
  [[ -z "$client" ]] || copy_args+=(--client "$client" --pane "$pane")
  if ! err=$(copy_with clip "${copy_args[@]}"); then
    fail_copy clip "$err"
  fi
  copied=true
elif [[ -n "$client" ]]; then
  # Let tmux deliver OSC 52 to the initiating client. An implicit client lookup
  # can select a different machine attached to this same server.
  actual_client=$(tmux display-message -p -c "$client" '#{client_name}') ||
    fail_copy tmux 'initiating client is no longer attached'
  [[ "$actual_client" == "$client" ]] ||
    fail_copy tmux 'initiating client is no longer attached'
  if ! err=$(copy_with tmux load-buffer -w -t "$client" -); then
    fail_copy tmux "$err"
  fi
  copied=true
elif command -v pbcopy &>/dev/null; then
  if ! err=$(copy_with pbcopy); then
    copy_errors+=("pbcopy: ${err:-unknown error}")
  else
    copied=true
  fi
fi

if [[ "$copied" == false && -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy &>/dev/null; then
  if ! err=$(copy_with wl-copy); then
    copy_errors+=("wl-copy: ${err:-unknown error}")
  else
    copied=true
  fi
fi

if [[ "$copied" == false ]] && command -v xclip &>/dev/null && [[ -n "${DISPLAY:-}" ]]; then
  if ! err=$(copy_with xclip -selection clipboard); then
    copy_errors+=("xclip: ${err:-unknown error}")
  else
    copied=true
  fi
fi

if [[ "$copied" == false ]]; then
  fail_copy "available backends" "${copy_errors[*]:-no host clipboard; pass --pane and --client for OSC 52}"
fi

if [[ "$count" == 1 ]]; then
  tmux display-message "Copied last command + output to clipboard"
else
  tmux display-message "Copied last $count commands + output to clipboard"
fi
