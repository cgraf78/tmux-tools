#!/usr/bin/env bash
# Copy the last N commands and their output from the current tmux pane to the
# clipboard, or print them for another command to route. Parses pane content
# for prompt boundaries to isolate command+output blocks.
#
# Prompt format (two-line):
#   [exit_code] user@host:path (branch)
#   $ command   (bash)
#   % command   (zsh)
#
# Usage: tmux-copy-last-output [--print] [--pane PANE] [--client CLIENT] [count]

set -euo pipefail

usage() {
  printf 'usage: tmux-copy-last-output [--print] [--pane PANE] [--client CLIENT] [positive-count]\n' >&2
  exit 64
}

# --print writes the blocks to stdout instead of the clipboard, so a binding
# can route them elsewhere, such as pasting into another pane.
print=false
pane=''
client=''
while (($#)); do
  case "$1" in
    --print)
      [[ "$print" == false ]] || usage
      print=true
      shift
      ;;
    --pane)
      (($# >= 2)) && [[ -z "$pane" && "$2" =~ ^%[0-9]+$ ]] || usage
      pane=$2
      shift 2
      ;;
    --client)
      (($# >= 2)) && [[ -z "$client" && -n "$2" ]] || usage
      client=$2
      shift 2
      ;;
    --*) usage ;;
    *) break ;;
  esac
done
[[ -z "$client" || -n "$pane" ]] || usage
(($# <= 1)) || usage
count="${1-1}"
if [[ ! "$count" =~ ^[0-9]+$ || ! "$count" =~ [1-9] ]]; then
  usage
fi
# Normalize leading zeroes so later string and arithmetic consumers always see
# an unambiguous base-10 value.
count="${count#"${count%%[!0]*}"}"

# Search the last 10,000 lines. The old 500-line window lost a command whose
# own output scrolled its prompt out of range, which is exactly when copying
# it matters, but the whole history is unbounded: a 90,000-line build log
# makes a 15 MB OSC 52 write that terminals drop (VS Code's limit is 10M
# characters) and a paste no agent wants. 10,000 lines stays near 1 MB.
capture_args=(-p -S -10000)
[[ -z "$pane" ]] || capture_args+=(-t "$pane")
content=$(tmux capture-pane "${capture_args[@]}")

# BEGIN prompt-parser
# Command-block parser for the two-line prompt (see README "Prompt format").
# tmux-copy-last-output and tmux-pane carry this region byte for byte; a test
# compares the two copies, so change both together.
#
# Input is a pane capture, one row or joined line per record. A prompt is a
# line 1 followed by a line 2 (`$`, `%` or `#`, then a space or nothing).
# Line 1 holds the identity `user@host:` and, after a failure, a leading
# `[N] ` status. Bash prints a prompt right after output that lacks a final
# newline, so line 1 can arrive glued to that output (`ok[1] me@host:~`). The
# identity tells the two apart: it is the -v ident preset, else the identity
# most confirmed prompts agree on. Glued output changes the prefix but never
# the identity, so the most frequent one is the real one. A preset identity
# is the only one accepted; without one, any anchored line 1 also counts.
# A `#` line 2 also starts comments and headings in output, so its line 1
# must start with the identity (after an optional `[N] `), never glued.
#
# Variables (-v):
#   mode     blocks (default), state, ident, confirm or anchor
#   count    blocks: how many of the last finished blocks to print
#   ident    the identity to look for; empty means use the consensus
#   from     blocks: print every block whose line 2 is at or after this record
#   first2   blocks: record 1 is a line 2 whose line 1 is not in the capture
#   status   blocks: end with a line holding \034 and the last block status
# Output:
#   blocks   each block as its `$ command` line, then its output; blocks are
#            separated by an empty line. Exits 1 when no block is complete.
#   state    `prompt N` when the last record is a line 2 under a line 1
#            whose status is N, else `none`
#   ident    the consensus identity, or nothing
#   confirm  1 when some record is a line 1 with the -v ident preset, else 0
#   anchor   the identity record 1 starts with (no status prefix), or nothing
# shellcheck disable=SC2016 # An awk program: its $ are awk syntax.
prompt_parser='
function line2(s) { return s ~ /^[$%#]($| )/ }
# The identity an anchored line 1 starts with, or "".
function anchored(s,   t) {
  if (!match(s, /^(\[?[0-9]*\]? ?)?[a-zA-Z0-9_]+@[a-zA-Z0-9._-]+:/)) return ""
  t = substr(s, 1, RLENGTH)
  sub(/^(\[?[0-9]*\]? ?)?/, "", t)
  return t
}
# The identity most confirmed prompts agree on. Glue can only prepend word
# characters (`ok` + `me@host:` still matches the anchored pattern), so each
# candidate scores the prompts whose identity ends with it, and the shortest
# best scorer wins. It must score twice, or be the only candidate.
function consensus(   i, t, u, best, bs, sc, distinct) {
  distinct = 0
  for (i = 1; i < NR; i++) {
    if (!line2(rec[i + 1])) continue
    t = anchored(rec[i])
    if (t == "") continue
    if (!(t in cnt)) distinct++
    cnt[t]++
  }
  best = ""; bs = 0
  for (t in cnt) {
    sc = 0
    for (u in cnt)
      if (length(u) >= length(t) && substr(u, length(u) - length(t) + 1) == t) sc += cnt[u]
    if (sc > bs || (sc == bs && length(t) < length(best))) { bs = sc; best = t }
  }
  if (best == "" || (bs < 2 && distinct > 1)) return ""
  return best
}
# Record i is a line 1 when line 2 follows it. Sets glue (output text glued
# before the identity) and st (its status) for it.
function prompt1(i,   s, p, t, u, root) {
  if (i < 1 || i >= NR || !line2(rec[i + 1])) return 0
  s = rec[i]
  root = (substr(rec[i + 1], 1, 1) == "#")
  p = (id != "") ? index(s, id) : 0
  if (p > 0) {
    t = substr(s, 1, p - 1)
    if (root && t !~ /^(\[[0-9]+\] )?$/) return 0
    # Glue is output that lacked a final newline, so it ends right before
    # the identity; text ending in a space is a line that mentions it.
    u = t; sub(/\[[0-9]+\] $/, "", u)
    if (u ~ /[ \t]$/) return 0
  } else if (ident == "" && anchored(s) != "" && !(root && id != "")) {
    t = ""
    if (match(s, /^\[[0-9]+\] /)) t = substr(s, 1, RLENGTH)
  } else {
    return 0
  }
  st = 0
  if (match(t, /\[[0-9]+\] $/)) {
    st = substr(t, RSTART + 1)
    sub(/\].*/, "", st)
    t = substr(t, 1, RSTART - 1)
  }
  glue = t
  return 1
}
{ rec[NR] = $0 }
END {
  if (mode == "ident") {
    t = consensus()
    if (t != "") print t
    exit 0
  }
  if (mode == "anchor") {
    t = anchored(rec[1])
    if (t != "" && index(rec[1], t) == 1) print t
    exit 0
  }
  id = (ident != "") ? ident : consensus()
  if (mode == "confirm") {
    t = 0
    for (i = 1; i < NR; i++) if (prompt1(i)) { t = 1; break }
    print t
    exit 0
  }
  if (mode == "state") {
    if (NR >= 2 && line2(rec[NR]) && prompt1(NR - 1)) print "prompt " st
    else print "none"
    exit 0
  }
  n = 0
  if (first2 == 1 && NR >= 1 && line2(rec[1])) {
    n = 1; l2[1] = 1; pglue[1] = ""; pst[1] = 0
  }
  for (i = 1; i < NR; i++) {
    if (n > 0 && i <= l2[n]) continue
    if (prompt1(i)) {
      n++; l2[n] = i + 1; pglue[n] = glue; pst[n] = st; l1[n] = i
    }
  }
  if (n < 2) exit 1
  if (from != "") {
    start = 0
    for (c = 1; c < n; c++) if (l2[c] >= from + 0) { start = c; break }
    if (start == 0) exit 1
  } else {
    start = n - count
    if (start < 1) start = 1
  }
  first = 1
  for (c = start; c < n; c++) {
    if (!first) print ""
    first = 0
    if (length(rec[l2[c]]) > 2) print rec[l2[c]]
    for (i = l2[c] + 1; i < l1[c + 1]; i++) print rec[i]
    if (pglue[c + 1] != "") print pglue[c + 1]
  }
  if (status == 1) print "\034" pst[n]
}
'
# END prompt-parser

output=$(printf '%s\n' "$content" | awk -v mode=blocks -v count="$count" "$prompt_parser") || true

# Tell the pressing client. tmux 3.2 cannot aim a message at one client
# (display-message takes no argument to -c there), so there it goes to the
# client tmux picks, which may be another session's.
notify() {
  if [[ -n "$client" ]]; then
    tmux display-message -c "$client" -t "$pane" "$1" 2>/dev/null ||
      tmux display-message -t "$pane" "$1"
  else
    tmux display-message "$1"
  fi
}

if [[ -z "$output" ]]; then
  notify "No command output found"
  # Both modes report it, but only a printing caller gets a status, so a
  # pipeline routes nothing while a clipboard keybinding stays quiet. Status 3
  # stays distinct from the 1 that an unexpected failure exits with.
  [[ "$print" == false ]] || exit 3
  exit 0
fi

if [[ "$print" == true ]]; then
  printf '%s\n' "$output"
  exit 0
fi

fail_copy() {
  local backend="$1"
  local details="${2:-unknown error}"

  details="${details//$'\n'/ }"
  notify "Clipboard copy failed via $backend: $details"
  exit 0
}

copy_with() {
  { printf '%s' "$output" | "$@" >/dev/null; } 2>&1
}

copy_errors=()
copy_note=''
copied=false
if command -v clip &>/dev/null; then
  copy_args=(copy)
  [[ -z "$client" ]] || copy_args+=(--client "$client" --pane "$pane")
  if ! err=$(copy_with clip "${copy_args[@]}"); then
    fail_copy clip "$err"
  fi
  # clip can copy and still have something to say, such as history it could
  # not record. The Copied message below would replace its own notice.
  copy_note=$err
  copied=true
elif [[ -n "$client" ]]; then
  # Let tmux deliver OSC 52 to the initiating client. An implicit client lookup
  # can select a different machine attached to this same server, so match the
  # exact name among the attached clients: display-message -p -c answers for
  # the most recently active client, and tmux 3.2 takes no argument to -c.
  clients=$(tmux list-clients -F '#{client_name}') ||
    fail_copy tmux 'could not list tmux clients'
  [[ $'\n'"$clients"$'\n' == *$'\n'"$client"$'\n'* ]] ||
    fail_copy tmux 'initiating client is no longer attached'
  if ! err=$(copy_with tmux load-buffer -w -t "$client" -); then
    fail_copy tmux "$err"
  fi
  copied=true
elif command -v pbcopy &>/dev/null; then
  if ! err=$(copy_with pbcopy); then
    copy_errors+=("pbcopy: ${err:-unknown error}")
  else
    copied=true
  fi
fi

if [[ "$copied" == false && -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy &>/dev/null; then
  if ! err=$(copy_with wl-copy); then
    copy_errors+=("wl-copy: ${err:-unknown error}")
  else
    copied=true
  fi
fi

if [[ "$copied" == false ]] && command -v xclip &>/dev/null && [[ -n "${DISPLAY:-}" ]]; then
  if ! err=$(copy_with xclip -selection clipboard); then
    copy_errors+=("xclip: ${err:-unknown error}")
  else
    copied=true
  fi
fi

if [[ "$copied" == false ]]; then
  fail_copy "available backends" "${copy_errors[*]:-no host clipboard; pass --pane and --client for OSC 52}"
fi

if [[ "$count" == 1 ]]; then
  message="Copied last command + output to clipboard"
else
  message="Copied last $count commands + output to clipboard"
fi
[[ -z "$copy_note" ]] || message+=" (${copy_note//$'\n'/; })"
notify "$message"
