#!/usr/bin/env bash
# Exercise tmux-agent-picker against a mock tmux, without a real server.
# shellcheck disable=SC2016 # tmux ids ($1, %1) are literal text here.
set -uo pipefail
unset BASH_ENV ENV
ROOT=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)
# The floor and a release just below it, from the tools' own tmux_minimum,
# so these cases follow a floor bump.
floor_tmux=$(sed -n 's/^tmux_minimum=//p' "$ROOT/bin/tmux-agent-picker")
older_tmux=${floor_tmux%%.*}.$((${floor_tmux#*.} - 1))a
# The mocks report the floor itself unless a case says otherwise.
export floor_tmux
PICKER=$ROOT/bin/tmux-agent-picker
tmp=$(
  umask 077
  mktemp -d "${TMPDIR:-/tmp}/tap.XXXXXXXX"
) || exit 1
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/bin" "$tmp/popup-bin"

# The mock serves the snapshot, captures, clients and pane holders from files,
# runs a popup's command with the stand-in fzf, and logs every call.
cat >"$tmp/bin/tmux" <<'MOCK'
#!/usr/bin/env bash
# One line per call: the text query's newlines are logged as \n.
args="$*"
printf '%s\n' "${args//$'\n'/\\n}" >>"$MOCK_CALLS"
[ "$1" = -S ] && shift 2
[ "$1" = -u ] && shift
case "$1 $2" in
  'display-message -p')
    case $3 in
      R*)
        [ -z "${MOCK_SNAPSHOT_ERROR:-}" ] || { printf '%s\n' "$MOCK_SNAPSHOT_ERROR" >&2; exit 1; }
        if [ "${MOCK_GARBLE:-0}" = 1 ]; then echo 'garbled'; else printf 'R %s%s\n' "${MOCK_VERSION-$floor_tmux}" "${MOCK_MISSING:-}"; fi
        cat "$MOCK_STATE"
        ;;
      '#{version}') printf '%s\n' "${MOCK_VERSION-$floor_tmux}" ;;
      *) [ "${MOCK_PANE_GONE:-0}" = 1 ] && exit 1 ;;
    esac
    ;;
  'display-message -c')
    # tmux drops a message for a gone client silently, so only a server it
    # cannot reach fails.
    [ "${MOCK_SERVER_LOST:-0}" = 1 ] && { echo 'no server running' >&2; exit 1; }
    ;;
  'capture-pane -e')
    [ "${MOCK_CAPTURE_FAIL:-0}" = 1 ] && exit 1
    cat "$MOCK_CAPTURE"
    ;;
  'list-clients -F')
    [ "${MOCK_CLIENTS_FAIL:-0}" = 1 ] && { echo 'server exited unexpectedly' >&2; exit 1; }
    cat "$MOCK_CLIENTS"
    ;;
  'list-panes -a') cat "$MOCK_HOLDERS" ;;
  display-popup*)
    [ -z "${MOCK_POPUP_ERROR:-}" ] || { printf '%s\n' "$MOCK_POPUP_ERROR" >&2; exit 1; }
    # display-popup returns 129 when the client detaches or -C closes it.
    [ -z "${MOCK_POPUP_STATUS:-}" ] || exit "$MOCK_POPUP_STATUS"
    shift $(($# - 1))
    PATH="$MOCK_POPUP_PATH" sh -c "$1"
    ;;
  *) [ "${MOCK_JUMP_FAIL:-0}" = 1 ] && { echo "can't find window" >&2; exit 1; } ;;
esac
exit 0
MOCK
# The stand-in fzf records its arguments and the rows it was offered, then
# detaches the client if $MOCK_FZF_DETACH is set, exits with $MOCK_FZF_STATUS
# if set, or prints the first row containing
# $MOCK_PICK, or exits 130 (cancel).
cat >"$tmp/popup-bin/fzf" <<'FZF'
#!/bin/sh
printf '%s\n' "$@" >"$MOCK_FZF_ARGS"
cat >"$MOCK_FZF_OFFERED"
[ -z "$MOCK_FZF_DETACH" ] || : >"$MOCK_CLIENTS"
[ -z "$MOCK_FZF_STATUS" ] || { echo 'fzf: unknown option' >&2; exit "$MOCK_FZF_STATUS"; }
[ -z "$MOCK_CHOICE" ] || { printf '%s\n' "$MOCK_CHOICE"; exit 0; }
[ -n "$MOCK_PICK" ] || exit 130
grep -F -m 1 -- "$MOCK_PICK" "$MOCK_FZF_OFFERED" || exit 1
FZF
# Any ps call fails the suite: the picker reads tmux formats only.
cat >"$tmp/bin/ps" <<'PS'
#!/bin/sh
printf 'ps %s\n' "$*" >>"$MOCK_PS"
exit 1
PS
chmod +x "$tmp/bin/tmux" "$tmp/popup-bin/fzf" "$tmp/bin/ps"
ln -s "$tmp/popup-bin/fzf" "$tmp/bin/fzf"
export PATH="$tmp/bin:$PATH"
export MOCK_POPUP_PATH="$tmp/popup-bin:$PATH"
export MOCK_CALLS=$tmp/calls MOCK_STATE=$tmp/state MOCK_CAPTURE=$tmp/capture
export MOCK_CLIENTS=$tmp/clients MOCK_HOLDERS=$tmp/holders MOCK_PS=$tmp/ps
export MOCK_FZF_ARGS=$tmp/fzf-args MOCK_FZF_OFFERED=$tmp/fzf-offered MOCK_PICK='' MOCK_CHOICE='' MOCK_FZF_STATUS='' MOCK_FZF_DETACH=''
SOCKET=/private/test.sock
# The picker's temporary directories go here, so the suite can see what is
# left behind.
export TMPDIR=$tmp/scratch
mkdir "$TMPDIR"
leftovers() {
  local found=0 entry
  for entry in "$TMPDIR"/tmux-agent-picker.*; do
    [ -e "$entry" ] && found=$((found + 1))
  done
  printf '%s' "$found"
}
CLIENT=/dev/pts/7
failures=0
check() {
  local label=$1 expected=$2 actual=$3
  if [ "$expected" = "$actual" ]; then
    printf 'PASS: %s\n' "$label"
  else
    printf 'FAIL: %s: expected %q, got %q\n' "$label" "$expected" "$actual" >&2
    failures=$((failures + 1))
  fi
}
listing() {
  "$PICKER" --socket "$SOCKET" --list "$@"
}
# The rows' pane ids, in order.
panes() {
  listing | cut -f1 | tr '\n' ' '
}
# The visible part of each row, without colours.
visible() {
  listing "$@" | cut -f4- | sed $'s/\033\\[[0-9;]*m//g'
}
pad() {
  printf '%-24s' "$1"
}
e=$'\033'

# A snapshot: query 1's walk, query 2's text and the clients, as tmux prints
# them; the mock adds the line of unset required options before them. Each
# pane's text is three records: location, agent flag and basename, and label.
text_row() {
  local pane=$1 session=$2 location=$3 base=$4 agent=$5 label=$6
  printf 'L %s %s %s\nB %s %s %s %s\nX %s %s %s\n' "$pane" "$session" "$location" \
    "$pane" "$session" "$agent" "$base" "$pane" "$session" "$label"
}

# Walk order: %5 in session $3 comes before %1 in $1, unlike name order.
# Levels come from the first bit set: failed, waiting, done, working, agent.
{
  printf 'W'
  printf ' %s' '%5/@5/$3/00010/-/0' '%1/@1/$1/00001/-/0' '%2/@1/$1/01000/-/1' \
    '%3/@2/$1/10010/1/0' '%4/@3/$2/00100/-/0' '%6/@4/$2/00000/-/0' \
    '%7/@6/$3/10000/-/0' '%8/@6/$3/00100/-/0'
  printf ' \n'
  text_row %1 '$1' "$(pad 'work:1.1')" proj 1 'codex'
  text_row %2 '$1' "$(pad 'work:1.2')" tools 1 'claude · fix the test'
  text_row %3 '$1' "$(pad 'work:2.1')" home 0 'zsh · ~'
  text_row %4 '$2' "$(pad 'dev:1.1')" '' 0 ''
  text_row %5 '$3' "$(pad 'zeta:1.1')" api 1 'muse'
  text_row %7 '$3' "$(pad 'zeta:2.1')" '' 0 'make · ~/src'
  text_row %8 '$3' "$(pad 'zeta:2.2')" '' 0 'sleep · ~'
  printf 'C 0 %%2 %s\n' "$CLIENT"
  printf 'C 1 %%5 control\n'
} >"$MOCK_STATE"
: >"$MOCK_CALLS"
check 'rows go by level, each level in walk order' '%3 %7 %2 %4 %8 %5 %1 ' "$(panes)"
check 'one tmux invocation runs all four queries' 1 "$(wc -l <"$MOCK_CALLS" | tr -d ' ')"
call=$(cat "$MOCK_CALLS")
case $call in
  "-S $SOCKET -u display-message -p R"*' ; display-message -p W '*' ; list-panes -a -f '*' -F L '*' ; list-clients -F C '*) result=ok ;;
  *) result=$call ;;
esac
check 'the options, the walk, the text and the clients are one queued call' ok "$result"
# Every required option is checked, as set or not: 0 still counts as set.
required=$(sed -n "s/^required_options='\(.*\)'$/\1/p" "$PICKER")
read -r -a required_list <<<"$required"
check 'the picker names its required options' 6 "${#required_list[@]}"
unchecked=''
for option in "${required_list[@]}"; do
  case $call in
    *"#{?#{==:#{$option},}, $option,}"*) ;;
    *) unchecked="$unchecked $option" ;;
  esac
done
check 'the snapshot reports each required option left unset' '' "$unchecked"
case $call in
  *'#{S:#{W:#{?#{E:@window_counted},#{P:'*) result=ok ;;
  *) result=$call ;;
esac
check 'the walk dedupes linked windows as @attention_panes does' ok "$result"
case $call in
  *'#{?#{&&:#{E:@pane_marked_failed},#{&&:#{!=:#{@term_notify_pending},blocked},'*) result=ok ;;
  *) result=$call ;;
esac
check 'the exit field shows only for a local failed command' ok "$result"
case $call in
  *$'\t'*) result=tab ;;
  *) result=none ;;
esac
check 'no query format holds a tab' none "$result"
# The mock logs the format's newlines as \n; the carriage return is raw.
sanitised='/?/:'
case $call in
  *"}\\nB #{pane_id} #{session_id} "*" #{s/[\\n"$'\r'"]$sanitised#{b:pane_current_path}}\\nX #{pane_id} #{session_id} #{s/[\\n"$'\r'"]$sanitised#{E:@pane_label}}"*) result=ok ;;
  *) result=$call ;;
esac
check 'newlines in a directory or label cannot start a record' ok "$result"
check 'a pane matching no predicate is dropped' '' "$(listing | grep -F "%6$(printf '\t')")"

# Dots and columns: every row's location starts in the same column, with or
# without an exit status and a label.
rows=$(visible --client "$CLIENT")
check 'a failed command shows its exit status' "● exit 1  $(pad 'work:2.1')  zsh · ~" \
  "$(printf '%s\n' "$rows" | sed -n 1p)"
check 'other rows pad the status column' "●         $(pad 'zeta:2.1')  make · ~/src" \
  "$(printf '%s\n' "$rows" | sed -n 2p)"
check 'an agent row adds its basename, and here marks the client pane' \
  "●         $(pad 'work:1.2')  claude · fix the test   tools   [COPY]   here" \
  "$(printf '%s\n' "$rows" | sed -n 3p)"
check 'an empty label keeps the columns' "●         $(pad 'dev:1.1')  " \
  "$(printf '%s\n' "$rows" | sed -n 4p)"
check 'idle agents are listed last with a hollow dot' "○         $(pad 'work:1.1')  codex   proj" \
  "$(printf '%s\n' "$rows" | sed -n 7p)"
check 'here needs the client' '' "$(visible | grep -c 'here$' | grep -v '^0$')"
raw=$(listing)
colours=''
for expected in "1 ${e}[31m●" "3 ${e}[33m●" "4 ${e}[32m●" "6 ${e}[34m●" "7 ${e}[90m○"; do
  field=$(printf '%s\n' "$raw" | sed -n "${expected%% *}p" | cut -f4)
  case $field in "${expected#* }"*) ;; *) colours="$colours row ${expected%% *}: $field" ;; esac
done
check 'level colours are the basic ANSI ones' '' "$colours"
check 'every row has three hidden id fields' '%3	@2	$1' "$(printf '%s\n' "$raw" | sed -n 1p | cut -f1-3)"

# Malformed tokens are skipped, and a repeated pane keeps its first token.
{
  printf 'W'
  printf ' %s' '%x/@1/$1/10000/-/0' '%5/@1/$1/10000/-' '%6/@1/$1/10000/-/0/x' \
    '%7/@1/$1/1000/-/0' '%8/@1/1/10000/-/0' '%9/@1/$1/10000/e/0' \
    '%10/@1/$1/00100/-/0' '%10/@1/$1/10000/-/0' '%11/@1/$1/12000/-/0'
  printf ' \n'
} >"$MOCK_STATE"
check 'malformed tokens are skipped' '%10 ' "$(panes)"

# Multibyte text: tmux truncates a long or wide name by display width, and
# each field is its own record, so no awk measures it. Some awks count
# characters even under LC_ALL=C (Termux's gawk), others bytes.
wide='ünïcødé:1.1'
long='release-candidate-build…'
{
  printf 'W %s %s \n' '%1/@1/$1/00010/-/0' '%2/@2/$2/00010/-/0'
  text_row %1 '$1' "$wide$(printf '%13s' '')" 'dïr' 1 'codex · ✓ done'
  text_row %2 '$2' "$long" 'x' 1 'claude'
} >"$MOCK_STATE"
expected_wide="●  $wide$(printf '%13s' '')  codex · ✓ done   dïr"
expected_long="●  $long  claude   x"
awks=()
for candidate in gawk mawk nawk original-awk /usr/bin/awk awk; do
  found=$(type -P "$candidate" 2>/dev/null) || continue
  case " ${awks[*]-} " in *" $found "*) continue ;; esac
  awks+=("$found")
done
if type -P busybox >/dev/null 2>&1 && busybox awk 'BEGIN {}' 2>/dev/null; then
  awks+=(busybox)
fi
# A gawk forced into a UTF-8 locale counts characters, as Termux's does.
gawk_path=$(type -P gawk 2>/dev/null) || gawk_path=''
for locale in C.UTF-8 en_US.UTF-8; do
  [ -n "$gawk_path" ] || break
  if LC_ALL=$locale "$gawk_path" 'BEGIN { exit length("\303\251") != 1 }' 2>/dev/null; then
    awks+=("characters:$locale")
    break
  fi
done
for awk_path in "${awks[@]}"; do
  shim=$tmp/awk-$(printf '%s' "$awk_path" | tr '/' '_')
  mkdir -p "$shim"
  if [ "$awk_path" = busybox ]; then
    printf '#!/bin/sh\nexec busybox awk "$@"\n' >"$shim/awk"
    chmod +x "$shim/awk"
  elif [ "${awk_path#characters:}" != "$awk_path" ]; then
    printf '#!/bin/sh\nLC_ALL=%s exec %s "$@"\n' "${awk_path#characters:}" "$gawk_path" >"$shim/awk"
    chmod +x "$shim/awk"
  else
    ln -sf "$awk_path" "$shim/awk"
  fi
  rows=$(PATH="$shim:$PATH" visible)
  check "multibyte text keeps its fields ($awk_path)" \
    "$expected_wide"$'\n'"$expected_long" "$rows"
done
check 'at least one awk ran the multibyte case' 1 "$([ "${#awks[@]}" -gt 0 ] && echo 1)"

# A pane in a grouped session or linked window has text once per session:
# the row takes the text of the session query 1 walked it in.
{
  printf 'W %s \n' '%4/@3/$2/01000/-/0'
  text_row %4 '$1' "$(pad 'build:1.1')" '' 0 'wrong'
  text_row %4 '$2' "$(pad 'build-peer:1.1')" '' 0 'right'
  text_row %4 '$2' "$(pad 'repeat:1.1')" '' 0 'repeat'
} >"$MOCK_STATE"
check 'grouped text joins on pane and session' "●  $(pad 'build-peer:1.1')  right" "$(visible)"

# Hostile text is sanitised: control bytes become ?, and ## (doubled by the
# config for tmux's renderer) becomes #. Spaces and glob characters stay.
{
  printf 'W %s \n' '%9/@9/$9/01000/-/0'
  text_row %9 '$9' "$(pad 'w[1] *?:1.1')" "a${e}b" 1 "claude · x${e}[31my	z ## [*] ?"
} >"$MOCK_STATE"
check 'control bytes and ## are sanitised' \
  "●  $(pad 'w[1] *?:1.1')  claude · x?[31my?z # [*] ?   a?b" "$(visible)"

# The preview drops trailing lines that are blank once SGR codes are gone,
# then shows the last FZF_PREVIEW_LINES lines.
printf '%s\n' 'one' "${e}[31mHELLO${e}[0m" 'three' '' "${e}[0m" "  ${e}[44m  ${e}[0m" '' >"$MOCK_CAPTURE"
check 'the preview tails without trailing blank lines' "${e}[31mHELLO${e}[0m"$'\nthree' \
  "$(FZF_PREVIEW_LINES=2 "$PICKER" --socket "$SOCKET" --preview %3)"
seq 1 45 >"$MOCK_CAPTURE"
check 'the preview defaults to the last 40 lines' "$(seq 6 45)" \
  "$(env -u FZF_PREVIEW_LINES "$PICKER" --socket "$SOCKET" --preview %3)"
check 'a failing capture shows the pane closed' '(pane closed)' \
  "$(MOCK_CAPTURE_FAIL=1 "$PICKER" --socket "$SOCKET" --preview %3)"
: >"$MOCK_CALLS"
"$PICKER" --socket "$SOCKET" --preview %3 >/dev/null
check 'the preview captures the pane by id with colours' \
  "-S $SOCKET capture-pane -e -p -t %3" "$(cat "$MOCK_CALLS")"

# The popup and the jump. The client's session is $1; the stand-in fzf picks
# the row containing $MOCK_PICK.
{
  printf 'W %s %s %s %s \n' '%2/@2/$1/01000/-/0' '%4/@4/$2/00100/-/0' \
    '%5/@5/$3/00100/-/0' '%6/@6/$4/00100/-/0'
  text_row %2 '$1' "$(pad 'work:2.1')" '' 0 'own session'
  text_row %4 '$2' "$(pad 'w[1]:1.1')" '' 0 'grouped peer'
  text_row %5 '$3' "$(pad 'other:1.1')" '' 0 'other session'
  text_row %6 '$4' "$(pad 'gone:1.1')" '' 0 'killed session'
  printf 'C 0 %%1 %s\n' "$CLIENT"
} >"$MOCK_STATE"
printf '$1 0 %s\n' "$CLIENT" >"$MOCK_CLIENTS"
pick() {
  : >"$MOCK_CALLS"
  rm -f "$MOCK_FZF_ARGS" "$MOCK_FZF_OFFERED"
  MOCK_PICK=$1 "$PICKER" --socket "$SOCKET" --client "$CLIENT" </dev/null
}
# The jump queue: the calls after the popup.
jumped() {
  awk 'found { print } / display-popup / { found = 1 }' "$MOCK_CALLS" |
    grep -v -e ' list-clients ' -e ' list-panes -a -F '
}
printf '%s\n' '%2 @2 $1 1' '%2 @2 $5 0' >"$MOCK_HOLDERS"
output=$(pick 'own session' 2>&1)
check 'a jump prints nothing' '' "$output"
check 'a jump leaves no temporary directory' 0 "$(leftovers)"
check 'in its own session the pane is selected before its window' \
  "-S $SOCKET select-pane -t \$1:@2.%2 ; select-window -t \$1:@2.%2" "$(jumped)"
args=$(cat "$MOCK_FZF_ARGS")
for arg in --ansi --no-sort --reverse --no-multi --with-nth=4.. '--prompt=Agents> ' \
  '--header=Enter jump · Esc cancel · ctrl-r refresh' \
  '--preview-window=down,60%,border-top,nowrap' \
  "'$PICKER' --socket '$SOCKET' --preview {1}" \
  "ctrl-r:reload('$PICKER' --socket '$SOCKET' --list --client '$CLIENT')+refresh-preview"; do
  check "fzf gets $arg" 1 "$(grep -cxF -- "$arg" "$MOCK_FZF_ARGS")"
done
check 'fzf is offered the rows' "$(MOCK_PICK='' listing --client "$CLIENT")" "$(cat "$MOCK_FZF_OFFERED")"
case $args in *'--delimiter=\t'*) result=ok ;; *) result=$args ;; esac
check 'fzf splits fields on tabs' ok "$result"

# The row's own session $2 is attached by another client; $7 is not.
printf '%s\n' '%4 @4 $6 1' '%4 @4 $2 1' '%4 @4 $7 0' >"$MOCK_HOLDERS"
pick 'grouped peer'
check 'elsewhere an unattached holder wins over an attached peer' \
  "-S $SOCKET switch-client -c $CLIENT -t \$7:@4.%4 ; select-window -t \$7:@4.%4 ; select-pane -t \$7:@4.%4" \
  "$(jumped)"

printf '%s\n' '%5 @5 $8 1' '%5 @9 $3 1' >"$MOCK_HOLDERS"
pick 'other session'
check 'with every holder attached, the row session wins, in the window found now' \
  "-S $SOCKET switch-client -c $CLIENT -t \$3:@9.%5 ; select-window -t \$3:@9.%5 ; select-pane -t \$3:@9.%5" \
  "$(jumped)"

printf '%s\n' '%6 @6 $8 1' '%6 @6 $9 2' >"$MOCK_HOLDERS"
pick 'killed session'
check 'a killed row session falls back to the first holder' \
  "-S $SOCKET switch-client -c $CLIENT -t \$8:@6.%6 ; select-window -t \$8:@6.%6 ; select-pane -t \$8:@6.%6" \
  "$(jumped)"
check 'no target names a session or window by name' '' \
  "$(grep -oE -- '-t [^ ]+' "$MOCK_CALLS" | grep -vE -- '^-t (%[0-9]+|\$[0-9]+:@[0-9]+\.%[0-9]+)$')"

printf '%s\n' '%7 @7 $1 1' >"$MOCK_HOLDERS"
output=$(pick 'own session' 2>&1)
check 'a closed pane says so' "-S $SOCKET display-message -c $CLIENT That pane has closed" "$(jumped)"
check 'a closed pane prints nothing' '' "$output"

: >"$MOCK_CALLS"
output=$(pick '' 2>&1)
status=$?
check 'cancelling exits 0' 0 "$status"
check 'cancelling prints nothing and runs no jump' '' "$output$(jumped)"

printf '%s\n' '$1 1 '"$CLIENT" >"$MOCK_CLIENTS"
printf '%s\n' '%2 @2 $1 1' >"$MOCK_HOLDERS"
pick 'own session'
check 'a client in control mode by the jump is left alone' '' "$(jumped)"
printf '$1 0 %s\n' "$CLIENT" >"$MOCK_CLIENTS"

sed -i.bak 's/^C 0 /C 1 /' "$MOCK_STATE"
pick 'own session'
check 'a control-mode client gets no popup' '' "$(grep -c display-popup "$MOCK_CALLS" | grep -v '^0$')"
sed -i.bak '/^C /d' "$MOCK_STATE"
pick 'own session'
check 'a detached client gets no popup' '' "$(grep -c display-popup "$MOCK_CALLS" | grep -v '^0$')"

printf 'W \nC 0 %%1 %s\n' "$CLIENT" >"$MOCK_STATE"
output=$(pick 'own session' 2>&1)
check 'no rows says so' "-S $SOCKET display-message -c $CLIENT No agent panes on this server" \
  "$(grep -F 'display-message -c' "$MOCK_CALLS")"
check 'no rows prints nothing' '' "$output"

# Without fzf on PATH the picker says so and exits 0.
nofzf=$tmp/nofzf
mkdir "$nofzf"
for tool in bash env sh awk cat mktemp rm; do
  found=$(type -P "$tool") || continue
  ln -s "$found" "$nofzf/$tool"
done
ln -s "$tmp/bin/tmux" "$nofzf/tmux"
: >"$MOCK_CALLS"
PATH=$nofzf "$PICKER" --socket "$SOCKET" --client "$CLIENT"
check 'a missing fzf exits 0' 0 "$?"
check 'a missing fzf says so' "-S $SOCKET display-message -c $CLIENT The agent picker needs fzf" \
  "$(cat "$MOCK_CALLS")"

# A chosen line that is not one of the rows fails loudly, with no jump.
{
  printf 'W %s \n' '%2/@2/$1/01000/-/0'
  text_row %2 '$1' "$(pad 'work:2.1')" '' 0 'own session'
  printf 'C 0 %%1 %s\n' "$CLIENT"
} >"$MOCK_STATE"
: >"$MOCK_CALLS"
status=0
output=$(MOCK_CHOICE='not a row' "$PICKER" --socket "$SOCKET" --client "$CLIENT" 2>&1) || status=$?
check 'an unexpected choice is an error' 1 "$status"
check 'an unexpected choice says so' 'tmux-agent-picker: unexpected choice from fzf' "$output"
check 'an unexpected choice runs no jump' '' "$(grep -E ' (select-pane|switch-client) ' "$MOCK_CALLS")"

# Failures are loud: each exits 1, says why on stderr and on the client, and
# runs no jump.
no_jump() {
  grep -E ' (select-pane|switch-client) ' "$MOCK_CALLS"
}
client_messages() {
  grep -F " display-message -c $CLIENT " "$MOCK_CALLS"
}
status=0
output=$(MOCK_MISSING=' @window_counted @pane_agent' listing 2>&1) || status=$?
check 'an unset required option fails --list' 1 "$status"
check 'an unset required option is named' \
  'tmux-agent-picker: the tmux config does not set @window_counted @pane_agent (see tmux-agent-picker(1))' \
  "$output"
status=0
output=$(MOCK_MISSING=' @pane_jump_done' pick 'own session' 2>&1) || status=$?
check 'an unset required option fails the picker' 1 "$status"
check 'an unset required option is shown on the client' \
  "-S $SOCKET display-message -c $CLIENT tmux-agent-picker: the tmux config does not set @pane_jump_done (see tmux-agent-picker(1))" \
  "$(client_messages)"
check 'an unset required option opens no popup' '' "$(grep -F display-popup "$MOCK_CALLS")"

# The server's version comes back on the R line. An older server is refused
# before its missing options are named: its config refused to load them.
status=0
output=$(MOCK_VERSION=$older_tmux MOCK_MISSING=' @pane_agent' pick 'own session' 2>&1) || status=$?
check 'an older tmux fails the picker' 1 "$status"
check 'an older tmux is named on stderr' \
  "tmux-agent-picker: needs tmux $floor_tmux or newer (server is $older_tmux)" "$output"
check 'an older tmux is named on the client' \
  "-S $SOCKET display-message -c $CLIENT tmux-agent-picker: needs tmux $floor_tmux or newer (server is $older_tmux)" \
  "$(client_messages)"
check 'an older tmux opens no popup' '' "$(grep -F display-popup "$MOCK_CALLS")"
# An older server can reject the snapshot's list-panes -f before printing the
# version line, so the picker asks for the version alone and still refuses.
status=0
output=$(MOCK_VERSION=$older_tmux MOCK_SNAPSHOT_ERROR='unknown option -- f' \
  pick 'own session' 2>&1) || status=$?
check 'a snapshot an older tmux rejects fails the picker' 1 "$status"
check 'a snapshot an older tmux rejects still names the floor' \
  "tmux-agent-picker: needs tmux $floor_tmux or newer (server is $older_tmux)" "$output"
status=0
output=$(MOCK_SNAPSHOT_ERROR='unknown option -- f' listing 2>&1) || status=$?
check 'a rejected snapshot on a supported tmux keeps tmux'"'"'s words' \
  'tmux-agent-picker: tmux failed (status 1): unknown option -- f' "$output"
status=0
output=$(MOCK_VERSION=next-${older_tmux%a} listing 2>&1) || status=$?
check 'an older tmux fails --list' 1 "$status"
for version in "${floor_tmux}a" master ''; do
  status=0
  MOCK_VERSION=$version listing >/dev/null 2>&1 || status=$?
  check "tmux '$version' is not refused" 0 "$status"
done

status=0
output=$(MOCK_SNAPSHOT_ERROR='no server running on #{x}' pick 'own session' 2>&1) || status=$?
check 'a failed snapshot is an error' 1 "$status"
check 'a failed snapshot says why' 'tmux-agent-picker: tmux failed (status 1): no server running on #{x}' \
  "$output"
check 'a failed snapshot is shown on the client as written' \
  "-S $SOCKET display-message -c $CLIENT tmux-agent-picker: tmux failed (status 1): no server running on ##{x}" \
  "$(client_messages)"

printf '%s\n' '%2 @2 $1 1' >"$MOCK_HOLDERS"
status=0
output=$(MOCK_CLIENTS_FAIL=1 pick 'own session' 2>&1) || status=$?
check 'a failed client query after the pick is an error' 1 "$status"
check 'a failed client query says why' \
  'tmux-agent-picker: tmux failed (status 1): server exited unexpectedly' "$output"
check 'a failed client query runs no jump' '' "$(no_jump)"

status=0
output=$(MOCK_JUMP_FAIL=1 pick 'own session' 2>&1) || status=$?
check 'a failed jump to a pane still there is an error' 1 "$status"
check 'a failed jump says why' "tmux-agent-picker: could not jump to %2: can't find window" "$output"
check 'a failure leaves no temporary directory' 0 "$(leftovers)"
status=0
output=$(MOCK_JUMP_FAIL=1 MOCK_PANE_GONE=1 pick 'own session' 2>&1) || status=$?
check 'a failed jump to a pane closed since the pick exits 0' 0 "$status"
check 'a failed jump to a pane closed since the pick says so' \
  "-S $SOCKET display-message -c $CLIENT That pane has closed" "$(client_messages)"

status=0
output=$(MOCK_FZF_STATUS=2 pick 'own session' 2>&1) || status=$?
check 'an fzf error is an error' 1 "$status"
case $output in
  *'fzf failed with status 2. Press Enter to close.'*'tmux-agent-picker: fzf failed with status 2') result=ok ;;
  *) result=$output ;;
esac
check 'an fzf error holds the popup until Enter, then says so' ok "$result"
check 'an fzf error runs no jump' '' "$(no_jump)"
status=0
output=$(MOCK_FZF_STATUS=1 pick 'own session' 2>&1) || status=$?
check 'no match (fzf status 1) is not an error' 0 "$status"
check 'no match prints nothing and runs no jump' '' "$output$(no_jump)"

# A popup that closes under fzf (a detach, display-popup -C) is nothing to
# report; only an error tmux prints is.
for closed in 'popup:MOCK_POPUP_STATUS=129' 'fzf:MOCK_FZF_STATUS=129' 'fzf:MOCK_FZF_STATUS=143'; do
  status=0
  output=$(env "${closed#*:}" "$PICKER" --socket "$SOCKET" --client "$CLIENT" 2>&1 </dev/null) ||
    status=$?
  check "a closed popup ($closed) exits 0" 0 "$status"
  check "a closed popup ($closed) prints nothing" '' "$output"
done
status=0
output=$(MOCK_POPUP_ERROR='open terminal failed: not a terminal' pick 'own session' 2>&1) ||
  status=$?
check 'a popup tmux cannot open is an error' 1 "$status"
check 'a popup tmux cannot open says why' \
  'tmux-agent-picker: tmux could not open the popup (status 1): open terminal failed: not a terminal' \
  "$output"
check 'a popup tmux cannot open is shown on the client' \
  "-S $SOCKET display-message -c $CLIENT tmux-agent-picker: tmux could not open the popup (status 1): open terminal failed: not a terminal" \
  "$(client_messages)"

# A failure after the client detached exits 0 with no word: nobody is left
# to tell.
status=0
output=$(MOCK_FZF_DETACH=1 MOCK_FZF_STATUS=2 pick 'own session' 2>&1) || status=$?
check 'a failure after a detach exits 0' 0 "$status"
case $output in *'tmux-agent-picker:'*) result=$output ;; *) result=quiet ;; esac
check 'a failure after a detach reports nothing' quiet "$result"
check 'a failure after a detach sends no message' '' "$(client_messages)$(grep -F ' display-message tmux' "$MOCK_CALLS")"
# A client of the same name in control mode is not the one that pressed the
# key: a failure for it is as quiet.
printf '$1 1 %s\n' "$CLIENT" >"$MOCK_CLIENTS"
status=0
output=$(MOCK_FZF_STATUS=2 pick 'own session' 2>&1) || status=$?
check 'a failure once the client is in control mode exits 0' 0 "$status"
case $output in *'tmux-agent-picker:'*) result=$output ;; *) result=quiet ;; esac
check 'a failure once the client is in control mode reports nothing' quiet "$result"
printf '$1 0 %s\n' "$CLIENT" >"$MOCK_CLIENTS"
# Any other failing exit passes the same guard: here mktemp fails.
status=0
MOCK_PICK='own session' TMPDIR=$tmp/missing "$PICKER" --socket "$SOCKET" --client "$CLIENT" \
  </dev/null >/dev/null 2>&1 || status=$?
check 'an unexpected error for an attached client fails' 1 "$status"
: >"$MOCK_CLIENTS"
status=0
MOCK_PICK='own session' TMPDIR=$tmp/missing "$PICKER" --socket "$SOCKET" --client "$CLIENT" \
  </dev/null >/dev/null 2>&1 || status=$?
check 'an unexpected error after a detach exits 0' 0 "$status"
printf '$1 0 %s\n' "$CLIENT" >"$MOCK_CLIENTS"

status=0
output=$(MOCK_GARBLE=1 listing 2>&1) || status=$?
check 'a snapshot without its R line is an error' 1 "$status"
check 'a snapshot without its R line says so' \
  'tmux-agent-picker: tmux answered the snapshot with something unexpected' "$output"

# --list (every ctrl-r) makes no temporary directory: it works where none
# could be made.
status=0
TMPDIR=$tmp/missing listing >/dev/null 2>&1 || status=$?
check '--list makes no temporary directory' 0 "$status"
listing >/dev/null 2>&1
check '--list leaves no temporary directory' 0 "$(leftovers)"

# A client line whose session is not an id is not the client: no jump.
printf 'bogus 0 %s\n' "$CLIENT" >"$MOCK_CLIENTS"
status=0
pick 'own session' >/dev/null 2>&1 || status=$?
check 'a client without a session id exits 0' 0 "$status"
check 'a client without a session id gets no jump' '' "$(no_jump)"
printf '$1 0 %s\n' "$CLIENT" >"$MOCK_CLIENTS"

# Messages go to the client only, even when tmux drops them because that
# client has gone.
printf 'W \nC 0 %%1 %s\n' "$CLIENT" >"$MOCK_STATE"
: >"$MOCK_CALLS"
"$PICKER" --socket "$SOCKET" --client "$CLIENT" </dev/null
check 'a message goes only to its client' \
  "-S $SOCKET display-message -c $CLIENT No agent panes on this server" \
  "$(grep -F ' display-message ' "$MOCK_CALLS" | grep -F ' No ')"
: >"$MOCK_CALLS"
output=$(MOCK_SERVER_LOST=1 "$PICKER" --socket "$SOCKET" --client "$CLIENT" 2>&1 </dev/null)
check 'a message tmux cannot deliver goes to stderr' \
  'tmux-agent-picker: No agent panes on this server' "$output"
check 'a message tmux cannot deliver goes to no other client' '' \
  "$(grep -F ' display-message No ' "$MOCK_CALLS")"

# A quote in a path the popup's command line quotes is refused.
{
  printf 'W %s \n' '%2/@2/$1/01000/-/0'
  text_row %2 '$1' "$(pad 'work:2.1')" '' 0 'own session'
  printf 'C 0 %%1 %s\n' "$CLIENT"
  printf "C 0 %%1 %s'\n" "$CLIENT"
} >"$MOCK_STATE"
printf '$1 0 %s\n' "$CLIENT" "$CLIENT'" >"$MOCK_CLIENTS"
quoted=$tmp/it\'s
mkdir "$quoted"
ln -s "$PICKER" "$quoted/tmux-agent-picker"
: >"$MOCK_CALLS"
statuses=''
for run in "socket:$PICKER --socket /private/it's.sock --client $CLIENT" \
  "client:$PICKER --socket $SOCKET --client $CLIENT'" \
  "script:$quoted/tmux-agent-picker --socket $SOCKET --client $CLIENT" \
  "temp:$PICKER --socket $SOCKET --client $CLIENT"; do
  status=0
  label=${run%%:*}
  read -r -a command <<<"${run#*:}"
  if [ "$label" = temp ]; then
    output=$(TMPDIR=$quoted MOCK_PICK='own session' "${command[@]}" 2>&1 </dev/null) || status=$?
  else
    output=$(MOCK_PICK='own session' "${command[@]}" 2>&1 </dev/null) || status=$?
  fi
  statuses="$statuses $label=$status"
  check "a quote in the $label path says so" \
    'tmux-agent-picker: a quote in the temporary path, socket, client or script path' "$output"
done
check 'a quote in any popup path is refused' ' socket=1 client=1 script=1 temp=1' "$statuses"
check 'a quote in any popup path opens no popup' '' "$(grep -F display-popup "$MOCK_CALLS")"

check 'nothing ran ps' '' "$(cat "$MOCK_PS" 2>/dev/null)"

if [ "$failures" -gt 0 ]; then
  printf '%s failure(s)\n' "$failures" >&2
  exit 1
fi
printf 'all tmux-agent-picker mock tests passed\n'
