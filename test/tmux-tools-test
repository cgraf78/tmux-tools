#!/usr/bin/env bash

set -uo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PATH="$ROOT/bin:$PATH"
export NO_COLOR=1

_failures=0
_suite_tmp_parent=${TMPDIR:-/tmp}
_suite_tmp_root=$(
  umask 077
  mktemp -d "$_suite_tmp_parent/tmt.XXXXXXXX"
) || {
  printf 'failed to create test temporary directory below %s\n' \
    "$_suite_tmp_parent" >&2
  exit 1
}
# macOS has a shorter AF_UNIX path limit, so keep the tmux socket near the root.
_suite_tmux_socket=$_suite_tmp_root/t

_tmpdir() {
  mktemp -d "$_suite_tmp_root/c.XXXXXXXX"
}

_cleanup() {
  local root=${_suite_tmp_root:-}
  [[ -z "$root" ]] || rm -rf "$root"
  _suite_tmp_root=""
}

_signal_exit() {
  local status="$1"
  _cleanup
  exit "$status"
}
trap _cleanup EXIT
trap '_signal_exit 130' INT
trap '_signal_exit 143' TERM

_pass() {
  printf 'ok - %s\n' "$1"
}

_fail() {
  printf 'not ok - %s\n' "$1" >&2
  _failures=$((_failures + 1))
}

_assert_eq() {
  local name="$1"
  local expected="$2"
  local actual="$3"

  if [[ "$actual" == "$expected" ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected: %q\n' "$expected" >&2
    printf '  actual:   %q\n' "$actual" >&2
  fi
}

_assert_ne() {
  local name="$1"
  local first="$2"
  local second="$3"

  if [[ "$first" != "$second" ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected distinct values: %q\n' "$first" >&2
  fi
}

_assert_contains() {
  local name="$1"
  local needle="$2"
  local haystack="$3"

  if [[ "$haystack" == *"$needle"* ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected output to contain: %s\n' "$needle" >&2
    printf '  actual output:\n%s\n' "$haystack" >&2
  fi
}

_assert_symlink() {
  local name="$1"
  local path="$2"

  if [[ -L "$path" ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected symlink: %s\n' "$path" >&2
  fi
}

_assert_missing() {
  local name="$1"
  local path="$2"

  if [[ ! -e "$path" && ! -L "$path" ]]; then
    _pass "$name"
  else
    _fail "$name"
    printf '  expected path to be absent: %s\n' "$path" >&2
  fi
}

_files_equal() {
  [[ "$(od -An -tx1 -v <"$1")" == "$(od -An -tx1 -v <"$2")" ]]
}

_mode() {
  if stat -c '%a' "$1" >/dev/null 2>&1; then
    stat -c '%a' "$1"
  else
    stat -f '%Lp' "$1"
  fi
}

# Exercise harness teardown without recursively running the integration suite.
if [[ "${1:-}" == "--harness-probe" ]]; then
  probe_action=${2:-}
  probe_child=$(_tmpdir) || exit 1
  printf '%s\n%s\n%s\n%s\n%s\n' \
    "$_suite_tmp_root" "$probe_child" "$(_mode "$_suite_tmp_root")" \
    "${TMPDIR:-}" "$_suite_tmux_socket"
  case "$probe_action" in
    normal) exit 0 ;;
    failure) exit 17 ;;
    int) kill -INT "$$" ;;
    term) kill -TERM "$$" ;;
    *) exit 2 ;;
  esac
  exit 99
fi

_write_initial_identity_signal_stat() {
  local path="$1"

  cat >"$path" <<'MOCK'
#!/usr/bin/env bash
target="${!#}"
state=""
[[ ! -e "$TMUX_TOOLS_TEST_SIGNAL_STATE" ]] ||
  state=$(cat "$TMUX_TOOLS_TEST_SIGNAL_STATE")
if [[ "$target" == *.tmp.* && -z "$state" ]]; then
  publisher_suffix=${target##*.tmp.}
  publisher_pid=${publisher_suffix%%.*}
  random_suffix=${publisher_suffix#*.}
  random_one=${random_suffix%%.*}
  random_two=${random_suffix#*.}
  if [[ -z "$publisher_pid" || "$publisher_pid" == *[!0-9]* || \
    ( "$publisher_pid" != [2-9] && "$publisher_pid" != [1-9][0-9]* ) || \
    -z "$random_one" || "$random_one" == *[!0-9]* || \
    -z "$random_two" || "$random_two" == *[!0-9]* || \
    "$publisher_suffix" != "$publisher_pid.$random_one.$random_two" ]]; then
    printf 'invalid publisher PID in temporary path: %s\n' "$target" >&2
    exit 98
  fi
  if [[ "$TMUX_TOOLS_TEST_SIGNAL_MODE" == fail-initial-hup-term ]]; then
    printf 'initial-failed-once\n' >"$TMUX_TOOLS_TEST_SIGNAL_STATE"
  else
    output=$("$TMUX_TOOLS_TEST_REAL_STAT" "$@")
    status=$?
    ((status == 0)) || exit "$status"
    printf 'identified\n' >"$TMUX_TOOLS_TEST_SIGNAL_STATE"
  fi
  if [[ "$TMUX_TOOLS_TEST_SIGNAL_MODE" == hup-term || \
    "$TMUX_TOOLS_TEST_SIGNAL_MODE" == fail-initial-hup-term ]]; then
    kill -HUP "$publisher_pid"
    sleep 0.05
  fi
  kill -TERM "$publisher_pid"
  sleep 0.05
  if [[ "$TMUX_TOOLS_TEST_SIGNAL_MODE" == replace ]]; then
    rm -f -- "$target"
    printf 'unrelated identity replacement\n' >"$target"
  fi
  [[ "$TMUX_TOOLS_TEST_SIGNAL_MODE" != fail-initial-hup-term ]] || exit 1
  printf '%s\n' "$output"
  exit 0
fi
if [[ "$target" == *.tmp.* && \
  "$TMUX_TOOLS_TEST_SIGNAL_MODE" == fail-initial-hup-term && \
  "$state" == initial-failed-once ]]; then
  printf 'initial-failed-twice\n' >"$TMUX_TOOLS_TEST_SIGNAL_STATE"
  exit 1
fi
if [[ "$target" == *.tmp.* && \
  "$TMUX_TOOLS_TEST_SIGNAL_MODE" == fail-recheck ]]; then
  case "$state" in
    identified)
      printf 'failed-once\n' >"$TMUX_TOOLS_TEST_SIGNAL_STATE"
      exit 1
      ;;
    failed-once)
      printf 'failed-twice\n' >"$TMUX_TOOLS_TEST_SIGNAL_STATE"
      exit 1
      ;;
  esac
fi
exec "$TMUX_TOOLS_TEST_REAL_STAT" "$@"
MOCK
  chmod +x "$path"
}

_write_creation_signal_debug_env() {
  local path="$1"

  cat >"$path" <<'MOCK'
_tmux_tools_creation_debug() {
  case "$TMUX_TOOLS_TEST_CREATION_MODE" in
    replace-shape)
      [[ "$BASH_COMMAND" == '[[ -f "$tmpfile"'* ]] || return 0
      trap - DEBUG
      rm -f -- "$tmpfile"
      mkdir -- "$tmpfile"
      printf '%s\n' "$tmpfile" >"$TMUX_TOOLS_TEST_REPLACEMENT_PATH"
      printf 'unrelated creation sibling\n' >"$tmpfile.unrelated"
      printf '%s\n' "$tmpfile.unrelated" >"$TMUX_TOOLS_TEST_SIBLING_PATH"
      ;;
    exhaust)
      [[ "$BASH_COMMAND" == 'tmpfile="$tmp_prefix.$RANDOM.$RANDOM"' ]] ||
        return 0
      trap - DEBUG
      : >"$TMUX_TOOLS_TEST_CREATION_TRIGGERED"
      ;;
    error-boundary)
      [[ "$BASH_COMMAND" == '_die "$@"' || \
        "$BASH_COMMAND" == '_fail "$@"' ]] || return 0
      trap - DEBUG
      : >"$TMUX_TOOLS_TEST_CREATION_TRIGGERED"
      ;;
    *) return 0 ;;
  esac
  kill -HUP "$$"
  kill -TERM "$$"
}
set -T
trap _tmux_tools_creation_debug DEBUG
MOCK
}
_wait_for_file() {
  local name="$1"
  local path="$2"
  local attempt

  for ((attempt = 0; attempt < 500; attempt++)); do
    if [[ -e "$path" ]]; then
      _pass "$name"
      return 0
    fi
    sleep 0.01
  done
  _fail "$name"
  printf '  timed out waiting for: %s\n' "$path" >&2
  return 1
}

_wait_for_content() {
  local name="$1"
  local path="$2"
  local expected="$3"
  local attempt actual

  for ((attempt = 0; attempt < 500; attempt++)); do
    actual=""
    [[ ! -f "$path" ]] || actual=$(cat "$path")
    if [[ "$actual" == "$expected" ]]; then
      _pass "$name"
      return 0
    fi
    sleep 0.01
  done
  _fail "$name"
  printf '  timed out waiting for content in: %s\n' "$path" >&2
  return 1
}

install_prefix=$(_tmpdir)
PREFIX="$install_prefix" "$ROOT/install.sh" >/dev/null
_assert_symlink "install links default-server command" \
  "$install_prefix/bin/tmux-continuum-default-server"
_assert_symlink "install links save-gate command" \
  "$install_prefix/bin/tmux-continuum-save-gate"
_assert_symlink "install links default-server manpage" \
  "$install_prefix/share/man/man1/tmux-continuum-default-server.1"
_assert_symlink "install links save-gate manpage" \
  "$install_prefix/share/man/man1/tmux-continuum-save-gate.1"
_assert_symlink "install links clip manpage" "$install_prefix/share/man/man1/tmux-clip-paste.1"

upgrade_prefix=$(_tmpdir)
mkdir -p "$upgrade_prefix/bin" "$upgrade_prefix/share/man/man1"
ln -s "$ROOT/bin/tmux-save-session" "$upgrade_prefix/bin/tmux-save-session"
ln -s "$ROOT/bin/tmux-restore-session" "$upgrade_prefix/bin/tmux-restore-session"
ln -s "$ROOT/man/man1/tmux-save-session.1" \
  "$upgrade_prefix/share/man/man1/tmux-save-session.1"
ln -s "$ROOT/man/man1/tmux-restore-session.1" \
  "$upgrade_prefix/share/man/man1/tmux-restore-session.1"
PREFIX="$upgrade_prefix" "$ROOT/install.sh" >/dev/null
_assert_missing "install retires its old save command link" \
  "$upgrade_prefix/bin/tmux-save-session"
_assert_missing "install retires its old restore command link" \
  "$upgrade_prefix/bin/tmux-restore-session"
_assert_missing "install retires its old save manpage link" \
  "$upgrade_prefix/share/man/man1/tmux-save-session.1"
_assert_missing "install retires its old restore manpage link" \
  "$upgrade_prefix/share/man/man1/tmux-restore-session.1"

preserve_prefix=$(_tmpdir)
mkdir -p "$preserve_prefix/bin"
ln -s /user/managed/tmux-save-session \
  "$preserve_prefix/bin/tmux-save-session"
PREFIX="$preserve_prefix" "$ROOT/install.sh" >/dev/null
_assert_eq "install preserves a user-owned legacy command link" \
  "/user/managed/tmux-save-session" \
  "$(readlink "$preserve_prefix/bin/tmux-save-session")"

custom_install_prefix=$(_tmpdir)
custom_install_bin=$(_tmpdir)/custom-bin
custom_install_man=$(_tmpdir)/custom-man
PREFIX="$custom_install_prefix" BIN_DIR="$custom_install_bin" MAN_DIR="$custom_install_man" \
  "$ROOT/install.sh" >/dev/null
_assert_symlink "custom BIN_DIR receives default-server command" \
  "$custom_install_bin/tmux-continuum-default-server"
_assert_symlink "custom BIN_DIR receives save-gate command" \
  "$custom_install_bin/tmux-continuum-save-gate"
_assert_symlink "custom MAN_DIR receives default-server manpage" \
  "$custom_install_man/tmux-continuum-default-server.1"
_assert_symlink "custom MAN_DIR receives save-gate manpage" \
  "$custom_install_man/tmux-continuum-save-gate.1"

creation_signal_debug_dir=$(_tmpdir)
creation_signal_debug_env="$creation_signal_debug_dir/debug-env"
_write_creation_signal_debug_env "$creation_signal_debug_env"

clip_dir=$(_tmpdir)
clip_file="$clip_dir/selection"
clip_bin=$(_tmpdir)
clip_log="$clip_dir/tmux.log"
cat >"$clip_bin/tmux" <<'MOCK'
#!/usr/bin/env bash
case "$1" in
  display-message)
    target=""
    while (($#)); do
      if [[ "$1" == -t ]]; then
        target="$2"
        break
      fi
      shift
    done
    [[ "$target" != %999 ]] || exit 1
    pane="${target#%}"
    printf '%s:%%%s\n' "${TMUX_TOOLS_TEST_SERVER_PID:-101}" \
      "${pane:-${TMUX_TOOLS_TEST_PANE_ID:-1}}"
    ;;
  load-buffer | paste-buffer | delete-buffer)
    printf '%s\n' "$*" >>"$TMUX_TOOLS_TEST_TMUX_LOG"
    buffer_state="$TMUX_TOOLS_TEST_TMUX_LOG.buffer"
    if [[ "$1" == load-buffer ]]; then
      printf '%s\n' "$3" >"$buffer_state"
    fi
    if [[ "$1" == load-buffer && -n "${TMUX_TOOLS_TEST_LOAD_READY:-}" ]]; then
      cat "${!#}" >"$TMUX_TOOLS_TEST_LOADED_PAYLOAD"
      : >"$TMUX_TOOLS_TEST_LOAD_READY"
      for ((attempt = 0; attempt < 500; attempt++)); do
        [[ ! -e "$TMUX_TOOLS_TEST_LOAD_CONTINUE" ]] || break
        sleep 0.01
      done
      [[ -e "$TMUX_TOOLS_TEST_LOAD_CONTINUE" ]] || exit 98
    fi
    if [[ "$1" == load-buffer && -n "${TMUX_TOOLS_TEST_FAIL_LOAD:-}" ]]; then
      exit 1
    fi
    if [[ "$1" == paste-buffer && -n "${TMUX_TOOLS_TEST_FAIL_PASTE:-}" ]]; then
      exit 1
    fi
    if [[ "$1" == paste-buffer && -n "${TMUX_TOOLS_TEST_COMMIT_PASTE:-}" ]]; then
      rm -f "$buffer_state"
      if [[ -n "${TMUX_TOOLS_TEST_SIGNAL_PASTE:-}" ]]; then
        kill -TERM "$PPID"
      fi
      exit 42
    fi
    if [[ "$1" == paste-buffer && "$*" == *' -d'* ]]; then
      rm -f "$buffer_state"
    elif [[ "$1" == delete-buffer ]]; then
      rm -f "$buffer_state"
    fi
    ;;
  list-buffers)
    printf '%s\n' "$*" >>"$TMUX_TOOLS_TEST_TMUX_LOG"
    buffer_state="$TMUX_TOOLS_TEST_TMUX_LOG.buffer"
    [[ ! -e "$buffer_state" ]] || cat "$buffer_state"
    ;;
  *)
    printf 'unexpected tmux command: %s\n' "$*" >&2
    exit 99
    ;;
esac
MOCK
chmod +x "$clip_bin/tmux"

path_one=$(
  env -u TMUX_PANE TMPDIR="$clip_dir" PATH="$clip_bin:$PATH" TMUX_TOOLS_TEST_SERVER_PID=101 \
    TMUX_TOOLS_TEST_PANE_ID=1 tmux-clip-paste --path
)
path_two=$(
  env -u TMUX_PANE TMPDIR="$clip_dir" PATH="$clip_bin:$PATH" TMUX_TOOLS_TEST_SERVER_PID=101 \
    TMUX_TOOLS_TEST_PANE_ID=2 tmux-clip-paste --path
)
path_other_server=$(
  env -u TMUX_PANE TMPDIR="$clip_dir" PATH="$clip_bin:$PATH" TMUX_TOOLS_TEST_SERVER_PID=202 \
    TMUX_TOOLS_TEST_PANE_ID=1 tmux-clip-paste --path
)
_assert_eq "clip paste scopes the default path to the server and pane" \
  "$clip_dir/tmux-tools-$(id -u)/clip-paste/101-1" "$path_one"
_assert_ne "clip paste isolates panes in the same server" "$path_one" "$path_two"
_assert_ne "clip paste isolates panes in different servers" "$path_one" "$path_other_server"
_assert_eq "clip paste creates its per-user directory privately" \
  "700" "$(_mode "$clip_dir/tmux-tools-$(id -u)/clip-paste")"

explicit_pane_path=$(
  TMPDIR="$clip_dir" PATH="$clip_bin:$PATH" TMUX_PANE=%999 \
    tmux-clip-paste --pane %2 --path
)
_assert_eq "clip paste lets an explicit pane override stale TMUX_PANE" \
  "$clip_dir/tmux-tools-$(id -u)/clip-paste/101-2" "$explicit_pane_path"
stale_pane_output=$(
  TMPDIR="$clip_dir" PATH="$clip_bin:$PATH" TMUX_PANE=%999 \
    tmux-clip-paste --path 2>&1
)
stale_pane_rc=$?
_assert_eq "clip paste rejects stale TMUX_PANE instead of retargeting" \
  "1" "$stale_pane_rc"
_assert_contains "clip paste explains stale pane resolution" \
  "cannot determine" "$stale_pane_output"
invalid_pane_output=$(tmux-clip-paste --pane 2 --file "$clip_file" --path 2>&1)
invalid_pane_rc=$?
_assert_eq "clip paste rejects malformed explicit pane IDs" "2" "$invalid_pane_rc"
_assert_contains "clip paste explains malformed explicit pane IDs" \
  "invalid tmux pane ID" "$invalid_pane_output"
tmux-clip-paste --file "$clip_file" --path --publish >/dev/null 2>&1
conflicting_mode_rc=$?
_assert_eq "clip paste classifies conflicting modes as usage errors" \
  "2" "$conflicting_mode_rc"
tmux-clip-paste --not-an-option >/dev/null 2>&1
unknown_option_rc=$?
_assert_eq "clip paste classifies unknown options as usage errors" \
  "2" "$unknown_option_rc"

invalid_runtime_root="$clip_dir/invalid-runtime-root"
printf 'not a directory\n' >"$invalid_runtime_root"
env -u TMUX_PANE TMPDIR="$invalid_runtime_root" PATH="$clip_bin:$PATH" \
  tmux-clip-paste --path >/dev/null 2>&1
invalid_runtime_rc=$?
_assert_eq "clip paste classifies private runtime failures as operational" \
  "1" "$invalid_runtime_rc"

result=$(TMUX_TOOLS_CLIP_PASTE_FILE="$clip_file" tmux-clip-paste --path)
_assert_eq "clip paste path honors env override" "$clip_file" "$result"

dash_file_dir=$(_tmpdir)
dash_file_log="$dash_file_dir/tmux.log"
(
  cd "$dash_file_dir" || exit 99
  printf 'leading dash publish\n' |
    tmux-clip-paste --file=-selection --publish
)
dash_publish_rc=$?
_assert_eq "clip publish accepts a leading-dash custom path" \
  "0" "$dash_publish_rc"
_assert_eq "clip publish writes the leading-dash custom path" \
  "leading dash publish" "$(cat "$dash_file_dir/-selection" 2>/dev/null)"
printf 'leading dash consume\n' >"$dash_file_dir/-selection"
(
  cd "$dash_file_dir" || exit 99
  env -u TMUX_PANE PATH="$clip_bin:$PATH" \
    TMUX_TOOLS_TEST_TMUX_LOG="$dash_file_log" \
    tmux-clip-paste --file=-selection
)
dash_consume_rc=$?
_assert_eq "clip paste accepts a leading-dash custom path" \
  "0" "$dash_consume_rc"
if [[ -e "$dash_file_dir/-selection" ]]; then
  _fail "clip paste consumes the leading-dash custom path"
else
  _pass "clip paste consumes the leading-dash custom path"
fi

publication_fifo="$clip_dir/publication.fifo"
publication_ready="$clip_dir/publication.ready"
publication_continue="$clip_dir/publication.continue"
mkfifo "$publication_fifo"
printf 'previous payload\n' >"$clip_file"
{
  printf 'picked '
  : >"$publication_ready"
  for ((attempt = 0; attempt < 500; attempt++)); do
    [[ ! -e "$publication_continue" ]] || break
    sleep 0.01
  done
  [[ -e "$publication_continue" ]] || exit 98
  printf 'text\n'
} >"$publication_fifo" &
publication_writer=$!
PATH="$clip_bin:$PATH" tmux-clip-paste --file "$clip_file" --publish \
  <"$publication_fifo" &
publication_process=$!
if _wait_for_file "clip publisher reaches its incomplete payload" \
  "$publication_ready"; then
  _assert_eq "clip publish hides incomplete payloads" \
    "previous payload" "$(cat "$clip_file")"
  : >"$publication_continue"
  wait "$publication_writer"
  publication_writer_rc=$?
  wait "$publication_process"
  publication_process_rc=$?
else
  : >"$publication_continue"
  kill "$publication_writer" "$publication_process" 2>/dev/null || :
  wait "$publication_writer" 2>/dev/null || :
  wait "$publication_process" 2>/dev/null || :
  publication_writer_rc=98
  publication_process_rc=98
fi
_assert_eq "clip publisher completes its payload" "0" "$publication_writer_rc"
_assert_eq "clip publish command completes" "0" "$publication_process_rc"
_assert_eq "clip publish atomically installs complete stdin" \
  "picked text" "$(cat "$clip_file")"
_assert_eq "clip publish restricts the handoff file" "600" "$(_mode "$clip_file")"
publication_temps=$(printf '%s\n' "$clip_dir"/.selection.tmp.*)
_assert_eq "clip publish removes its temporary file" \
  "$clip_dir/.selection.tmp.*" "$publication_temps"

publish_stderr_file="$clip_dir/stderr-selection"
publish_stderr_bin=$(_tmpdir)
cat >"$publish_stderr_bin/cat" <<'MOCK'
#!/usr/bin/env bash
printf 'publish input failed\n' >&2
exit 42
MOCK
chmod +x "$publish_stderr_bin/cat"
publish_stderr_output=$(printf 'replacement\n' | PATH="$publish_stderr_bin:$PATH" \
  tmux-clip-paste --file "$publish_stderr_file" --publish 2>&1)
publish_stderr_rc=$?
_assert_eq "clip publish classifies a post-create input failure as operational" \
  "1" "$publish_stderr_rc"
_assert_contains "clip publish preserves actionable stderr after temporary-file creation" \
  "publish input failed" "$publish_stderr_output"

publish_directory="$clip_dir/directory-selection"
mkdir "$publish_directory"
printf 'directory marker\n' >"$publish_directory/marker"
printf 'must not publish\n' |
  tmux-clip-paste --file "$publish_directory" --publish >/dev/null 2>&1
publish_directory_rc=$?
_assert_eq "clip publish classifies a destination directory as operational" \
  "1" "$publish_directory_rc"
_assert_eq "clip publish preserves a destination directory" \
  "directory marker" "$(cat "$publish_directory/marker")"
publish_directory_temps=$(printf '%s\n' "$publish_directory"/.*.tmp.*)
_assert_eq "clip publish leaves no hidden artifact in a destination directory" \
  "$publish_directory/.*.tmp.*" "$publish_directory_temps"

publish_symlink_target=$(_tmpdir)
publish_symlink="$clip_dir/symlink-selection"
printf 'symlink marker\n' >"$publish_symlink_target/marker"
ln -s "$publish_symlink_target" "$publish_symlink"
printf 'must not publish\n' |
  tmux-clip-paste --file "$publish_symlink" --publish >/dev/null 2>&1
publish_symlink_rc=$?
if ((publish_symlink_rc == 0)); then
  _fail "clip publish rejects a symlink to a destination directory"
else
  _pass "clip publish rejects a symlink to a destination directory"
fi
_assert_eq "clip publish preserves a symlinked destination directory" \
  "symlink marker" "$(cat "$publish_symlink_target/marker")"
publish_symlink_temps=$(printf '%s\n' "$publish_symlink_target"/.*.tmp.*)
_assert_eq "clip publish leaves no hidden artifact through a destination symlink" \
  "$publish_symlink_target/.*.tmp.*" "$publish_symlink_temps"

publish_identity_file="$clip_dir/identity-selection"
publish_identity_bin=$(_tmpdir)
publish_identity_real_stat=$(command -v stat)
printf 'known-good-identity-payload\n' >"$publish_identity_file"
cat >"$publish_identity_bin/stat" <<'MOCK'
#!/usr/bin/env bash
if [[ "${!#}" == /dev/fd/3 ]]; then
  printf 'synthetic-platform-descriptor-identity\n'
  exit 0
fi
exec "$TMUX_TOOLS_TEST_REAL_STAT" "$@"
MOCK
chmod +x "$publish_identity_bin/stat"
printf 'replacement\n' | PATH="$publish_identity_bin:$PATH" \
  TMUX_TOOLS_TEST_REAL_STAT="$publish_identity_real_stat" \
  tmux-clip-paste --file "$publish_identity_file" --publish >/dev/null 2>&1
publish_identity_rc=$?
_assert_eq "clip publish ignores nonportable external descriptor identity" \
  "0" "$publish_identity_rc"
_assert_eq "clip publish replaces with portable pathname identity" \
  "replacement" "$(cat "$publish_identity_file")"
publish_identity_owned_temps=""
for publish_identity_candidate in "$clip_dir"/.identity-selection.tmp.*; do
  [[ -e "$publish_identity_candidate" || -L "$publish_identity_candidate" ]] || continue
  publish_identity_owned_temps+="${publish_identity_owned_temps:+$'\n'}$publish_identity_candidate"
done
_assert_eq "clip publish removes its pathname-identified temporary" \
  "" "$publish_identity_owned_temps"

publish_shape_signal_file="$clip_dir/shape-signal-selection"
publish_shape_signal_replacement_path="$clip_dir/shape-signal-replacement-path"
