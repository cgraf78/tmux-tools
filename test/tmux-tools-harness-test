#!/usr/bin/env bash

set -uo pipefail

ROOT=$(CDPATH='' cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
probe_parent=$(mktemp -d "${TMPDIR:-/tmp}/tmux-tools-harness-test.XXXXXXXX") || exit 1
failures=0

cleanup() {
  rm -rf "$probe_parent"
}
trap cleanup EXIT
# shellcheck source=test/fixture-env.sh
. "$ROOT/test/fixture-env.sh"
tmux_fixture_git "$probe_parent"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  failures=$((failures + 1))
}

run_probe() {
  local action="$1"
  local expected_status="$2"
  local output status probe_root probe_child probe_mode probe_tmpdir probe_socket

  output=$(
    umask 000
    cd -P -- "$ROOT" || exit 1
    CDPATH=. TMPDIR="$probe_parent" \
      test/tmux-tools-test --harness-probe "$action"
  )
  status=$?
  probe_root=$(printf '%s\n' "$output" | sed -n '1p')
  probe_child=$(printf '%s\n' "$output" | sed -n '2p')
  probe_mode=$(printf '%s\n' "$output" | sed -n '3p')
  probe_tmpdir=$(printf '%s\n' "$output" | sed -n '4p')
  probe_socket=$(printf '%s\n' "$output" | sed -n '5p')

  if [[ "$status" != "$expected_status" ]]; then
    fail "harness $action probe preserves status $expected_status"
  elif [[ "$probe_root" != "$probe_parent"/tmt.* ]]; then
    fail "harness $action probe creates its root below TMPDIR"
  elif [[ "$probe_child" != "$probe_root"/c.* ]]; then
    fail "harness $action probe creates case directories below its root"
  elif [[ "$probe_mode" != "700" ]]; then
    fail "harness $action probe keeps its root private under umask 000"
  elif [[ "$probe_tmpdir" != "$probe_parent" ]]; then
    fail "harness $action probe preserves TMPDIR"
  elif [[ "$probe_socket" != "$probe_root/t" ]]; then
    fail "harness $action probe keeps the tmux socket path short"
  elif [[ -e "$probe_root" || -L "$probe_root" ]]; then
    fail "harness $action probe removes its suite root"
  else
    printf 'ok - harness %s cleanup\n' "$action"
  fi
}

run_probe normal 0
run_probe failure 17
run_probe int 130
run_probe term 143

caller="$probe_parent/caller"
caller_config="$probe_parent/caller.gitconfig"
mkdir "$caller"
git -C "$caller" init --quiet --template='' --initial-branch=caller || exit 1
git config --file "$caller_config" harness.caller preserved || exit 1
git_status=0
git_output=$(TMPDIR="$probe_parent" GIT_DIR="$caller/.git" GIT_WORK_TREE="$caller" \
  GIT_CONFIG_GLOBAL="$caller_config" GIT_CONFIG_COUNT=1 \
  GIT_CONFIG_KEY_0=harness.caller GIT_CONFIG_VALUE_0=injected \
  "$ROOT/test/tmux-tools-test" --harness-probe git 2>&1) || git_status=$?
if [[ "$git_status" != 0 || "$git_output" != fixture ||
  "$(git -C "$caller" symbolic-ref --short HEAD)" != caller ||
  "$(cat "$caller_config")" != $'[harness]\n\tcaller = preserved' ]]; then
  fail "installer Git probe inherits or alters the caller context: $git_output"
fi

colon_tmp="$probe_parent/tmp:parent"
mkdir "$colon_tmp"
colon_status=0
colon_output=$(TMPDIR="$colon_tmp" "$ROOT/test/tmux-tools-test" \
  --harness-probe normal 2>&1) || colon_status=$?
if [[ "$colon_status" != 2 || "$colon_output" != *"TMPDIR must not contain a colon"* ]]; then
  fail "mock PATH probe accepts a colon in TMPDIR: $colon_output"
fi

ambient_bin="$probe_parent/ambient-bin"
private_bin="$probe_parent/private-bin"
mkdir "$ambient_bin"
for tool in termnav term-pane-mark; do
  printf '#!/bin/sh\nexit 47\n' >"$ambient_bin/$tool"
  chmod +x "$ambient_bin/$tool"
done
if ! PATH="$ambient_bin:$PATH" tmux_fixture_tools "$private_bin" cat ||
  ! env -u BASH_ENV PATH="$private_bin" "$private_bin/bash" -c '
    command -v cat >/dev/null &&
      ! command -v termnav >/dev/null &&
      ! command -v term-pane-mark >/dev/null
  '; then
  fail "fixture commands expose ambient optional integrations"
fi

if [[ ${TMUX_TOOLS_TMUX:-} == ok ]] && command -v python3 >/dev/null 2>&1; then
  startup="$probe_parent/bash-env"
  startup_marker="$probe_parent/bash-env-read"
  cat >"$startup" <<'BASH'
case "$0" in
  */term-pane-state)
    printf '%s\n' "$0" >>"$TERM_PANE_STATE_STARTUP_MARKER"
    exit 47
    ;;
esac
BASH
  control_status=0
  BASH_ENV="$startup" TERM_PANE_STATE_STARTUP_MARKER="$startup_marker" \
    "$BASH" -c ':' "$ROOT/bin/term-pane-state" || control_status=$?
  if [[ "$control_status" != 47 || ! -s "$startup_marker" ]]; then
    fail "real-client startup control did not read the caller's Bash startup file"
  fi
  rm -f "$startup_marker"
  startup_status=0
  startup_output=$(BASH_ENV="$startup" ENV="$startup" \
    TERM_PANE_STATE_STARTUP_MARKER="$startup_marker" TMUX_TOOLS_REQUIRE_TMUX=1 \
    python3 "$ROOT/test/term-pane-state-client.py" 2>&1) || startup_status=$?
  if [[ "$startup_status" != 0 || -e "$startup_marker" ]]; then
    fail "real-client test exposes caller shell startup: $startup_output"
  fi
fi

# The floor smoke must never quietly run the runner's default tmux when the
# provisioning action did not bind an exact release. A mismatched floor also
# stops an older runner before it enters the full suite again.
floor_status=0
floor_output=$(CI_TMUX_FLOOR=0.0 CI_TMUX_FLOOR_EXACT='' \
  "$ROOT/test/run" --tmux-floor-smoke 2>&1) || floor_status=$?
if [[ $floor_status != 1 || $floor_output != *'needs an exact CI_TMUX_FLOOR'* ]]; then
  fail 'tmux floor smoke rejects a missing exact floor binding'
fi

if ((failures > 0)); then
  printf '%s failure(s)\n' "$failures" >&2
  exit 1
fi

printf 'all harness tests passed\n'
