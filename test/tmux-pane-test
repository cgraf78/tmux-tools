#!/usr/bin/env bash
# Behaviour of bin/tmux-pane on a private tmux server. Every case named
# rg_<id>_... is a regression from the design rounds (the RG catalogue in
# tmux-pane(1)'s source design); the rest cover the normal paths.
#
# Isolation: a private server on a socket under the suite's temp root, always
# with -f /dev/null, TMUX and TMUX_PANE unset, TMUX_TMPDIR pointing at the
# temp root, killed on exit. The user's server is never addressed. The tool
# runs as "$BASH" bin/tmux-pane, so a suite run with /bin/bash tests Bash 3.2.
# shellcheck disable=SC2016 # Fixtures hold literal shell and tmux syntax.
set -uo pipefail
unset BASH_ENV ENV TMUX TMUX_PANE
export NO_COLOR=1
# tmux runs pane commands with $SHELL -c; keep the user's startup files out.
export SHELL=/bin/sh
ROOT=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)
TOOL="$ROOT/bin/tmux-pane"

failures=0
passes=0
pass() {
  passes=$((passes + 1))
  printf 'ok - %s\n' "$1"
}
fail() {
  failures=$((failures + 1))
  printf 'not ok - %s\n' "$1" >&2
}
check() { # check NAME EXPECTED ACTUAL
  if [ "$2" = "$3" ]; then pass "$1"; else
    fail "$1"
    printf '  expected: %q\n  actual:   %q\n' "$2" "$3" >&2
  fi
}
check_contains() { # check_contains NAME NEEDLE HAYSTACK
  case $3 in *"$2"*) pass "$1" ;; *)
    fail "$1"
    printf '  missing:  %q\n  in:       %q\n' "$2" "$3" >&2
    ;;
  esac
}
check_absent() { # check_absent NAME NEEDLE HAYSTACK
  case $3 in *"$2"*)
    fail "$1"
    printf '  unexpected: %q\n' "$2" >&2
    ;;
  *) pass "$1" ;; esac
}

# --- the parser identity test runs without tmux ---------------------------------

# Print the region between the parser markers, or fail unless each marker
# occurs exactly once and in order: a region that is missing or doubled must
# never compare equal by accident.
parser_region() {
  awk '
    $0 == "# BEGIN prompt-parser" { b++; inside = 1; next }
    $0 == "# END prompt-parser" { e++; inside = 0; if (b != 1) bad = 1; next }
    inside { print }
    END { if (b != 1 || e != 1 || inside || bad) exit 1 }
  ' "$1"
}
copy_region=$(parser_region "$ROOT/bin/tmux-copy-last-output") || copy_region='<bad>'
pane_region=$(parser_region "$TOOL") || pane_region='<bad>'
check_absent 'parser: tmux-copy-last-output has one well-formed region' '<bad>' "$copy_region"
check_absent 'parser: tmux-pane has one well-formed region' '<bad>' "$pane_region"
check 'parser: both copies are byte-identical' "$copy_region" "$pane_region"
scratch_parent=${TMPDIR:-/tmp}
[ "${#scratch_parent}" -le 60 ] || [ ! -d /tmp ] || scratch_parent=/tmp
tmp=$(
  umask 077
  mktemp -d "$scratch_parent/tpt.XXXXXXXX"
) || exit 1
sock="$tmp/s"
export TMUX_TMPDIR="$tmp"
# shellcheck disable=SC2329 # Invoked by the EXIT trap.
cleanup() {
  env -u TMUX tmux -S "$sock" kill-server >/dev/null 2>&1 || true
  env -u TMUX tmux -S "$tmp/s2" kill-server >/dev/null 2>&1 || true
  env -u TMUX tmux -S "$tmp/tmux-$(id -u)/default" kill-server >/dev/null 2>&1 || true
  rm -rf "$tmp"
}
trap cleanup EXIT
# rg_p16: a doubled or missing marker fails the identity test.
{
  printf '%s\n' '# BEGIN prompt-parser' 'x' '# BEGIN prompt-parser' 'y' '# END prompt-parser'
} >"$tmp/doubled"
printf '%s\n' 'x' >"$tmp/missing"
parser_region "$tmp/doubled" >/dev/null
check 'rg_p16 parser identity rejects a doubled marker' 1 "$?"
parser_region "$tmp/missing" >/dev/null
check 'rg_p16 parser identity rejects a missing region' 1 "$?"

# rg_i7: polls sleep a fraction of a second; Bash 3.2's read -t takes whole
# seconds, so the tool never uses it.
check 'rg_i7 the tool never waits with read -t' '' "$(grep -nE 'read +(-[a-zA-Z]+ +)*-[a-zA-Z]*t +[0-9$]' "$TOOL" || true)"

# --- drift: one interface list, checked against parsers, text and docs ----------

# The tool's own list (bin/tmux-pane "interface"): subcommands, options, exit
# statuses. Everything below must agree with it.
iface=$("$BASH" "$TOOL" --interface)
check 'drift: --interface exits 0' 0 "$?"
iline() { printf '%s\n' "$iface" | awk -v k="$1" '$1 == k { for (i = 2; i <= NF; i++) print $i }'; }
subs=$(iline subcommands | tr '\n' ' ')
sub_opts() { iline "$1" | sort -u; }
all_opts=$(for s in $subs top; do iline "$s"; done | sort -u)
exit_codes=$(iline exit)

# The geometry table: the names spelled out for ShellCheck are the table's,
# and no format holds a control byte (tmux 3.5 prints those escaped).
geom_tab=$(awk '/^geom_fields=/ { on = 1 } on { print } on && /'"'"'$/ { exit }' "$TOOL")
check 'drift: the spelled-out g_* names match geom_fields' \
  "$(printf '%s\n' "$geom_tab" | tr -d "'" | tr ' ' '\n' | sed -n 's/.*:\(g_[a-z]*\)$/\1/p' | sort)" \
  "$(awk '/^g_id=/ { on = 1 } on && /^g_/ { print; next } on { exit }' "$TOOL" | tr ' ' '\n' | sed -n "s/^\(g_[a-z]*\)=''$/\1/p" | sort)"
# A byte range, not [:print:]: busybox tr has no [:print:] class.
check 'drift: geom_fields has no control bytes' 0 "$(printf '%s' "$geom_tab" | tr -d '\n' | LC_ALL=C tr -d ' -~' | wc -c | tr -d ' ')"

# The top-level dispatch and each parser's case labels are exactly their
# options.
top_labels=$(awk '/^case \$sub in$/ { on = 1; next } on && /^esac/ { exit }
  on && /^  [^ ].*\)/ { l = $0; sub(/^ +/, "", l); sub(/\).*/, "", l)
    n = split(l, a, / \| /); for (i = 1; i <= n; i++) if (a[i] ~ /^-/) print a[i] }' "$TOOL" | sort -u)
check 'drift: the dispatch accepts exactly the top-level options' "$(sub_opts top)" "$top_labels"
for sub in $subs; do
  labels=$(awk -v f="cmd_$sub()" '
    $1 == f { on = 1; next }
    on && /^}/ { exit }
    on && /^      [^ #].*\)/ {
      l = $0; sub(/^ +/, "", l); sub(/\).*/, "", l)
      n = split(l, a, / \| /)
      for (i = 1; i <= n; i++) if (a[i] ~ /^-/ && a[i] !~ /[*?]/) print a[i]
    }' "$TOOL" | sort -u)
  check "drift: cmd_$sub parses exactly its listed options" "$(sub_opts "$sub")" "$labels"
done

# Option words a text uses: -x or --word, outside quotes, at a word start.
opt_words() {
  sed "s/'[^']*'//g; s/\\\\-/-/g; s/\\\\f[BIRP]//g" "$@" |
    grep -oE '(^|[][ (|,`])--?[A-Za-z][A-Za-z-]*' | sed 's/^[^-]*//' | sort -u
}
not_listed() { # words in $1 that $2 does not list
  printf '%s\n' "$1" | while IFS= read -r w; do
    [ -z "$w" ] || printf '%s\n' "$2" | grep -qxF -- "$w" || printf '%s ' "$w"
  done
}
missing_from() { # options in $1 that the option words $2 lack (whole words)
  printf '%s\n' "$1" | while IFS= read -r w; do
    case $w in '' | - | -- | -h | --help) continue ;; esac
    printf '%s\n' "$2" | grep -qxF -- "$w" || printf '%s ' "$w"
  done
}

# Usage and help: every option word is listed for the subcommand whose lines
# use it, and every listed option is shown. Lines naming tmux's own commands
# (the pane-id hint) are skipped; ACTION lines belong to send.
"$BASH" "$TOOL" >"$tmp/usage.txt" 2>&1
"$BASH" "$TOOL" --help >"$tmp/help.txt"
cat "$tmp/usage.txt" "$tmp/help.txt" | grep -v 'tmux list-panes' >"$tmp/text.txt"
for sub in $subs top; do
  awk -v s="$sub" '
    /^ACTION/ { cur = "send" }
    match($0, /tmux-pane [a-z]+/) { cur = substr($0, RSTART + 10, RLENGTH - 10) }
    /tmux-pane --/ { cur = "top" }
    cur == s' "$tmp/text.txt" >"$tmp/block.txt"
  check "drift: usage and help use only $sub's options" '' \
    "$(not_listed "$(opt_words "$tmp/block.txt")" "$(sub_opts "$sub")")"
  [ "$sub" != top ] || continue
  # The server options are spelled [SERVER] after the first subcommand.
  awk -v s="$sub" '
    /^ACTION/ { cur = "send" }
    match($0, /tmux-pane [a-z]+/) { cur = substr($0, RSTART + 10, RLENGTH - 10) }
    /tmux-pane --/ { cur = "top" }
    cur == s' "$tmp/usage.txt" >"$tmp/block.txt"
  check "drift: usage shows every $sub option" '' \
    "$(missing_from "$(sub_opts "$sub" | grep -vxE -e '-L|-S')" "$(opt_words "$tmp/block.txt")")"
done

# tmux-pane(1): every --word is an option, every option is documented, and
# the EXIT STATUS entries are the exit list.
man_page="$ROOT/man/man1/tmux-pane.1"
sed 's/\\-/-/g; s/\\f[BIRP]//g' "$man_page" >"$tmp/man.txt"
check 'drift: tmux-pane(1) uses only listed --options' '' \
  "$(not_listed "$(opt_words "$man_page" | grep -- '^--')" "$all_opts")"
check 'drift: tmux-pane(1) documents every option' '' "$(missing_from "$all_opts" "$(opt_words "$man_page")")"
# TMUX_PANE_TEST_DISABLE: the features the tool can force off are the ones
# tmux-pane(1) lists and the ones this suite forces off.
dis_tool=$(grep -oE 'disabled [a-zA-Z-]+' "$TOOL" | awk '$2 != "FEATURE" { print $2 }' | sort -u | tr '\n' ' ')
dis_man=$(awk '/^\.B TMUX_PANE_TEST_DISABLE$/ { on = 1; next } on && /^\.(TP|SH)/ { exit }
  on && /^\.BR / { print $2 }' "$man_page" | sort -u | tr '\n' ' ')
dis_test=$(grep -oE 'TMUX_PANE_TEST_DISABLE=[a-zA-Z,-]+' "$ROOT/test/tmux-pane-test" | sed 's/.*=//' | tr ',' '\n' | sort -u | tr '\n' ' ')
check 'drift: tmux-pane(1) lists the features TMUX_PANE_TEST_DISABLE forces off' "$dis_tool" "$dis_man"
check 'drift: the suite forces off every feature the tool can' "$dis_tool" "$dis_test"
# Result kinds, inexact reasons, defaults and the floor: the code uses
# exactly the listed ones, and the docs say the same.
words() { tr ' ' '\n' | grep -v '^$' | sort -u | tr '\n' ' '; }
code_results=$( (
  grep -oE 'wait_end [0-9"$a-z]+ "?[a-z-]+' "$TOOL" | awk '{ gsub(/"/, "", $3); print $3 }'
  grep -oE 'kind=[a-z]+' "$TOOL" | sed 's/kind=//'
) | tr '\n' ' ' | words)
check 'drift: the code reports exactly the listed result kinds' "$(iline result | tr '\n' ' ' | words)" "$code_results"
man_results=$(sed -n 's/^result=\([a-z|-]*\) exact=.*/\1/p' "$tmp/man.txt" | tr '|' ' ' | words)
check 'drift: tmux-pane(1) RESULT LINE lists the result kinds' "$(iline result | tr '\n' ' ' | words)" "$man_results"
code_reasons=$(grep -oE "loc_reason=('[a-z -]+'|[a-z-]+)" "$TOOL" | sed "s/loc_reason=//; s/'//g; s/ /-/g" | tr '\n' ' ' | words)
check 'drift: the code reports exactly the listed inexact reasons' "$(iline reason | tr '\n' ' ' | words)" "$code_reasons"
man_reasons=$(awk '/names the reason on standard error:/ { on = 1; next }
  on && !/^\.BR? / && $0 != "or" { exit }
  on && $0 != "or" { sub(/^\.BR? /, ""); gsub(/"/, ""); sub(/ [,.]$/, ""); gsub(/ /, "-"); print }' "$man_page" | tr '\n' ' ' | words)
check 'drift: tmux-pane(1) lists the inexact reasons' "$(iline reason | tr '\n' ' ' | words)" "$man_reasons"
man_flat=$(tr '\n' ' ' <"$tmp/man.txt" | sed 's/\.[A-Z][A-Z]* //g; s/  */ /g')
for d in $(iline default); do
  o=${d%%=*} v=${d#*=}
  check_contains "drift: tmux-pane(1) gives $o's default" "$o S (default $v" "$man_flat"
done
floor=$(iline floor)
check_contains 'drift: tmux-pane(1) VERSIONS names the floor' "tmux $floor and later" "$man_flat"
check_contains 'drift: tmux-pane(1) exit 1 names the floor' "older than $floor" "$man_flat"
check_contains 'drift: the README names the floor' "tmux $floor or newer" "$(cat "$ROOT/README.md")"
check_contains 'drift: AGENTS.md names the floor' "supports $floor and later" "$(cat "$ROOT/AGENTS.md")"
# AGENTS.md spells the exit statuses as a list with ranges.
agents_codes=$(tr '\n' ' ' <"$ROOT/AGENTS.md" | sed 's/  */ /g' | sed -n 's/.*Its exit codes (\([^)]*\)).*/\1/p' |
  tr ',/' '  ' | awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+-[0-9]+$/) { split($i, r, "-"); for (j = r[1]; j <= r[2]; j++) print j } else if ($i ~ /^[0-9]+$/) print $i }' | sort -n | tr '\n' ' ')
check 'drift: AGENTS.md lists the exit codes' "$(printf '%s\n' "$exit_codes" | sort -n | tr '\n' ' ')" "$agents_codes"
man_codes=$(awk '/^\.SH EXIT STATUS/ { on = 1; next } /^\.SH/ { on = 0 }
  on && /^\.BR? [0-9]/ { gsub(/[^0-9 ]/, " "); for (i = 1; i <= NF; i++) print $i }' "$man_page" |
  sort -n | tr '\n' ' ')
check 'drift: tmux-pane(1) EXIT STATUS lists the exit codes' "$(printf '%s\n' "$exit_codes" | sort -n | tr '\n' ' ')" "$man_codes"
used=$(grep -oE '(die|exit|wait_end|wait_result_error) [0-9]+' "$TOOL" | awk '{ print $2 }' | sort -un)
check 'drift: every literal exit status is listed' '' "$(not_listed "$used" "$(printf '%s\n' "$exit_codes")")"

# Every `tmux-pane SUB ...` reference in the docs names a real subcommand and
# only its options, and bare options and exit statuses are listed ones. The
# scanner is the tool's own --check-refs, the copy other repositories' doc
# tests use too. Its "#refs N" line counts the references read, so a scan
# that silently reads nothing fails here.
ref_check() { # ref_check FILE...: prints bad references; fails loudly if the scan does
  local out
  out=$("$BASH" "$TOOL" --check-refs "$@" 2>&1) || out="checker failed: $out"
  case $out in *'#refs '[0-9]*) ;; *) out="checker failed${out:+: $out}" ;; esac
  printf '%s\n' "$out" | grep -v '^#refs '
}
# One call over every document, so another command's options (named in a
# record without tmux-pane) are known as theirs.
docs=("$ROOT/README.md" "$ROOT/AGENTS.md" "$ROOT"/man/man1/*.1)
check 'drift: the docs name only real tmux-pane subcommands, options and exits' '' \
  "$(ref_check "${docs[@]}" | sort -u | tr '\n' ';')"
check 'drift: help and usage examples use real options' '' "$(ref_check "$tmp/text.txt" | sort -u | tr '\n' ';')"
# The checker itself: a wrong option, bracketed ones (also after a | inside
# brackets), one wrapped onto the next line, a bare unknown option, a wrong
# subcommand and unlisted exit statuses; prose numbers are not statuses.
cat >"$tmp/bad.md" <<'EOF'
- `tmux-pane send -t %1 --enterr [--typ]` or `tmux-pane bogus -t %1`.
- `tmux-pane read -t %N [--line N | --al]` and `tmux-pane wait
  -t %1 --wrapped`; keep `--sincee` low. After 5 retries it exits 99, or
  exit 64 or 98; after 68 is fine.
EOF
check 'drift: the reference check flags bad references' \
  'exit 98;exit 99;option --sincee;read --al;read --line;send --enterr;send --typ;subcommand bogus;wait --wrapped;' \
  "$(ref_check "$tmp/bad.md" | sort -u | tr '\n' ';')"
printf '%s\n' 'run `tmux-pane send -t %1 --enter '"'"'a -b'"'"'` and `tmux-pane read|wait -t %1' \
  '--since "$M"`' >"$tmp/good.md"
check 'drift: the reference check reads known-good references' '#refs 2' "$("$BASH" "$TOOL" --check-refs "$tmp/good.md")"
check 'drift: the docs hold references for it to check' 1 \
  "$([ "$("$BASH" "$TOOL" --check-refs "${docs[@]}" | sed -n 's/^#refs //p')" -ge 10 ] && echo 1 || echo 0)"
if ! command -v tmux >/dev/null 2>&1; then
  if [ "${TMUX_TOOLS_REQUIRE_TMUX:-0}" = 1 ]; then
    printf 'FAIL: tmux required for tmux-pane-test\n' >&2
    exit 1
  fi
  printf 'SKIP: tmux unavailable for tmux-pane-test\n'
  exit "$((failures != 0))"
fi

# --- harness --------------------------------------------------------------------

T() { env -u TMUX -u TMUX_PANE tmux -S "$sock" -f /dev/null "$@"; }
tp() { # tp SUBCOMMAND ARGS...: run the tool against the private server
  local sub=$1
  shift
  env -u TMUX -u TMUX_PANE "$BASH" "$TOOL" "$sub" -S "$sock" "$@"
}
vstr=$(tmux -V)
vnum=${vstr#tmux }
vmaj=999 vmin=0
if [[ $vnum =~ ^([0-9]+)\.([0-9]+) ]]; then vmaj=${BASH_REMATCH[1]} vmin=$((10#${BASH_REMATCH[2]})); fi
tmux_ge() { [ "$vmaj" -gt "$1" ] || { [ "$vmaj" -eq "$1" ] && [ "$vmin" -ge "$2" ]; }; }
printf '# %s\n' "$vstr"
skip() { printf 'ok - %s # SKIP %s\n' "$1" "$2"; }

T start-server \; set -g history-limit 2000 \; set -g extended-keys on \; \
  new-session -d -s t -x 80 -y 24 'exec sleep 100000' || exit 1
decoy=$(T list-panes -t t -F '#{pane_id}' | head -n 1)
[ -n "$decoy" ] || exit 1

newpane() { # newpane COMMAND [WIDTH HEIGHT]: a new window; prints its pane id
  local id
  id=$(T new-window -d -P -F '#{pane_id}' -t t: "$1") || return 1
  [ -n "$id" ] || return 1
  if [ $# -ge 3 ]; then T resize-window -t "$id" -x "$2" -y "$3" >/dev/null 2>&1; fi
  printf '%s\n' "$id"
}
killpane() { [ -n "${1:-}" ] && T kill-pane -t "$1" >/dev/null 2>&1; }

# A raw sink: everything the pane receives lands in FILE byte for byte. The
# optional INIT is printf text the sink's program emits first (bracketed
# paste, application cursor keys, extended keys).
# The sink touches FILE.ready once its tty is raw: bytes sent before that
# would sit in the line discipline. It appends, so tests can truncate FILE.
sinkcmd() { # sinkcmd FILE [INIT]
  : >"$1"
  rm -f "$1.ready"
  printf "%s" "stty raw -echo; printf '${2:-}'; : >'$1.ready'; exec cat >>'$1'"
}
sink_ready() { # sink_ready FILE
  local n=0
  while [ ! -e "$1.ready" ] && [ "$n" -lt 100 ]; do
    n=$((n + 1))
    sleep 0.05
  done
  sleep 0.1
}
sink() { # sink FILE [INIT]: a new window; prints its pane id
  newpane "$(sinkcmd "$1" "${2:-}")" && sink_ready "$1"
}
splitsink() { # splitsink PANE FILE [INIT]: a pane beside PANE, in its window
  T split-window -d -P -F '#{pane_id}' -t "$1" "$(sinkcmd "$2" "${3:-}")" && sink_ready "$2"
}
settle_file() { # wait until FILE stops growing
  local a b n=0
  a=-1
  while [ "$n" -lt 40 ]; do
    b=$(wc -c <"$1" | tr -d ' ')
    [ "$a" = "$b" ] && [ "$b" != 0 ] && return 0
    a=$b
    n=$((n + 1))
    sleep 0.1
  done
}
await_size() { # await_size FILE BYTES: wait (up to 20 s) until FILE holds BYTES
  local n=0
  while [ "$(wc -c <"$1" | tr -d ' ')" -lt "$2" ] && [ "$n" -lt 200 ]; do
    n=$((n + 1))
    sleep 0.1
  done
}
hexof() { od -An -tx1 | tr -d ' \n'; }
hexfile() { hexof <"$1"; }
# shellcheck disable=SC2059 # The argument is a printf format by design.
hexfmt() { printf -- "$1" | hexof; }

# The fake shell prints the two-line prompt the parser knows, sets the title
# the dotfiles prompt sets, and runs each line. Its environment selects
# variants: FAKE_TITLE=0 drops the title, FAKE_ROOT=1 uses #, FAKE_LONG=1
# makes line 1 wide, FAKE_REDRAW=1 redraws line 1 late, FAKE_SUGGEST=1 draws
# a dim suggestion after the cursor, FAKE_NOECHO=1 echoes input itself late.
cat >"$tmp/fakesh" <<'EOF'
#!/usr/bin/env bash
st=0
path=/repo
[ "${FAKE_LONG:-0}" = 1 ] && path=/repo/a/very/long/path/that/wraps/in/narrow/panes
ch='$'
[ "${FAKE_ROOT:-0}" = 1 ] && ch='#'
[ "${FAKE_NOECHO:-0}" = 1 ] && stty -echo
while :; do
  [ "${FAKE_TITLE:-1}" = 1 ] && printf '\033]0;me@host: %s\007' "$path"
  [ "$st" -ne 0 ] && printf '[%s] ' "$st"
  printf 'me@host:%s (main)\n%s ' "$path" "$ch"
  if [ "${FAKE_SUGGEST:-0}" = 1 ]; then printf '\033[2mgit status\033[0m\033[10D'; fi
  if [ "${FAKE_REDRAW:-0}" = 1 ]; then
    sleep 0.05
    printf '\0337\033[A\r'
    [ "$st" -ne 0 ] && printf '[%s] ' "$st"
    printf 'me@host:%s (main) +\0338' "$path"
    sleep 0.3
  fi
  IFS= read -r line || exit 0
  if [ "${FAKE_NOECHO:-0}" = 1 ]; then sleep 0.5; printf '%s\n' "$line"; fi
  eval "$line"
  st=$?
done
EOF
chmod +x "$tmp/fakesh"
shellpane() { # shellpane [ENV=VALUE...]: a fake shell pane, ready at its prompt
  local id n=0
  id=$(newpane "env $* '$tmp/fakesh'" "${FAKE_W:-80}" "${FAKE_H:-24}") || return 1
  while [ "$n" -lt 50 ]; do
    case $(T capture-pane -p -t "$id" 2>/dev/null) in *'me@host:'*) break ;; esac
    n=$((n + 1))
    sleep 0.1
  done
  printf '%s\n' "$id"
}

# The fake agent marks busy through the branch's term-pane-mark, as an agent
# hook would, works, replies and marks done. Commands: ignore (no turn), ask
# (raises waiting, takes an answer), die (blocked), nodone (no done mark),
# glance (done cleared before busy), double (a second turn right after).
cat >"$tmp/fakeagent" <<'EOF'
#!/usr/bin/env bash
M=${MARK:-$ROOT/bin/term-pane-mark}
turn() {
  "$M" set busy --pane "$TMUX_PANE" --token "t:$RANDOM$RANDOM" 2>/dev/null
}
token() { tmux show-options -pqv -t "$TMUX_PANE" @term_busy_token; }
while IFS= read -r line; do
  case $line in ignore*) continue ;; esac
  turn
  tok=$(token)
  case $line in
    ask*)
      sleep 0.4
      "$M" set pending --kind waiting --pane "$TMUX_PANE"
      IFS= read -r ans
      "$M" clear pending --if waiting --pane "$TMUX_PANE"
      ;;
    die*)
      sleep 0.3
      "$M" set pending --kind blocked --pane "$TMUX_PANE"
      "$M" clear busy --pane "$TMUX_PANE" --token "$tok"
      continue
      ;;
  esac
  sleep "${AGENT_SLEEP:-0.6}"
  printf 'REPLY %s\n' "$line"
  case $line in
    nodone*) ;;
    glance*)
      "$M" set pending --kind done --pane "$TMUX_PANE"
      tmux set-option -pu -t "$TMUX_PANE" @term_notify_pending
      sleep 0.3
      ;;
    *) "$M" set pending --kind done --pane "$TMUX_PANE" ;;
  esac
  "$M" clear busy --pane "$TMUX_PANE" --token "$tok"
