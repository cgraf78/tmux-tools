# A logging pass-through tmux shim, first on PATH: it records every argv
# (one shell-quoted line per call) and runs the real tmux.
real_tmux=$(command -v tmux)
mkdir -p "$tmp/shim"
cat >"$tmp/shim/tmux" <<EOF
#!/usr/bin/env bash
{ printf '%q ' "\$@"; printf '\n'; } >>"\${SHIM_LOG:-/dev/null}"
if [ "\$1" = -V ] && [ -n "\${SHIM_VERSION+x}" ]; then
  printf '%s\n' "\$SHIM_VERSION"
  exit 0
fi
if [ -n "\${SHIM_PASTE_USAGE:-}" ] && [ "\$*" = "-u -S $sock list-commands paste-buffer" ]; then
  printf '%s\n' "\$SHIM_PASTE_USAGE"
  exit 0
fi
if [ -n "\${SHIM_FAIL_ON:-}" ]; then
  for a in "\$@"; do [ "\$a" = "\$SHIM_FAIL_ON" ] && exit 1; done
fi
# SHIM_STOP_AFTER=WORD runs the command only up to the first argument WORD
# and then fails, like a tmux queue that stopped part way.
if [ -n "\${SHIM_STOP_AFTER:-}" ]; then
  n=0
  for a in "\$@"; do
    n=\$((n + 1))
    [ "\$a" = "\$SHIM_STOP_AFTER" ] || continue
    "$real_tmux" "\${@:1:n}" >/dev/null 2>&1
    exit 1
  done
fi
# SHIM_SHRINK=PANE: before each of a read's locate queues (the one with the
# nonce-1 marker), shrink PANE by one row, SHIM_SHRINK_TIMES times in all, so
# history grows between the pre-query and the queue.
if [ -n "\${SHIM_SHRINK:-}" ]; then
  for a in "\$@"; do
    case \$a in tmux-pane-*-1) ;; *) continue ;; esac
    n=\$(cat "\$SHIM_LOG.shrunk" 2>/dev/null || echo 0)
    if [ "\$n" -lt "\${SHIM_SHRINK_TIMES:-1}" ]; then
      echo \$((n + 1)) >"\$SHIM_LOG.shrunk"
      "$real_tmux" -S "$sock" -f /dev/null resize-window -t "\$SHIM_SHRINK" -y \$((23 - n))
    fi
  done
fi
exec "$real_tmux" "\$@"
EOF
chmod +x "$tmp/shim/tmux"
tps() { # tps LOG SUBCOMMAND ARGS...: run through the shim
  local log=$1 sub=$2
  shift 2
  env -u TMUX -u TMUX_PANE SHIM_LOG="$log" PATH="$tmp/shim:$PATH" "$BASH" "$TOOL" "$sub" -S "$sock" "$@"
