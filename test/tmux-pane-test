# A send too long for one tmux command is refused before anything is sent.
big=()
for _ in $(seq 800); do big+=(--keys Up); done
: >"$so"
tp send -t "$sp" "${big[@]}" 2>/dev/null
check 'send: too many actions for one queue is a usage error' 64 "$?"

# rg_x2: text and Enter under sync reach only the target.
x2t_out="$tmp/x2t.out" x2o_out="$tmp/x2o.out"
x2t=$(sink "$x2t_out")
x2o=$(splitsink "$x2t" "$x2o_out")
T set-option -w -t "$x2t" synchronize-panes on
tp send -t "$x2t" 'synced' --keys 'C-c Escape' --enter 2>/dev/null
settle_file "$x2t_out"
check 'rg_x2 the target gets text and keys' "$(hexfmt 'synced\003\033\r')" "$(hexfile "$x2t_out")"
check 'rg_x2 the other synchronized pane gets nothing' '' "$(hexfile "$x2o_out")"
: >"$x2t_out"
# The pane-level override is set and put back in the send's own queue: an
# inherited setting stays inherited, a pane's own value is restored, and the
# window's is never touched.
check 'sync: no pane-level value is left behind' '' "$(T show-options -pqv -t "$x2t" synchronize-panes)"
check 'sync: the window still synchronizes' on "$(T show-options -wqv -t "$x2t" synchronize-panes)"
T set-option -p -t "$x2t" synchronize-panes on
: >"$x2t_out"
tp send -t "$x2t" --keys 'a b' 2>/dev/null
settle_file "$x2t_out"
check 'sync: with a pane-level on, keys still reach only the target' '' "$(hexfile "$x2o_out")"
check 'sync: and the pane-level on is restored' on "$(T show-options -pqv -t "$x2t" synchronize-panes)"
T set-option -pu -t "$x2t" synchronize-panes
# A queue that stops right after the override still gets its setting back.
SHIM_STOP_AFTER=off tps /dev/null send -t "$x2t" --keys a >/dev/null 2>&1
check 'sync: a queue that stops part way fails' 1 "$?"
check 'sync: and the inherited setting comes back' '' "$(T show-options -pqv -t "$x2t" synchronize-panes)"
T set-option -p -t "$x2t" synchronize-panes on
SHIM_STOP_AFTER=off tps /dev/null send -t "$x2t" --keys a >/dev/null 2>&1
check 'sync: and so does a pane-level value' on "$(T show-options -pqv -t "$x2t" synchronize-panes)"
T set-option -pu -t "$x2t" synchronize-panes
: >"$x2t_out"
T copy-mode -t "$x2t"
# Up moves the copy-mode cursor (Enter would copy and leave the mode).
tp send -t "$x2t" --keep-mode --keys Up 2>/dev/null
sleep 0.3
check 'rg_x12 with sync on, --keep-mode keys go to the mode too' '' "$(hexfile "$x2t_out")"
check 'rg_x12 and the mode stays' 1 "$(T display -p -t "$x2t" '#{pane_in_mode}')"
T send-keys -t "$x2t" -X cancel 2>/dev/null
T set-option -s extended-keys on
# rg_x10: under sync, tmux encodes every key for the target's own mode, Ext 2
# included, and still only the target receives it.
if tmux_ge 3 5; then
  x10_out="$tmp/x10.out"
  x10=$(splitsink "$x2t" "$x10_out" '\033[>4;2m')
  check 'rg_x10 the fixture is in Ext 2 mode' 'Ext 2' "$(T display -p -t "$x10" '#{pane_key_mode}')"
  : >"$x2o_out"
  tp send -t "$x10" --keys 'C-c C-;' 2>/dev/null
  check 'rg_x10 C-c and C-; under sync in Ext 2 send' 0 "$?"
  settle_file "$x10_out"
  check 'rg_x10 and the target receives them' 1 "$([ -s "$x10_out" ] && echo 1 || echo 0)"
  check 'rg_x10 and no other pane does' '' "$(hexfile "$x2o_out")"
  killpane "$x10"
else
  skip 'rg_x10 pane_key_mode needs 3.5' "$vstr"
fi
# rg_x11: without pane_key_mode (3.2-3.4, or forced) and extended-keys on,
# the VT10x pre-check is skipped; under sync modified keys send as well.
env TMUX_PANE_TEST_DISABLE=key-mode "$BASH" -c 'exec "$@"' _ \
  env -u TMUX -u TMUX_PANE "$BASH" "$TOOL" send -S "$sock" -t "$x2t" --keys C-c 2>/dev/null
check 'rg_x11 possibly-extended mode under sync: C-c sends' 0 "$?"
T set-option -w -t "$x2t" synchronize-panes off
env TMUX_PANE_TEST_DISABLE=key-mode "$BASH" -c 'exec "$@"' _ \
  env -u TMUX -u TMUX_PANE "$BASH" "$TOOL" send -S "$sock" -t "$x2t" --keys C-BSpace 2>/dev/null
check 'rg_x11 possibly-extended mode skips the VT10x pre-check' 0 "$?"
killpane "$x2o"
killpane "$x2t"

# rg_x14: term-pane-mark counts a turn only after setting its busy mark, in
# the same queue, so a failed earlier command leaves no count without busy.
mlog="$tmp/mark.log"
: >"$mlog"
env SHIM_LOG="$mlog" PATH="$tmp/shim:$PATH" TMUX="$sock,1,0" TMUX_PANE="$sp" TERM_PROGRAM=tmux \
  "$ROOT/bin/term-pane-mark" set busy --pane "$sp"
order=$(awk '{ b = index($0, "@term_busy\\ 1"); if (b == 0) b = index($0, "@term_busy 1"); s = index($0, "@term_busy_seq"); print (b > 0 && s > b) ? "busy-then-seq" : "wrong" }' "$mlog" | head -n 1)
check 'rg_x14 the seq bump follows the busy mark in one queue' busy-then-seq "$order"
check 'rg_x14 and it counted' 1 "$(T show -pqv -t "$sp" @term_busy_seq)"
T set-option -pu -t "$sp" @term_busy \; set-option -pu -t "$sp" @term_busy_seq

out=$(tp send -t "$sp" 'quiet' 2>/dev/null)
check 'send: plain send prints nothing' '' "$out"
out=$(tp send -t "$sp" 'loud' --print-marker 2>/dev/null)
check_contains 'send: --print-marker prints a marker' 'tp1:' "$out"
killpane "$sp"

# --- read and markers -------------------------------------------------------------

sh=$(shellpane)
tp send -t "$sh" 'printf "one\ntwo\n"' --enter --wait prompt >/dev/null 2>&1
out=$(tp read -t "$sh")
check_contains 'read: the default is the screen' 'two' "$out"
check 'read: trailing blank rows are trimmed' '$' "$(printf '%s\n' "$out" | tail -n 1)"
check 'read: --lines 2 is the last two rows' "$(printf 'me@host:/repo (main)\n$')" "$(tp read -t "$sh" --lines 2)"
check_contains 'read: --all includes history' 'one' "$(tp read -t "$sh" --all)"
out=$(tp read -t "$sh" --last-output 2>"$tmp/err")
check 'read: --last-output is the last block' "$(printf '$ printf "one\\ntwo\\n"\none\ntwo')" "$out"
check 'read: --last-output reports the status' 'status=0' "$(cat "$tmp/err")"
M=$(tp send -t "$sh" 'echo after' --enter --print-marker)
sleep 0.5
out=$(tp read -t "$sh" --since "$M")
check 'read: an exact --since starts at the typed command' '$ echo after' "$(printf '%s\n' "$out" | head -n 1)"
check 'read: --since exits 0 when exact' 0 "$(
  tp read -t "$sh" --since "$M" >/dev/null 2>&1
  echo $?
)"
check 'read: --since --lines 2' "$(printf 'me@host:/repo (main)\n$')" "$(tp read -t "$sh" --since "$M" --lines 2)"
check 'read: --last-output --since' "$(printf '$ echo after\nafter')" "$(tp read -t "$sh" --since "$M" --last-output 2>/dev/null)"
M18=$(tp mark -t "$sh")
check 'rg_m18 a mark marker has no echo prefix' 0 "$(printf '%s\n' "$M18" | cut -d: -f18)"
check 'rg_m18 a mark marker checks the prefix and is exact on an unchanged pane' 0 \
  "$(
    tp read -t "$sh" --since "$M18" >/dev/null 2>&1
    echo $?
  )"
# --ansi keeps escapes; --join undoes wrapping.
tp send -t "$sh" "printf '\\033[31mred\\033[0m\\n'" --enter --wait prompt >/dev/null 2>&1
check_contains 'read: --ansi keeps SGR' "$(printf '\033[31m')red" "$(tp read -t "$sh" --ansi --lines 4)"
check_absent 'read: plain drops SGR' "$(printf '\033[31m')" "$(tp read -t "$sh" --lines 4)"
killpane "$sh"
FAKE_W=10 FAKE_H=10
# The line is printed only once the pane is 10 wide, so it wraps rather than
# being reflowed after a late resize.
nw=$(newpane "until [ \"\$(stty size)\" = '10 10' ]; do sleep 0.05; done; stty raw -echo; printf 'abcdefghijklmnopqrstuvwxy\\r\\n'; exec cat >/dev/null" 10 10)
[ -n "$nw" ] || exit 1
sleep 0.5
check 'read: a wrapped line is three rows plain' 3 "$(tp read -t "$nw" | grep -c .)"
check 'read: --join makes it one line' 'abcdefghijklmnopqrstuvwxy' "$(tp read -t "$nw" --join)"
killpane "$nw"
FAKE_W=80 FAKE_H=24

inexact() { # inexact NAME PANE MARKER [REASON]
  local out rc err
  out=$(tp read -t "$2" --since "$3" 2>"$tmp/inx.err")
  rc=$?
  err=$(cat "$tmp/inx.err")
  check "$1 (exit 4)" 4 "$rc"
  [ -z "${4:-}" ] || check_contains "$1 (reason)" "$4" "$err"
  local h
  h=$(T display -p -t "$2" '#{pane_height}')
  check "rg_m20 $1 prints at most the screen" 1 "$([ "$(printf '%s\n' "$out" | wc -l | tr -d ' ')" -le "$h" ] && echo 1 || echo 0)"
}

# rg_m1, rg_m2: history at the trim floor makes the old row untrustworthy,
# repeated identical content or not.
T set-option -g history-limit 100
sh=$(shellpane)
M=$(tp send -t "$sh" 'echo same' --enter --print-marker)
sleep 0.3
for _ in 1 2 3 4 5 6; do tp send -t "$sh" 'echo same; seq 20' --enter --wait prompt >/dev/null 2>&1; done
inexact 'rg_m1 repeated sends past the trim floor are inexact' "$sh" "$M" trimmed
M=$(tp send -t "$sh" 'echo anchor' --enter --print-marker)
sleep 0.3
tp send -t "$sh" 'seq 300; echo anchor' --enter --wait prompt >/dev/null 2>&1
inexact 'rg_m2 a trimmed marker with a later copy is inexact' "$sh" "$M" trimmed
if tmux_ge 3 7; then
  T set-option -g history-limit 2000
  sh2=$(shellpane)
  M=$(tp send -t "$sh2" 'echo limit' --enter --print-marker)
  sleep 0.3
  T set-option -g history-limit 1500
  if tmux_ge 3 8; then
    # The counters account for a lower limit; the marker row is still there.
    check 'rg_m12 lowering history-limit with 3.8 counters stays exact' 1 \
      "$(tp read -t "$sh2" --since "$M" 2>/dev/null | grep -c '^\$ echo limit$')"
  else
    inexact 'rg_m12 lowering history-limit (3.7+ applies it) is inexact' "$sh2" "$M" trimmed
  fi
  killpane "$sh2"
else
  skip 'rg_m12 history-limit changes reach existing panes from 3.7' "$vstr"
fi
T set-option -g history-limit 2000
killpane "$sh"

sh=$(shellpane)
# rg_m3: a resize.
M=$(tp send -t "$sh" 'echo resize' --enter --print-marker)
sleep 0.3
T resize-window -t "$sh" -x 60 -y 24
inexact 'rg_m3 a resize is inexact' "$sh" "$M" resized
T resize-window -t "$sh" -x 80 -y 24
# rg_m6: ESC[3J and clear-history shrink history.
tp send -t "$sh" 'seq 40' --enter --wait prompt >/dev/null 2>&1
M=$(tp send -t "$sh" 'echo clr' --enter --print-marker)
sleep 0.3
T clear-history -t "$sh"
inexact 'rg_m6 clear-history is inexact' "$sh" "$M"
M=$(tp send -t "$sh" "printf '\\033[3J'" --enter --print-marker)
sleep 0.3
inexact 'rg_m6 ESC[3J is inexact' "$sh" "$M"
# rg_m8: clear; seq 40, twice: history regrows past its size and the top
# rows match again, but the typed text is no longer where it was typed.
cmd="printf '\\033[H\\033[2J\\033[3J'; seq 40"
tp send -t "$sh" "$cmd" --enter --wait prompt >/dev/null 2>&1
M=$(tp send -t "$sh" "$cmd" --enter --print-marker)
tp wait -t "$sh" --prompt --since "$M" >/dev/null 2>&1
if tmux_ge 3 8; then
  inexact 'rg_m8 clear; seq 40 twice is never exact' "$sh" "$M" 'generation changed'
else
  inexact 'rg_m8 clear; seq 40 twice is never exact' "$sh" "$M" 'echo moved'
fi
# rg_m16: the alternate screen.
M=$(tp send -t "$sh" "printf '\\033[?1049h'; sleep 2; printf '\\033[?1049l'" --enter --print-marker)
sleep 0.4
inexact 'rg_m16 the alternate screen is inexact' "$sh" "$M" 'alternate screen'
sleep 2
# rg_m13: a weak marker (too few top rows) is never trusted.
M=$(tp send -t "$sh" 'echo weak' --enter --print-marker)
sleep 0.3
weak=$(printf '%s\n' "$M" | awk -F: 'BEGIN { OFS = ":" } { $11 = 0; print }')
inexact 'rg_m13 a weak marker is inexact' "$sh" "$weak" 'weak marker'
# The top rows of history no longer match (on 3.8 too, without the counters).
top=$(printf '%s\n' "$M" | awk -F: '{ $12 = "0"; s = $1; for (i = 2; i <= 24; i++) s = s ":" $i; print s }')
inexact 'grid-top: changed top rows are inexact' "$sh" "$top" 'grid-top changed'
killpane "$sh"

# rg_m4: a fresh pane, then clear; echo hi.
sh=$(shellpane)
M=$(tp send -t "$sh" "printf '\\033[H\\033[2J\\033[3J'; echo hi" --enter --print-marker)
sleep 0.4
inexact 'rg_m4 a fresh pane after clear; echo hi is inexact' "$sh" "$M"
killpane "$sh"

# rg_m5: scroll-on-clear off: an in-place clear needs fp_above to match.
sh=$(shellpane)
tp send -t "$sh" 'seq 5' --enter --wait prompt >/dev/null 2>&1
if tmux_ge 3 3; then
  T set-option -p -t "$sh" scroll-on-clear off 2>/dev/null || T set-option -w -t "$sh" scroll-on-clear off
  M=$(tp send -t "$sh" "printf '\\033[H\\033[2J'; echo x" --enter --print-marker)
  sleep 0.4
  inexact 'rg_m5 scroll-on-clear off then ESC[2J is inexact' "$sh" "$M"
  T set-option -p -t "$sh" scroll-on-clear on 2>/dev/null || T set-option -w -t "$sh" scroll-on-clear on
else
  skip 'rg_m5 the scroll-on-clear option arrived in 3.3' "$vstr"
fi
M=$(env TMUX_PANE_TEST_DISABLE=soc "$BASH" -c 'exec "$@"' _ env -u TMUX -u TMUX_PANE "$BASH" "$TOOL" send -S "$sock" -t "$sh" 'echo soc' --enter --print-marker)
sleep 0.4
check 'rg_m5 with soc forced off, an unchanged pane is exact through fp_above' 0 \
  "$(
    env TMUX_PANE_TEST_DISABLE=soc "$BASH" -c 'exec "$@"' _ env -u TMUX -u TMUX_PANE "$BASH" "$TOOL" read -S "$sock" -t "$sh" --since "$M" >/dev/null 2>&1
    echo $?
  )"
# rg_m19: ESC[2J with scroll-on-clear on (and on 3.2, which always scrolls)
# keeps the marker exact.
M=$(tp send -t "$sh" "printf '\\033[2J'; echo kept" --enter --print-marker)
sleep 0.4
check 'rg_m19 ESC[2J with scroll-on-clear on is exact' 0 "$(
  tp read -t "$sh" --since "$M" >/dev/null 2>&1
  echo $?
)"
killpane "$sh"

# rg_m7: a blank gap: the cursor row and the row above are blank, then
# ESC[H ESC[2J; output must never be missed.
gp="$tmp/gap.sh"
printf '#!/bin/sh\nprintf "\\n\\n\\n"\nIFS= read -r l\nprintf "\\033[H\\033[2J"\necho NEWOUT\nsleep 100\n' >"$gp"
chmod +x "$gp"
g=$(newpane "$gp")
sleep 0.3
M=$(tp mark -t "$g")
tp send -t "$g" --enter >/dev/null 2>&1
n=0
while [ "$n" -lt 50 ]; do
  case $(T capture-pane -p -t "$g") in *NEWOUT*) break ;; esac
  n=$((n + 1))
  sleep 0.1
done
out=$(tp read -t "$g" --since "$M" 2>/dev/null)
rc=$?
if [ "$rc" = 0 ]; then
  check_contains 'rg_m7 an exact result after a blank gap includes the new output' NEWOUT "$out"
else
  check 'rg_m7 a blank gap is inexact' 4 "$rc"
  check_contains 'rg_m7 and the screen shows the new output' NEWOUT "$out"
fi
killpane "$g"

# rg_m14, rg_m15: agent-like TUIs below some static rows. Redrawing the rows
# above the cursor keeps an exact result; redrawing the input row moves the
# echo.
cat >"$tmp/tui" <<'EOF'
#!/usr/bin/env bash
printf 'header %s\n' 1 2 3 4 5 6 7 8
printf 'spin 0\n> '
IFS= read -r line
i=0
while [ "$i" -lt 5 ]; do printf '\0337\033[2A\r\033[2Kspin %s\0338' "$i"; i=$((i + 1)); sleep 0.05; done
if [ "${MOVE:-0}" = 1 ]; then printf '\033[A\r\033[2Kmessage: %s\n\033[2K> ' "$line"; fi
printf '\nreply done\n'
sleep 100
EOF
chmod +x "$tmp/tui"
tui=$(newpane "$tmp/tui")
sleep 0.3
M=$(tp send -t "$tui" 'hello tui' --enter --print-marker)
sleep 0.6
check 'rg_m14 a TUI redrawing above the cursor stays exact' 0 "$(
  tp read -t "$tui" --since "$M" >/dev/null 2>&1
  echo $?
)"
killpane "$tui"
tui=$(newpane "env MOVE=1 '$tmp/tui'")
sleep 0.3
M=$(tp send -t "$tui" 'hello tui' --enter --print-marker)
sleep 0.6
inexact 'rg_m15 a TUI redrawing its input row is inexact' "$tui" "$M" 'echo moved'
killpane "$tui"

# rg_m17: history that grows between a read's pre-query and its queue makes
# the computed ranges stale, so the read queries again; when it never holds
# still the result is inexact.
sh=$(shellpane)
M=$(tp send -t "$sh" 'seq 60' --enter --print-marker)
tp wait -t "$sh" --prompt --since "$M" >/dev/null 2>&1
slog="$tmp/shrink.log"
: >"$slog"
rm -f "$slog.shrunk"
SHIM_SHRINK="$sh" SHIM_SHRINK_TIMES=1 tps "$slog" read -t "$sh" --since "$M" >/dev/null 2>&1
check 'rg_m17 one growth between pre-query and queue queries again' 2 "$(grep -c 'tmux-pane-.*-1' "$slog")"
T resize-window -t "$sh" -x 80 -y 24
M=$(tp send -t "$sh" 'echo again' --enter --print-marker)
sleep 0.3
: >"$slog"
rm -f "$slog.shrunk"
SHIM_SHRINK="$sh" SHIM_SHRINK_TIMES=5 tps "$slog" read -t "$sh" --since "$M" >/dev/null 2>"$tmp/inx.err"
check 'rg_m17 history that never holds still is inexact' 4 "$?"
check_contains 'rg_m17 as unstable' unstable "$(cat "$tmp/inx.err")"
T resize-window -t "$sh" -x 80 -y 24
killpane "$sh"
# rg_m17: a fresh pane has no history; its marker covers grid rows on the
# screen and is exact.
sh=$(shellpane)
M=$(tp send -t "$sh" 'echo fresh' --enter --print-marker)
sleep 0.3
check 'rg_m17 a marker on a fresh pane is exact' 0 "$(
  tp read -t "$sh" --since "$M" >/dev/null 2>&1
  echo $?
)"
killpane "$sh"

# rg_m9..rg_m11: the 3.8 counters.
if tmux_ge 3 8; then
  T set-option -g history-limit 100
  sh=$(shellpane)
  # History is full and trimming: the trusted-row path would say trimmed.
  tp send -t "$sh" 'seq 150' --enter --wait prompt >/dev/null 2>&1
  M=$(tp send -t "$sh" 'echo counted' --enter --print-marker)
  sleep 0.3
  tp send -t "$sh" 'seq 20' --enter --wait prompt >/dev/null 2>&1
  check 'rg_m9 with 3.8 counters, trims stay exact' 1 "$(tp read -t "$sh" --since "$M" 2>/dev/null | grep -c '^\$ echo counted$')"
  # Without the counters (forced off), the same read falls back to the
  # trusted-row path, which cannot see past a trim.
  env TMUX_PANE_TEST_DISABLE=counters "$BASH" -c 'exec "$@"' _ \
    env -u TMUX -u TMUX_PANE "$BASH" "$TOOL" read -S "$sock" -t "$sh" --since "$M" >/dev/null 2>"$tmp/inx.err"
  check 'rg_m9 with the counters forced off, a trim is inexact' 4 "$?"
  check_contains 'rg_m9 as trimmed' trimmed "$(cat "$tmp/inx.err")"
  T clear-history -t "$sh"
  inexact 'rg_m9 clear-history bumps the generation' "$sh" "$M" 'generation changed'
  M=$(tp send -t "$sh" "printf '\\033[3J'" --enter --print-marker)
  sleep 0.3
  inexact 'rg_m9 ESC[3J bumps the generation' "$sh" "$M" 'generation changed'
  M=$(tp send -t "$sh" 'echo reflow' --enter --print-marker)
  sleep 0.3
  T resize-window -t "$sh" -x 60 -y 24
  T resize-window -t "$sh" -x 80 -y 24
  inexact 'rg_m9 a reflow there and back' "$sh" "$M" 'generation changed'
  M=$(tp send -t "$sh" 'echo gen' --enter --print-marker)
  sleep 0.3
  bad=$(printf '%s\n' "$M" | awk -F: 'BEGIN { OFS = ":" } { split($25, c, "."); $25 = (c[1] + 999999) "." c[2]; print }')
  inexact 'rg_m10 a counter that ran backwards (or wrapped) is inexact' "$sh" "$bad"
  bad=$(printf '%s\n' "$M" | awk -F: 'BEGIN { OFS = ":" } { $19 = "1-1"; print }')
  inexact 'rg_m11 the echo sanity check on the counter path' "$sh" "$bad" 'echo moved'
  T set-option -g history-limit 2000
  killpane "$sh"
else
  skip 'rg_m9 rg_m10 rg_m11 the history counters arrived in 3.8' "$vstr"
fi

# --- wait --prompt --------------------------------------------------------------

sh=$(shellpane)
waitp() { # waitp NAME EXPECTED_EXIT COMMAND [ARGS...]
  local name=$1 want=$2 cmd=$3 res
  shift 3
  res=$(tp send -t "$sh" "$cmd" --enter --wait prompt "$@" 2>&1 >"$tmp/w.out")
  check "$name (exit)" "$want" "$?"
  printf '%s\n' "$res" >"$tmp/w.err"
}
waitp 'wait: a passing command' 0 'printf "ok\n"'
check_contains 'wait: the result line' 'result=done exact=yes status=0 marker=tp1:' "$(cat "$tmp/w.err")"
check 'wait: the shortcut prints the block' "$(printf '$ printf "ok\\n"\nok')" "$(cat "$tmp/w.out")"
waitp 'wait: false' 1 false
check_contains 'wait: false reports status=1' 'status=1' "$(cat "$tmp/w.err")"
waitp 'wait: exit 7' 7 '(exit 7)'
waitp 'rg_p14 a command exiting 124 keeps its status' 124 '(exit 124)'
check_contains 'rg_p14 and says status=124' 'status=124' "$(cat "$tmp/w.err")"
# A command's status in the tool's own range is still the command's.
for st in 64 65 66 67; do
  waitp "rg_i1 a command exiting $st" "$st" "(exit $st)"
  check_contains "rg_i1 a command exiting $st still prints the capture" "\$ (exit $st)" "$(cat "$tmp/w.out")"
  check_contains "rg_i1 and says result=done status=$st" "result=done exact=yes status=$st" "$(cat "$tmp/w.err")"
done
waitp 'rg_p2 glued ok[1] (exit)' 1 'printf ok; (exit 1)'
check 'rg_p2 glued output is the block output' "$(printf '$ printf ok; (exit 1)\nok')" "$(cat "$tmp/w.out")"
waitp 'rg_p3 glued 1.2.3' 0 'printf 1.2.3'
check 'rg_p3 1.2.3 splits from the prompt' "$(printf '$ printf 1.2.3\n1.2.3')" "$(cat "$tmp/w.out")"
waitp 'rg_p4 seq 30; printf ok does not hang' 0 'seq 30; printf ok' --timeout 10
waitp 'rg_p5 two glued outputs in a row (exit)' 0 'printf a; (exit 0)' --timeout 10
waitp 'rg_p5 two glued outputs in a row, second' 0 'printf b' --timeout 10
check_contains 'rg_p5 the identity came from the title' ':me@host:' "$(sed -n 's/.*marker=//p' "$tmp/w.err")"
waitp 'rg_p9 clear within the send second returns promptly' 0 "printf '\\033[H\\033[2J\\033[3J'" --timeout 6
start=$SECONDS
waitp 'rg_p14 sleep 5 with --timeout 1 is 124' 124 'sleep 5' --timeout 1
check 'rg_p14 the timeout came within 1-3 s' 1 "$([ $((SECONDS - start)) -le 4 ] && echo 1 || echo 0)"
check_contains 'rg_p14 a timeout says status=unknown' 'result=timeout exact=yes status=unknown' "$(cat "$tmp/w.err")"
M=$(sed -n 's/.*marker=//p' "$tmp/w.err")
res=$(tp wait -t "$sh" --prompt --since "$M" --timeout 10 2>&1 >/dev/null)
check 'rg_i4 resuming after 124 completes' 0 "$?"
check_contains 'rg_i4 the resumed result' 'result=done' "$res"
res=$(tp wait -t "$sh" --prompt 2>&1 >/dev/null)
check 'wait: without --since, a pane at its prompt returns at once' 0 "$?"
check_contains 'rg_i13 wait without --capture says exact=-' 'exact=-' "$res"
res=$(TMUX_PANE_DEBUG_DEADLINE=1 tp wait -t "$sh" --prompt 2>&1 >/dev/null)
check_contains 'rg_i3 the default deadline is 110 + 1' 'deadline=111' "$res"
# rg_p15: polls are small; the full parse runs once.
plog="$tmp/poll.log"
: >"$plog"
tps "$plog" send -t "$sh" 'sleep 1.5; echo slow' --enter --wait prompt >/dev/null 2>&1
# History-wide captures start at -S - or -S -10000; the polls' are small.
full=$(grep -c -- 'capture-pane .*-S \(- \|-10000\)' "$plog")
polls=$(grep -c 'list-panes' "$plog")
check 'rg_p15 a wait polls several times' 1 "$([ "$polls" -ge 5 ] && echo 1 || echo 0)"
check 'rg_p15 the shim saw the history-wide captures' 1 "$([ "$full" -ge 1 ] && echo 1 || echo 0)"
check 'rg_p15 but they do not grow with the polls (send, parse, read)' 1 "$([ "$full" -le 3 ] && echo 1 || echo 0)"
killpane "$sh"

# rg_p1: a line 1 wider than the pane.
sh=$(FAKE_W=30 FAKE_H=12 shellpane FAKE_LONG=1)
waitp 'rg_p1 a wrapped line 1 is still a prompt' 0 'true' --timeout 10
killpane "$sh"
# rg_p12: a # prompt.
sh=$(shellpane FAKE_ROOT=1)
waitp 'rg_p12 a # prompt' 0 'true' --timeout 10
killpane "$sh"
# rg_p11: an autosuggestion after the cursor.
sh=$(shellpane FAKE_SUGGEST=1)
waitp 'rg_p11 an autosuggestion after the cursor' 0 'true' --timeout 10
killpane "$sh"
# rg_p6: two glued outputs with no title: consensus, else the activity and
# steady-prompt rules; never a timeout.
sh=$(shellpane FAKE_TITLE=0)
tp send -t "$sh" 'true' --enter --wait prompt >/dev/null 2>&1
waitp 'rg_p6 glued twice without a title (first)' 0 'printf a' --timeout 10
waitp 'rg_p6 glued twice without a title (second)' 0 'printf b' --timeout 10
killpane "$sh"
# rg_p7: a title that the screen does not confirm is not the identity.
sh=$(shellpane FAKE_TITLE=0)
T select-pane -t "$sh" -T 'x@y: z'
M=$(tp send -t "$sh" 'true' --enter --print-marker)
check 'rg_p7 an unconfirmed title is not the identity' 'me@host' "$(printf '%s\n' "$M" | cut -d: -f20)"
killpane "$sh"
# rg_p8: clear rebuilds the marker's screen exactly.
sh=$(shellpane FAKE_TITLE=1)
T clear-history -t "$sh"
T send-keys -t "$sh" 'printf "\033[H\033[2J\033[3J"' Enter
sleep 0.5
T clear-history -t "$sh"
waitp 'rg_p8 a clear that rebuilds the screen ends (rule d)' 0 "printf '\\033[H\\033[2J\\033[3J'" --timeout 8
killpane "$sh"
# rg_p10: a line-1 redraw before the command runs does not end the wait.
# Send only after the first redraw: like zle, the fixture redraws while it
# waits at the prompt, and one landing after Enter would overwrite the echo.
sh=$(shellpane FAKE_REDRAW=1)
n=0
until T capture-pane -p -t "$sh" | grep -q '(main) +$' || [ "$n" -ge 50 ]; do
  n=$((n + 1))
  sleep 0.1
done
sleep 0.4
waitp 'rg_p10 an async redraw does not end the wait early' 0 'sleep 1; echo LATE' --timeout 10
check_contains 'rg_p10 the capture has the late output' LATE "$(cat "$tmp/w.out")"
killpane "$sh"
# rg_p13: the shell reads (and echoes) the input late; the old bare prompt
# must not end the wait.
sh=$(shellpane FAKE_NOECHO=1)
waitp 'rg_p13 a late echo does not end the wait early' 0 'echo LATEECHO' --timeout 10
check_contains 'rg_p13 the capture has the output' LATEECHO "$(cat "$tmp/w.out")"
killpane "$sh"
# rg_t9, rg_t10: the pane or the server going away mid-wait.
sh=$(shellpane)
(
  sleep 1
  T kill-pane -t "$sh"
) &
res=$(tp send -t "$sh" 'sleep 30' --enter --wait prompt 2>&1 >/dev/null)
check 'rg_t10 a pane killed mid-wait is 66' 66 "$?"
check_contains 'rg_t10 and reports result=gone' 'result=gone' "$res"
wait
T2 new-session -d -s c "env '$tmp/fakesh'"
sleep 0.5
(
  sleep 1
  T2 kill-server
) &
res=$(env -u TMUX -u TMUX_PANE "$BASH" "$TOOL" send -S "$s2" -t "$(T2 list-panes -t c -F '#{pane_id}')" 'sleep 30' --enter --wait prompt 2>&1 >/dev/null)
check 'rg_t9 a server killed mid-wait is 66' 66 "$?"
check_contains 'rg_t9 and reports result=gone' 'result=gone' "$res"
wait
# A restarted server that reuses the pane id is another pane: still 66.
T2 kill-server >/dev/null 2>&1
T2 new-session -d -s c "env '$tmp/fakesh'"
sleep 0.5
reused=$(T2 list-panes -t c -F '#{pane_id}')
(
  sleep 1
  T2 kill-server
  T2 new-session -d -s d "env '$tmp/fakesh'"
) &
res=$(env -u TMUX -u TMUX_PANE "$BASH" "$TOOL" send -S "$s2" -t "$reused" 'sleep 30' --enter --wait prompt --timeout 15 2>&1 >/dev/null)
check 'rg_t5 a restart mid-wait that reuses the pane id is 66' 66 "$?"
check_contains 'rg_t5 and reports result=gone' 'result=gone' "$res"
wait
T2 kill-server >/dev/null 2>&1
# A wait stopped by a signal still ends with a result line and its marker.
sh=$(shellpane)
env -u TMUX -u TMUX_PANE "$BASH" "$TOOL" send -S "$sock" -t "$sh" 'sleep 30' --enter --wait prompt \
  >/dev/null 2>"$tmp/sig.err" &
pid=$!
sleep 1.5
kill -TERM "$pid"
wait "$pid"
check 'wait: SIGTERM is 143' 143 "$?"
check_contains 'wait: and ends with a result line and the marker' 'result=error exact=- status=unknown marker=tp1:' \
  "$(tail -n 1 "$tmp/sig.err")"
T send-keys -t "$sh" C-c
killpane "$sh"
# Waits that fail before they start still end with a result= line.
res=$(tp wait -t %99 --prompt 2>&1 >/dev/null)
check 'wait: a missing pane is 65' 65 "$?"
check 'wait: and ends with result=error' 'result=error exact=- status=unknown' "$(printf '%s\n' "$res" | tail -n 1)"
res=$(tp send -t %99 'x' --enter --wait prompt 2>&1 >/dev/null)
check 'wait: the shortcut on a missing pane ends with result=error' 'result=error exact=- status=unknown' "$(printf '%s\n' "$res" | tail -n 1)"
sh=$(shellpane)
# Glued output that ends in [digits] is output, not a status.
waitp 'parser: glued array[2] is output, not status 2' 0 'printf "array[2]"' --timeout 10
check_contains 'parser: and stays in the capture' 'array[2]' "$(cat "$tmp/w.out")"
# Every tmux call passes -u: without it, a client outside a UTF-8 locale
# prints non-ASCII and control bytes in format output (the pane title, so
# the identity) as _. Captures are unaffected and a mangled title falls back
# to the history identity, so no output shows a missing -u; the calls do.
ulog="$tmp/u.log"
: >"$ulog"
tps "$ulog" send -t "$sh" 'echo u' --enter --wait prompt --timeout 10 >/dev/null 2>&1
tps "$ulog" read -t "$sh" --last-output >/dev/null 2>&1
check 'locale: every tmux call but -V passes -u' '' "$(grep -v -e '^-u ' -e '^-V $' "$ulog")"
check 'locale: and the log saw the calls' 1 "$([ "$(wc -l <"$ulog")" -ge 5 ] && echo 1 || echo 0)"
# Text that starts with a space is still exact.
waitp 'rg_m18 text with a leading space (exit)' 0 ' echo spaced' --timeout 10
check_contains 'rg_m18 text with a leading space is exact' 'exact=yes' "$(cat "$tmp/w.err")"
# The preset identity is the only one: another host's prompt does not end it.
waitp 'parser: a prompt with another identity does not end the wait' 0 \
  "printf 'x@other:/ (main)\\n\$ '; sleep 1.5; echo REAL" --timeout 10
check_contains 'parser: the wait ran to the real prompt' REAL "$(cat "$tmp/w.out")"
killpane "$sh"

# --- wait --agent ---------------------------------------------------------------

ag=$(agentpane)
sleep 0.3
waita() { # waita NAME EXPECTED_EXIT TEXT [ARGS...]
  local name=$1 want=$2 text=$3 res
  shift 3
  res=$(tp send -t "$ag" "$text" --enter --wait agent "$@" 2>&1 >"$tmp/a.out")
  check "$name (exit)" "$want" "$?"
  printf '%s\n' "$res" >"$tmp/a.err"
}
waita 'agent: a normal turn' 0 'hello'
check_contains 'agent: the reply is captured' 'REPLY hello' "$(cat "$tmp/a.out")"
check_contains 'agent: the result line' 'result=done exact=yes status=unknown marker=tp1:' "$(cat "$tmp/a.err")"
waita 'rg_a5 input that starts no turn is 70' 70 'ignore this' --start-timeout 1
check_contains 'rg_i2 exit 70 still prints the capture' 'ignore this' "$(cat "$tmp/a.out")"
check_contains 'rg_a5 and the marker' 'marker=tp1:' "$(cat "$tmp/a.err")"
waita 'rg_a6 a permission prompt is 68' 68 'ask now'
M=$(tp send -t "$ag" 'yes' --enter --print-marker)
res=$(tp wait -t "$ag" --agent --since "$M" --capture 2>&1 >"$tmp/a.out")
check 'rg_a6 resuming after the answer is 0' 0 "$?"
check_contains 'rg_a6 the resumed capture has the reply' 'REPLY ask now' "$(cat "$tmp/a.out")"
waita 'agent: a dead turn is 69' 69 'die now'
T set-option -p -t "$ag" @term_notify_pending "done"
waita 'rg_a1 a fast turn while done is already set' 0 'fast' --start-timeout 3
killpane "$ag"
ag=$(agentpane AGENT_SLEEP=0.05)
sleep 0.3
T set-option -p -t "$ag" @term_notify_pending "done"
waita 'rg_a1 a 50 ms turn with done set counts through seq' 0 'quick' --start-timeout 3
killpane "$ag"
ag=$(agentpane)
sleep 0.3
T set-option -p -t "$ag" @term_notify_pending waiting
waita 'rg_a2 a baseline waiting that persists is not 68' 0 'nodone please'
T set-option -pu -t "$ag" @term_notify_pending
waita 'rg_a3 a glance that clears done' 0 'glance here'
start=$SECONDS
waita 'rg_a4 a second turn inside the settle window' 0 'double up'
check 'rg_a4 the wait outlasted the second turn' 1 "$([ $((SECONDS - start)) -ge 2 ] && echo 1 || echo 0)"
check_contains 'rg_a4 the capture has the second reply' SECOND "$(cat "$tmp/a.out")"
killpane "$ag"
ag=$(agentpane AGENT_SLEEP=3)
sleep 0.3
res=$(tp send -t "$ag" 'slow turn' --enter --wait agent --timeout 1 2>&1 >/dev/null)
check 'agent: a turn longer than --timeout is 124' 124 "$?"
check_contains 'agent: a timeout says result=timeout' 'result=timeout' "$res"
M=$(printf '%s\n' "$res" | sed -n 's/.*marker=//p')
res=$(tp wait -t "$ag" --agent --since "$M" --capture 2>&1 >"$tmp/a.out")
check 'rg_i4 an agent wait resumes after 124' 0 "$?"
check_contains 'rg_i4 the resumed capture has the reply' 'REPLY slow turn' "$(cat "$tmp/a.out")"
killpane "$ag"
# rg_a7: an older term-pane-mark without the seq counter: the done fallback.
old_mark="$tmp/old-term-pane-mark"
sed '/^  seq_bump=/,/^    .#{e|+:/d; s/ "\${seq_bump\[@\]}"//' "$ROOT/bin/term-pane-mark" >"$old_mark"
chmod +x "$old_mark"
ag=$(agentpane MARK="$old_mark")
sleep 0.3
waita 'rg_a7 without seq, a new done finishes the wait' 0 'legacy'
check 'rg_a7 the old marker sets no seq' '' "$(T show -pqv -t "$ag" @term_busy_seq)"
killpane "$ag"
# term-pane-mark's older pending value 1 means done: as a new value it ends
# the wait; as the baseline it is an earlier turn's.
lp=$(newpane 'sleep 100')
M=$(tp mark -t "$lp")
T set-option -p -t "$lp" @term_notify_pending 1
res=$(tp wait -t "$lp" --agent --since "$M" --timeout 5 2>&1 >/dev/null)
check 'rg_a7 a legacy pending 1 finishes the wait' 0 "$?"
check_contains 'rg_a7 as done' 'result=done' "$res"
M=$(tp mark -t "$lp")
tp wait -t "$lp" --agent --since "$M" --start-timeout 1 --timeout 5 >/dev/null 2>&1
check 'rg_a7 a legacy pending 1 at the baseline does not' 70 "$?"
killpane "$lp"

# rg_i10, rg_i11, rg_i12: exactness is reported, never the exit code.
tui=$(newpane "env MOVE=1 '$tmp/tui'")
sleep 0.3
res=$(tp send -t "$tui" 'hi' --enter --wait prompt --timeout 2 2>&1 >/dev/null)
rc=$?
check_contains 'rg_i10 an inexact shortcut capture says exact=no' 'exact=no' "$res"
check 'rg_i10 and exits with the wait result (124), never 4' 124 "$rc"
killpane "$tui"
sh=$(shellpane)
res=$(tp send -t "$sh" 'true' --enter --wait prompt 2>&1 >/dev/null)
check_contains 'rg_i11 an exact capture says exact=yes' 'exact=yes status=0' "$res"
check_absent 'rg_i11 with no reason' 'reason=' "$res"
M=$(tp send -t "$sh" 'true' --enter --print-marker)
sleep 0.3
T resize-window -t "$sh" -x 70 -y 24
tp read -t "$sh" --since "$M" >/dev/null 2>&1
check 'rg_i12 a standalone inexact read --since is 4' 4 "$?"
res=$(tp wait -t "$sh" --prompt --since "$M" --capture 2>&1 >/dev/null)
check 'rg_i10 an inexact wait --capture exits with the wait result' 0 "$?"
check_contains 'rg_i10 and reports exact=no with a reason' 'exact=no' "$res"
killpane "$sh"

# B2: an inexact or unfinished prompt-mode capture still prints something,
# and exact= describes what it printed. A resize makes a marker inexact.
inexact_after() { # inexact_after PANE COMMAND: print a marker for COMMAND, then resize
  local m
  m=$(tp send -t "$1" "$2" --enter --print-marker)
  tp wait -t "$1" --prompt --since "$m" >/dev/null 2>&1
  # A width the marker did not see.
  if [ "$(T display -p -t "$1" '#{pane_width}')" = 70 ]; then
    T resize-window -t "$1" -x 75 -y 24
  else
    T resize-window -t "$1" -x 70 -y 24
  fi
  printf '%s\n' "$m"
}
sh=$(shellpane)
M=$(inexact_after "$sh" 'seq 60')
out=$(tp read -t "$sh" --since "$M" --last-output 2>/dev/null)
check 'B2 an inexact --last-output longer than the screen is 4' 4 "$?"
check_contains 'B2 and prints the screen' "$(printf '59\n60')" "$out"
res=$(tp wait -t "$sh" --prompt --since "$M" --capture 2>&1 >"$tmp/w.out")
check_contains 'B2 an inexact long wait capture says exact=no' 'exact=no' "$res"
check_contains 'B2 and prints the screen' 60 "$(cat "$tmp/w.out")"
tp wait -t "$sh" --prompt --since "$M" --capture --lines 3 >"$tmp/w.out" 2>/dev/null
check 'B2 --lines bounds a prompt-mode capture' 3 "$(wc -l <"$tmp/w.out" | tr -d ' ')"
M=$(inexact_after "$sh" 'echo AAA')
tp send -t "$sh" 'echo BBB' --enter --wait prompt >/dev/null 2>&1
out=$(tp read -t "$sh" --since "$M" --last-output 2>/dev/null)
check 'B2 an inexact --last-output with several blocks is 4' 4 "$?"
check_contains 'B2 and prints the first block' '$ echo AAA' "$out"
check_contains 'B2 and the last' '$ echo BBB' "$out"
res=$(tp send -t "$sh" 'sleep 3' --enter --wait prompt --timeout 1 2>&1 >"$tmp/w.out")
check 'B2 a 124 wait (exit)' 124 "$?"
check_contains 'B2 a 124 capture prints the range since the marker' '$ sleep 3' "$(cat "$tmp/w.out")"
check_contains 'B2 and it is exact' 'exact=yes' "$res"
killpane "$sh"

# rg_i6: the suite runs the tool with its own "$BASH", never the shebang's
# bash from PATH (on macOS that would be a newer brew bash, not 3.2).
mkdir -p "$tmp/nobash"
printf '#!/bin/sh\nexit 97\n' >"$tmp/nobash/bash"
chmod +x "$tmp/nobash/bash"
out=$(env -u TMUX -u TMUX_PANE PATH="$tmp/nobash:$PATH" "$BASH" "$TOOL" mark -S "$sock" -t "$decoy")
check 'rg_i6 the tool runs under the suite bash, not PATH bash' 0 "$?"
check_contains 'rg_i6 and works there' 'tp1:' "$out"
check 'rg_i6 PATH bash would have failed' 97 "$(
  PATH="$tmp/nobash:$PATH" bash -c true 2>/dev/null
  echo $?
)"

printf '%s passed, %s failed\n' "$passes" "$failures"
exit "$((failures != 0))"
