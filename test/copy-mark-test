# With --owner, only the pane terminal's foreground program may change the
# mark: an agent the pane's agent launches inherits the pane but runs without
# its terminal. /proc supplies pgrp, tty_nr, and tpgid; pts/9 is 34825.
owner_root="$tmp/owner-proc"
mkdir -p "$owner_root/self"
printf '1 (test) S 1 1 1 0 -1 0\n' >"$owner_root/self/stat"
write_owner() { # write_owner PID PGRP TTY_NR TPGID
  mkdir -p "$owner_root/$1"
  printf '%s (agent (x)) S 1 %s %s %s %s 0\n' "$1" "$2" "$2" "$3" "$4" \
    >"$owner_root/$1/stat"
}
write_owner 4242 4242 34825 4242 # foreground of pts/9
write_owner 4243 4243 34825 4300 # background group on pts/9
write_owner 4244 4244 0 -1       # no terminal: a nested agent
write_owner 4245 4245 34826 4245 # foreground of another pty, pts/10
owner_index=0
# assert_owned DESCRIPTION EXPECTED-LOG ARGS... runs with PS_STATE set, so a
# result that ignored /proc would show.
assert_owned() {
  local description=$1 expected=$2 log
  shift 2
  owner_index=$((owner_index + 1))
  log="$tmp/mark-owner-$owner_index.log"
  TMUX=/tmp/tmux-test TMUX_PANE=%40 TERM_PROGRAM=tmux TMUX_SET_LOG="$log" \
    TMUX_PANE_TTY=/dev/pts/9 TERM_PANE_MARK_PROC_ROOT="$owner_root" \
    PS_STATE='4246 4246 pts/9' PATH="$mock_bin:$PATH" \
    "$ROOT/bin/term-pane-mark" "$@"
  _assert_exit "mark owner: $description succeeds" 0 "$?"
  if [[ -n $expected ]]; then
    _assert_file_content "mark owner: $description" "$expected" "$log"
  else
    _assert_file_missing "mark owner: $description" "$log"
  fi
}
assert_owned "a background owner cannot publish failure metadata" '' \
  set pending --exit-status 42 --owner 4243
assert_owned "a foreground owner publishes failure metadata first" \
  'set-option -p -t %40 @term_notify_exit_status 42 ; set-option -p -t %40 @term_notify_pending 1' \
  set pending --owner 4242 --exit-status 42

assert_owned "the foreground program sets the mark" \
  'set-option -p -t %40 @term_busy 1' set busy --owner 4242
assert_owned "the foreground program clears the mark" \
  'set-option -pu -t %40 @term_busy' clear busy --owner 4242
assert_owned "a background process group cannot set it" '' set busy --owner 4243
assert_owned "a process without a terminal cannot set it" '' set busy --owner 4244
assert_owned "a process without a terminal cannot clear it" '' clear busy --owner 4244
assert_owned "another terminal's foreground cannot set it" '' set busy --owner 4245
assert_owned "an exited process is not asked about through ps" '' \
  set busy --owner 4246
assert_owned "options combine with an explicit pane" \
  'set-option -p -t %41 @term_busy 1' set busy --owner 4242 --pane %41

# Without /proc, ps reports the process group, foreground group, and terminal.
for case in '4242 4242 pts/9:set-option -p -t %40 @term_busy 1:foreground' \
  '4242 4300 pts/9::background' '4242 4242 pts/10::another terminal' \
