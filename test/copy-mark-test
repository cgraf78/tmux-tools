# Linux reports the controlling terminal in /proc as a device number, so the
# lookup needs no ps. Unix98 ptys use majors 136-143 and extended minor bits.
proc_root="$tmp/proc"
mkdir -p "$proc_root/self"
proc_panes=$'/dev/pts/5 %5\n/dev/pts/257 %257\n/dev/pts/300 %300\n/dev/pts/7 %7'
for case in '34821:%5:pts/5' '35073:%257:pts/257 (major 137)' \
  '1083436:%300:pts/300 (extended minor)'; do
  tty_nr=${case%%:*}
  expected=${case#*:}
  expected=${expected%%:*}
  printf '123 (agent (x) y) S 1 123 123 %s 123 0\n' "$tty_nr" >"$proc_root/self/stat"
  proc_log="$tmp/mark-proc-$tty_nr.log"
  env -u TMUX -u TMUX_PANE -u TERM_PROGRAM -u PS_TTY \
    TERM_PANE_MARK_PROC_ROOT="$proc_root" TMUX_SET_LOG="$proc_log" \
    TMUX_PANES="$proc_panes" PATH="$mock_bin:$PATH" \
    "$ROOT/bin/term-pane-mark" set busy
  _assert_file_content "mark: /proc resolves ${case##*:} without ps" \
    "set-option -p -t $expected @term_busy 1" "$proc_log"
done

# No controlling terminal in /proc is final: ps is not asked.
printf '123 (agent) S 1 123 123 0 -1 0\n' >"$proc_root/self/stat"
env -u TMUX -u TMUX_PANE -u TERM_PROGRAM TERM_PANE_MARK_PROC_ROOT="$proc_root" \
  TMUX_SET_LOG="$tmp/mark-proc-none.log" PS_TTY=pts/5 \
  TMUX_PANES="$proc_panes" PATH="$mock_bin:$PATH" \
  "$ROOT/bin/term-pane-mark" set busy
_assert_file_missing "mark: /proc without a terminal marks nothing" \
  "$tmp/mark-proc-none.log"

# A terminal that is not a pty (a virtual console) falls back to ps.
printf '123 (agent) S 1 123 123 1025 123 0\n' >"$proc_root/self/stat"
env -u TMUX -u TMUX_PANE -u TERM_PROGRAM TERM_PANE_MARK_PROC_ROOT="$proc_root" \
  TMUX_SET_LOG="$tmp/mark-proc-console.log" PS_TTY=pts/7 \
  TMUX_PANES="$proc_panes" PATH="$mock_bin:$PATH" \
  "$ROOT/bin/term-pane-mark" set busy
_assert_file_content "mark: a non-pty /proc terminal falls back to ps" \
  'set-option -p -t %7 @term_busy 1' "$tmp/mark-proc-console.log"

