    TMUX_PANE_TTY=/dev/pts/9 PS_STATE="$state" PATH="$mock_bin:$PATH" \
    "$ROOT/bin/term-pane-mark" set busy --owner 4242
  if [[ -n $expected ]]; then
    _assert_file_content "mark owner via ps: ${case##*:} sets the mark" "$expected" "$log"
  else
