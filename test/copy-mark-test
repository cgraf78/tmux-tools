# Each log line is one tmux invocation, so queue separators catch a split
# metadata/pending update that focus acknowledgement could interleave.
# Exit status belongs only to a newly pending notification. Leading zeroes
# remain decimal and are canonicalized before reaching tmux.
for code in 0 255 008; do
  case $code in
    0) metadata='set-option -pu -t %31 @term_notify_exit_status' ;;
    255) metadata='set-option -p -t %31 @term_notify_exit_status 255' ;;
    008) metadata='set-option -p -t %31 @term_notify_exit_status 8' ;;
  esac
  log="$tmp/status-$code.log"
  TMUX_SET_LOG="$log" PATH="$mock_bin:$PATH" \
    "$ROOT/bin/term-pane-mark" set pending --exit-status "$code" --pane %31
  _assert_exit "mark status $code: valid decimal status succeeds" 0 "$?"
  _assert_file_content "mark status $code: queues metadata before pending in one tmux invocation" \
    "$metadata ; set-option -p -t %31 @term_notify_pending 1" "$log"
done

