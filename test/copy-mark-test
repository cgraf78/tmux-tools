  'if-shell -F -t %40 #{==:#{@term_notify_pending},waiting} set-option -pu -t %40 @term_notify_pending ; set-option -pu -t %40 @term_notify_exit_status ' \
  clear pending --if waiting --owner 4242

# Without /proc, ps reports the process group, foreground group, and terminal.
for case in '4242 4242 pts/9=set-option -pu -t %40 @term_busy_token ; set-option -p -t %40 @term_busy 1 ; set-option -pF -t %40 @term_busy_seq #{e|+:#{?@term_busy_seq,#{@term_busy_seq},0},1}=foreground' \
  '4242 4300 pts/9==background' '4242 4242 pts/10==another terminal' \
  '4242 4242 ?==no terminal'; do
  # = separates the fields: the expected queue contains colons.
  state=${case%%=*}
  rest=${case#*=}
  expected=${rest%%=*}
  log="$tmp/mark-owner-ps-${case##*=}.log"
  TMUX=/tmp/tmux-test TMUX_PANE=%40 TERM_PROGRAM=tmux TMUX_SET_LOG="$log" \
    TMUX_PANE_TTY=/dev/pts/9 PS_STATE="$state" PATH="$mock_bin:$PATH" \
    "$ROOT/bin/term-pane-mark" set busy --owner 4242
  if [[ -n $expected ]]; then
    _assert_file_content "mark owner via ps: ${case##*=} sets the mark" "$expected" "$log"
  else
    _assert_file_missing "mark owner via ps: ${case##*=} cannot set it" "$log"
  fi
done

# Linux reports the controlling terminal in /proc as a device number, so the
# lookup needs no ps. Unix98 ptys use majors 136-143 and extended minor bits.
proc_root="$tmp/proc"
mkdir -p "$proc_root/self"
proc_panes=$'/dev/pts/5 %5\n/dev/pts/257 %257\n/dev/pts/300 %300\n/dev/pts/7 %7'
for case in '34821:%5:pts/5' '35073:%257:pts/257 (major 137)' \
  '1083436:%300:pts/300 (extended minor)'; do
  tty_nr=${case%%:*}
  expected=${case#*:}
  expected=${expected%%:*}
  printf '123 (agent (x) y) S 1 123 123 %s 123 0\n' "$tty_nr" >"$proc_root/self/stat"
  proc_log="$tmp/mark-proc-$tty_nr.log"
  env -u TMUX -u TMUX_PANE -u TERM_PROGRAM -u PS_TTY \
    TERM_PANE_MARK_PROC_ROOT="$proc_root" TMUX_SET_LOG="$proc_log" \
    TMUX_PANES="$proc_panes" PATH="$mock_bin:$PATH" \
    "$ROOT/bin/term-pane-mark" set busy
  _assert_file_content "mark: /proc resolves ${case##*:} without ps" \
    "set-option -pu -t $expected @term_busy_token ; set-option -p -t $expected @term_busy 1 ; set-option -pF -t $expected @term_busy_seq #{e|+:#{?@term_busy_seq,#{@term_busy_seq},0},1}" "$proc_log"
done

# No controlling terminal in /proc is final: ps is not asked.
printf '123 (agent) S 1 123 123 0 -1 0\n' >"$proc_root/self/stat"
env -u TMUX -u TMUX_PANE -u TERM_PROGRAM TERM_PANE_MARK_PROC_ROOT="$proc_root" \
  TMUX_SET_LOG="$tmp/mark-proc-none.log" PS_TTY=pts/5 \
  TMUX_PANES="$proc_panes" PATH="$mock_bin:$PATH" \
  "$ROOT/bin/term-pane-mark" set busy
_assert_file_missing "mark: /proc without a terminal marks nothing" \
  "$tmp/mark-proc-none.log"

# A terminal that is not a pty (a virtual console) falls back to ps.
printf '123 (agent) S 1 123 123 1025 123 0\n' >"$proc_root/self/stat"
env -u TMUX -u TMUX_PANE -u TERM_PROGRAM TERM_PANE_MARK_PROC_ROOT="$proc_root" \
  TMUX_SET_LOG="$tmp/mark-proc-console.log" PS_TTY=pts/7 \
  TMUX_PANES="$proc_panes" PATH="$mock_bin:$PATH" \
  "$ROOT/bin/term-pane-mark" set busy
_assert_file_content "mark: a non-pty /proc terminal falls back to ps" \
  'set-option -pu -t %7 @term_busy_token ; set-option -p -t %7 @term_busy 1 ; set-option -pF -t %7 @term_busy_seq #{e|+:#{?@term_busy_seq,#{@term_busy_seq},0},1}' "$tmp/mark-proc-console.log"

_test_summary
