#!/usr/bin/env bash
# Behavioral tests for terminal command-block helpers.

set -o pipefail
export NO_COLOR=1
# Fixture children must not source the live shell policy and re-add host
# clipboard tools after this suite has deliberately restricted PATH.
unset BASH_ENV ENV

TEST_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
ROOT="$(cd -- "$TEST_DIR/.." && pwd -P)"
# The floor and a release just below it, from the tools' own tmux_minimum,
# so these cases follow a floor bump.
floor_tmux=$(sed -n 's/^tmux_minimum=//p' "$ROOT/bin/tmux-agent-picker")
older_tmux=${floor_tmux%%.*}.$((${floor_tmux#*.} - 1))a
# The mocks report the floor itself unless a case says otherwise.
export floor_tmux

# shellcheck source=copy-mark-helpers.sh
. "$TEST_DIR/copy-mark-helpers.sh"
# shellcheck source=test/fixture-env.sh
. "$TEST_DIR/fixture-env.sh"

echo "=== tmux-copy-last-output ==="

tmp=$(_tmpdir)
tmux_fixture_path "$tmp" || exit "$?"
mock_bin="$tmp/bin"
mkdir -p "$mock_bin"
# Pane lookups read the controlling terminal from /proc on Linux. Point that at
# a missing root so the ps mock below decides, except where a test supplies
# its own stat file.
export TERM_PANE_MARK_PROC_ROOT="$tmp/no-proc"

cat >"$mock_bin/tmux" <<'EOF'
#!/usr/bin/env bash
if [[ -n "${TMUX_CALL_LOG:-}" ]]; then
  printf '%s\n' "$*" >>"$TMUX_CALL_LOG"
fi
# One command, or the version query followed by \; and the next command.
if [[ "${1:-}" == display-message && "${2:-}" == "-p" && "${3:-}" == "#{version}" ]]; then
  printf '%s\n' "${TMUX_TEST_VERSION-$floor_tmux}"
  [[ "${4:-}" == ';' ]] || exit 0
  shift 4
fi
case "$1" in
  capture-pane)
    cat "$TMUX_CAPTURE_FILE"
    ;;
  display-message)
    # tmux drops a message for a client that has gone, silently.
    if [[ -n "${TMUX_TEST_CLIENT_GONE:-}" && " $* " == *' -c '* ]]; then
      exit 0
    elif [[ "${2:-}" == "-p" && "${3:-}" == "#{client_tty}" ]]; then
      printf '%s\n' "${TMUX_CLIENT_TTY:-}"
    else
      printf '%s\n' "$*" >>"$TMUX_MESSAGE_LOG"
    fi
    ;;
  # A client of another session is attached too, and listed first.
  list-clients)
    printf '/dev/ttys009\n%s\n' "${TMUX_TEST_CLIENT_NAME:-/dev/ttys007}"
    ;;
  load-buffer)
    cat >"$PBCOPY_OUT"
    ;;
  *)
    exit 1
    ;;
esac
EOF
cat >"$mock_bin/pbcopy" <<'EOF'
#!/usr/bin/env bash
if [[ -n "${PBCOPY_CALL_LOG:-}" ]]; then
  printf 'pbcopy\n' >>"$PBCOPY_CALL_LOG"
fi
cat >"$PBCOPY_OUT"
EOF
chmod +x "$mock_bin/tmux" "$mock_bin/pbcopy"

# Deliberate copies use clip's shared transport/history policy when present.
# Keep that dependency mocked so no suite can write the host clipboard/history.
cat >"$mock_bin/clip" <<'EOF'
#!/usr/bin/env bash
[[ -z ${CLIP_CALL_LOG:-} ]] || printf '%s\n' "$*" >>"$CLIP_CALL_LOG"
cat >"$PBCOPY_OUT"
[[ -z ${CLIP_TEST_NOTE:-} ]] || printf '%s\n' "$CLIP_TEST_NOTE" >&2
EOF
chmod +x "$mock_bin/clip"

cat >"$tmp/pane.txt" <<'EOF'
user@test:/repo (main)
$ echo one
one output
user@test:/repo (main)
$ echo two
two output
user@test:/repo (main)
$
EOF

TMUX_CAPTURE_FILE="$tmp/pane.txt" \
  TMUX_MESSAGE_LOG="$tmp/messages.log" \
  PBCOPY_OUT="$tmp/copied-one.txt" \
  PATH="$mock_bin:$PATH" \
  "$ROOT/bin/tmux-copy-last-output"
_assert_file_content "copy last output: copies command and output" \
  '$ echo two
two output' "$tmp/copied-one.txt"
_assert_contains "copy last output: reports single block" \
  "Copied last command + output to clipboard" "$(cat "$tmp/messages.log")"

# A 10,000-line window: long output keeps its own prompt in range, while the
# payload stays bounded.
TMUX_CAPTURE_FILE="$tmp/pane.txt" \
  TMUX_MESSAGE_LOG="$tmp/messages-history.log" \
  TMUX_CALL_LOG="$tmp/history-calls.log" \
  PBCOPY_OUT="$tmp/copied-history.txt" \
  PATH="$mock_bin:$PATH" \
  "$ROOT/bin/tmux-copy-last-output"
_assert_eq "copy last output: captures the last 10,000 lines" \
  "display-message -p #{version} ; capture-pane -p -S -10000" \
  "$(grep 'capture-pane' "$tmp/history-calls.log")"
# The version rides the capture: one call to read the pane, then the
# message, as before the version check.
_assert_eq "copy last output: makes two tmux calls" 2 \
  "$(wc -l <"$tmp/history-calls.log" | tr -d ' ')"

TMUX_CAPTURE_FILE="$tmp/pane.txt" \
  TMUX_MESSAGE_LOG="$tmp/messages-one.log" \
  PBCOPY_OUT="$tmp/copied-explicit-one.txt" \
  PATH="$mock_bin:$PATH" \
  "$ROOT/bin/tmux-copy-last-output" 1
_assert_file_content "copy explicit one: copies one command and output" \
  '$ echo two
two output' "$tmp/copied-explicit-one.txt"
_assert_contains "copy explicit one: reports single block" \
  "Copied last command + output to clipboard" "$(cat "$tmp/messages-one.log")"

TMUX_CAPTURE_FILE="$tmp/pane.txt" \
  TMUX_MESSAGE_LOG="$tmp/messages-two.log" \
  PBCOPY_OUT="$tmp/copied-two.txt" \
  PATH="$mock_bin:$PATH" \
  "$ROOT/bin/tmux-copy-last-output" 2
_assert_file_content "copy two outputs: preserves block separator" \
  '$ echo one
one output

$ echo two
two output' "$tmp/copied-two.txt"
_assert_contains "copy two outputs: reports requested count" \
  "Copied last 2 commands + output to clipboard" "$(cat "$tmp/messages-two.log")"

TMUX_CAPTURE_FILE="$tmp/pane.txt" \
  TMUX_MESSAGE_LOG="$tmp/messages-leading-zero.log" \
  PBCOPY_OUT="$tmp/copied-leading-zero.txt" \
  PATH="$mock_bin:$PATH" \
  "$ROOT/bin/tmux-copy-last-output" 0002
_assert_file_content "copy leading-zero count: preserves selected blocks" \
  '$ echo one
one output

$ echo two
two output' "$tmp/copied-leading-zero.txt"
_assert_contains "copy leading-zero count: reports normalized count" \
  "Copied last 2 commands + output to clipboard" \
  "$(cat "$tmp/messages-leading-zero.log")"

huge_count=999999999999999999999999999999999999999999999999999999999999
TMUX_CAPTURE_FILE="$tmp/pane.txt" \
  TMUX_MESSAGE_LOG="$tmp/messages-huge.log" \
  PBCOPY_OUT="$tmp/copied-huge.txt" \
  PATH="$mock_bin:$PATH" \
  "$ROOT/bin/tmux-copy-last-output" "$huge_count"
_assert_file_content "copy huge count: clamps to available blocks" \
  '$ echo one
one output

$ echo two
two output' "$tmp/copied-huge.txt"
_assert_contains "copy huge count: avoids arithmetic overflow" \
  "Copied last $huge_count commands + output to clipboard" \
  "$(cat "$tmp/messages-huge.log")"

invalid_index=0
assert_invalid_count() {
  local description="$1"
  shift
  invalid_index=$((invalid_index + 1))

  local tmux_log="$tmp/invalid-$invalid_index-tmux.log"
  local pbcopy_log="$tmp/invalid-$invalid_index-pbcopy.log"
  local output rc
  output=$(TMUX_CALL_LOG="$tmux_log" \
    PBCOPY_CALL_LOG="$pbcopy_log" \
    TMUX_CAPTURE_FILE="$tmp/pane.txt" \
    TMUX_MESSAGE_LOG="$tmp/invalid-$invalid_index-message.log" \
    PBCOPY_OUT="$tmp/invalid-$invalid_index-copy.txt" \
    PATH="$mock_bin:$PATH" \
    "$ROOT/bin/tmux-copy-last-output" "$@" 2>&1)
  rc=$?

  _assert_exit "$description: exits with usage status" 64 "$rc"
  _assert_eq "$description: prints concise usage" \
    "usage: tmux-copy-last-output [--print] [--pane PANE] [--client CLIENT] [positive-count]" "$output"
  _assert_file_missing "$description: does not invoke tmux" "$tmux_log"
  _assert_file_missing "$description: does not invoke clipboard" "$pbcopy_log"
}

assert_invalid_count "copy zero count" 0
assert_invalid_count "copy negative count" -1
assert_invalid_count "copy nonnumeric count" two
assert_invalid_count "copy empty count" ""
assert_invalid_count "copy extra arguments" 1 2
assert_invalid_count "print zero count" --print 0
assert_invalid_count "print extra arguments" --print 1 2
assert_invalid_count "print flag after count" 1 --print
assert_invalid_count "print flag repeated" --print --print
assert_invalid_count "copy invalid pane" --pane not-a-pane
assert_invalid_count "copy client without pane" --client /dev/ttys007

cat >"$tmp/no-command.txt" <<'EOF'
plain output only
EOF
TMUX_CAPTURE_FILE="$tmp/no-command.txt" \
  TMUX_MESSAGE_LOG="$tmp/no-command-message.log" \
  PBCOPY_OUT="$tmp/no-command-copy.txt" \
  PATH="$mock_bin:$PATH" \
  "$ROOT/bin/tmux-copy-last-output"
_assert_file_missing "copy no output: does not write clipboard" "$tmp/no-command-copy.txt"
_assert_contains "copy no output: reports missing block" \
  "No command output found" "$(cat "$tmp/no-command-message.log")"

# --print hands the blocks to the caller instead of the clipboard.
printed=$(TMUX_CAPTURE_FILE="$tmp/pane.txt" \
  TMUX_MESSAGE_LOG="$tmp/print-message.log" \
  PBCOPY_CALL_LOG="$tmp/print-pbcopy.log" \
  PBCOPY_OUT="$tmp/print-copy.txt" \
  PATH="$mock_bin:$PATH" \
  "$ROOT/bin/tmux-copy-last-output" --print)
_assert_exit "print: succeeds" 0 "$?"
_assert_eq "print: writes the last block to stdout" \
  '$ echo two
two output' "$printed"
_assert_file_missing "print: does not invoke the clipboard" "$tmp/print-pbcopy.log"
_assert_file_missing "print: reports nothing through tmux" "$tmp/print-message.log"

TMUX_CAPTURE_FILE="$tmp/pane.txt" TMUX_MESSAGE_LOG="$tmp/scoped-message.log" \
  TMUX_CALL_LOG="$tmp/scoped-tmux.log" CLIP_CALL_LOG="$tmp/scoped-clip.log" \
  PBCOPY_OUT="$tmp/scoped-copied" PATH="$mock_bin:$PATH" \
  "$ROOT/bin/tmux-copy-last-output" --pane %7 --client /dev/ttys007
_assert_exit "copy scoped: accepts explicit pane and client" 0 "$?"
_assert_file_content "copy scoped: uses shared clipboard policy" \
  'copy --client /dev/ttys007 --pane %7' "$tmp/scoped-clip.log"
_assert_contains "copy scoped: captures only the initiating pane" \
  'capture-pane -p -S -10000 -t %7' "$(cat "$tmp/scoped-tmux.log")"
_assert_file_content "copy scoped: retains command-block content" \
  '$ echo two
two output' "$tmp/scoped-copied"
_assert_contains "copy scoped: tells the pressing client" \
  '-c /dev/ttys007 -t %7 Copied last command' "$(cat "$tmp/scoped-message.log")"
_assert_not_contains "copy scoped: a quiet clip adds nothing to the message" \
  'clipboard (' "$(cat "$tmp/scoped-message.log")"
# clip may copy and still report something; the Copied message keeps it.
TMUX_CAPTURE_FILE="$tmp/pane.txt" TMUX_MESSAGE_LOG="$tmp/noted-message.log" \
  CLIP_TEST_NOTE='clip: history must be a private directory
clip: history unavailable; copied without recording it' \
  PBCOPY_OUT="$tmp/noted-copied" PATH="$mock_bin:$PATH" \
  "$ROOT/bin/tmux-copy-last-output" --pane %7 --client /dev/ttys007
_assert_exit "copy noted: succeeds" 0 "$?"
_assert_contains "copy noted: the Copied message carries clip's notices, one per clause" \
  'Copied last command + output to clipboard (clip: history must be a private directory; clip: history unavailable; copied without recording it)' \
  "$(cat "$tmp/noted-message.log")"

# An older server is refused before its capture is used, and the client is
# told why.
TMUX_CAPTURE_FILE="$tmp/pane.txt" TMUX_MESSAGE_LOG="$tmp/old-message.log" \
  TMUX_CALL_LOG="$tmp/old-tmux.log" TMUX_TEST_VERSION=$older_tmux \
  PBCOPY_OUT="$tmp/old-copied" PATH="$mock_bin:$PATH" \
  "$ROOT/bin/tmux-copy-last-output" --pane %7 --client /dev/ttys007 2>"$tmp/old.err"
_assert_exit "copy on an older tmux: fails" 1 "$?"
_assert_file_content "copy on an older tmux: tells the pressing client" \
  "display-message -c /dev/ttys007 -t %7 tmux-copy-last-output: needs tmux $floor_tmux or newer (server is $older_tmux)" \
  "$tmp/old-message.log"
_assert_file_content "copy on an older tmux: says so on stderr" \
  "tmux-copy-last-output: needs tmux $floor_tmux or newer (server is $older_tmux)" "$tmp/old.err"
_assert_eq "copy on an older tmux: asks once, then tells the client" 2 \
  "$(wc -l <"$tmp/old-tmux.log" | tr -d ' ')"
_assert_file_missing "copy on an older tmux: copies nothing" "$tmp/old-copied"
for version in master ''; do
  rm -f "$tmp/new-copied"
  TMUX_CAPTURE_FILE="$tmp/pane.txt" TMUX_MESSAGE_LOG="$tmp/new-message.log" \
    TMUX_TEST_VERSION=$version PBCOPY_OUT="$tmp/new-copied" PATH="$mock_bin:$PATH" \
    "$ROOT/bin/tmux-copy-last-output" --pane %7 --client /dev/ttys007
  _assert_exit "copy on tmux '$version': succeeds" 0 "$?"
done

# Restrict PATH so the installed host clip/native clipboard cannot win this
# standalone test. The tmux stub records transport, never a real user server.
standalone_bin="$tmp/standalone-bin"
mkdir -p "$standalone_bin"
for tool in bash cat awk; do
  ln -s "$(command -v "$tool")" "$standalone_bin/$tool"
done
ln -s "$mock_bin/tmux" "$standalone_bin/tmux"
TMUX_CAPTURE_FILE="$tmp/pane.txt" TMUX_MESSAGE_LOG="$tmp/standalone-message.log" \
  TMUX_CALL_LOG="$tmp/standalone-tmux.log" \
  PBCOPY_OUT="$tmp/standalone-copied" PATH="$standalone_bin" \
  "$ROOT/bin/tmux-copy-last-output" --pane %7 --client /dev/ttys007
_assert_contains "copy standalone: OSC 52 targets the exact initiating client" \
  'load-buffer -w -t /dev/ttys007 -' "$(cat "$tmp/standalone-tmux.log")"
_assert_file_content "copy standalone: scoped transport gets selected content" \
  '$ echo two
two output' "$tmp/standalone-copied"
_assert_contains "copy standalone: finds the client among all attached clients" \
  'list-clients -F #{client_name}' "$(cat "$tmp/standalone-tmux.log")"
_assert_not_contains "copy standalone: never asks display-message -c for the client" \
  'display-message -p -c' "$(cat "$tmp/standalone-tmux.log")"
_assert_contains "copy standalone: tells the pressing client" \
  '-c /dev/ttys007 -t %7 Copied last command' "$(cat "$tmp/standalone-message.log")"
# The client leaves before its message: tmux drops it, and no other client
# gets it in its place.
rm -f "$tmp/standalone-copied" "$tmp/standalone-tmux.log" "$tmp/standalone-gone-message.log"
TMUX_CAPTURE_FILE="$tmp/pane.txt" TMUX_MESSAGE_LOG="$tmp/standalone-gone-message.log" \
  TMUX_CALL_LOG="$tmp/standalone-tmux.log" TMUX_TEST_CLIENT_GONE=1 \
  PBCOPY_OUT="$tmp/standalone-copied" PATH="$standalone_bin" \
  "$ROOT/bin/tmux-copy-last-output" --pane %7 --client /dev/ttys007
_assert_exit "copy standalone, client gone before its message: succeeds" 0 "$?"
_assert_file_content "copy standalone, client gone before its message: copies the content" \
  '$ echo two
two output' "$tmp/standalone-copied"
_assert_eq "copy standalone, client gone before its message: no other client is told" \
  '' "$(cat "$tmp/standalone-gone-message.log" 2>/dev/null)"
rm -f "$tmp/standalone-copied" "$tmp/standalone-tmux.log"
TMUX_CAPTURE_FILE="$tmp/pane.txt" TMUX_MESSAGE_LOG="$tmp/standalone-missing-message.log" \
  TMUX_CALL_LOG="$tmp/standalone-tmux.log" TMUX_TEST_CLIENT_NAME=/dev/ttys008 \
  PBCOPY_OUT="$tmp/standalone-copied" PATH="$standalone_bin" \
  "$ROOT/bin/tmux-copy-last-output" --pane %7 --client /dev/ttys007
_assert_file_missing "copy standalone: detached client cannot copy elsewhere" \
  "$tmp/standalone-copied"
_assert_contains "copy standalone: detached client is explained" \
  'initiating client is no longer attached' "$(cat "$tmp/standalone-missing-message.log")"
TMUX_CAPTURE_FILE="$tmp/pane.txt" TMUX_MESSAGE_LOG="$tmp/standalone-unscoped-message.log" \
  TMUX_CALL_LOG="$tmp/standalone-unscoped-tmux.log" \
  PBCOPY_OUT="$tmp/standalone-copied" PATH="$standalone_bin" \
  "$ROOT/bin/tmux-copy-last-output"
_assert_file_missing "copy standalone: absent clipboard never guesses a client" \
  "$tmp/standalone-copied"
_assert_contains "copy standalone: missing explicit client is explained" \
  'pass --pane and --client for OSC 52' "$(cat "$tmp/standalone-unscoped-message.log")"

printed=$(TMUX_CAPTURE_FILE="$tmp/pane.txt" \
  TMUX_MESSAGE_LOG="$tmp/print-two-message.log" \
  PBCOPY_OUT="$tmp/print-two-copy.txt" \
  PATH="$mock_bin:$PATH" \
  "$ROOT/bin/tmux-copy-last-output" --print 2)
_assert_eq "print count: writes the requested blocks" \
  '$ echo one
one output

$ echo two
two output' "$printed"

# An empty result fails so a pipeline routes nothing, and is still reported.
printed=$(TMUX_CAPTURE_FILE="$tmp/no-command.txt" \
  TMUX_MESSAGE_LOG="$tmp/print-empty-message.log" \
  PBCOPY_OUT="$tmp/print-empty-copy.txt" \
  PATH="$mock_bin:$PATH" \
  "$ROOT/bin/tmux-copy-last-output" --print)
_assert_exit "print no output: exits with its own status" 3 "$?"
_assert_eq "print no output: writes nothing" "" "$printed"
_assert_contains "print no output: reports missing block" \
  "No command output found" "$(cat "$tmp/print-empty-message.log")"

# Parser regressions (shared with tmux-pane; see its suite for the region
# identity test). Bash prints the prompt right after output that has no final
# newline, so line 1 arrives glued to that output.
parse_print() { # parse_print CAPTURE_FILE [COUNT]
  TMUX_CAPTURE_FILE="$1" TMUX_MESSAGE_LOG="$tmp/parse-message.log" \
    PBCOPY_OUT="$tmp/parse-copy.txt" PATH="$mock_bin:$PATH" \
    "$ROOT/bin/tmux-copy-last-output" --print ${2:+"$2"}
}
cat >"$tmp/glued.txt" <<'EOF'
user@test:/repo (main)
$ printf ok; false
ok[1] user@test:/repo (main)
$
EOF
_assert_eq "rg_p2 parser: glued output before a [N] status is the output" \
  '$ printf ok; false
ok' "$(parse_print "$tmp/glued.txt")"
cat >"$tmp/glued-dots.txt" <<'EOF'
user@test:/repo (main)
$ printf 1.2.3
1.2.3user@test:/repo (main)
$
EOF
_assert_eq "rg_p3 parser: glued 1.2.3 splits from the prompt" \
  '$ printf 1.2.3
1.2.3' "$(parse_print "$tmp/glued-dots.txt")"
cat >"$tmp/glued-twice.txt" <<'EOF'
user@test:/repo (main)
$ printf a
auser@test:/repo (main)
$ printf b
buser@test:/repo (main)
$
EOF
_assert_eq "rg_p5 parser: two glued outputs in a row agree on one identity" \
  '$ printf a
a

$ printf b
b' "$(parse_print "$tmp/glued-twice.txt" 2)"
cat >"$tmp/root-prompt.txt" <<'EOF'
root@box:/ (main)
# id -u
0
root@box:/ (main)
#
EOF
_assert_eq "rg_p12 parser: a # line 2 is a prompt" \
  '# id -u
0' "$(parse_print "$tmp/root-prompt.txt")"
# A # line 2 also starts comments and headings, so its line 1 must start
# with the identity: an address line in output followed by `# Install` stays
# output.
cat >"$tmp/root-in-output.txt" <<'EOF'
user@test:/repo (main)
$ cat notes.md
git@github.com:me/tool.git
# Install
run it
user@test:/repo (main)
$
EOF
_assert_eq "parser: an address and a # line in output are not a prompt" \
  '$ cat notes.md
git@github.com:me/tool.git
# Install
run it' "$(parse_print "$tmp/root-in-output.txt")"
cat >"$tmp/root-glued.txt" <<'EOF'
user@test:/repo (main)
$ cat deploy.txt
rsync -a build/ user@test:/srv/app
# restart
user@test:/repo (main)
$
EOF
_assert_eq "parser: the identity inside output before a # line is not a prompt" \
  '$ cat deploy.txt
rsync -a build/ user@test:/srv/app
# restart' "$(parse_print "$tmp/root-glued.txt")"
# Output that ends in a space (printf '%s ' x y) glues to the next prompt
# with a space before the identity. It is a prompt when the rest of the line
# repeats an unglued prompt; a line that only mentions the identity above a
# $ line stays output.
cat >"$tmp/glue-space.txt" <<'EOF'
user@test:/repo (main)
$ printf '%s ' x y
x y user@test:/repo (main)
$ echo next
next
user@test:/repo (main)
$
EOF
_assert_eq "parser: output ending in a space glued to the prompt is its own block" \
  "\$ printf '%s ' x y
x y 

\$ echo next
next" "$(parse_print "$tmp/glue-space.txt" 2)"
cat >"$tmp/glue-mention.txt" <<'EOF'
user@test:/repo (main)
$ cat log.txt
Copy to user@test:/srv
$ not a prompt
user@test:/repo (main)
$
EOF
_assert_eq "parser: a line that mentions the identity above a \$ line is output" \
  '$ cat log.txt
Copy to user@test:/srv
$ not a prompt' "$(parse_print "$tmp/glue-mention.txt")"
cat >"$tmp/status-prompt.txt" <<'EOF'
user@test:/repo (main)
$ false
[1] user@test:/repo (main)
$ echo after
after
user@test:/repo (main)
$
EOF
_assert_eq "parser: a leading [N] status keeps the prompt anchored" \
  '$ false

$ echo after
after' "$(parse_print "$tmp/status-prompt.txt" 2)"

echo
echo "=== term-notify-sound ==="

# Keep every call's log line out of the real state directory; the log tests
# below set their own path.
export TERM_NOTIFY_LOG="$tmp/notify-calls.log"

notify_home="$tmp/notify-home"
direct_vscode_tty="$tmp/direct-vscode.tty"
env -u TMUX -u XDG_STATE_HOME HOME="$notify_home" TERM_PROGRAM=xterm.js \
  TERM_NOTIFY_TTY="$direct_vscode_tty" \
  PATH="$mock_bin:$PATH" \
  "$ROOT/bin/term-notify-sound" >/dev/null
_assert_file_content "notify: direct VS Code emits one BEL" \
  $'\a' "$direct_vscode_tty"
_assert_file_missing "notify: direct VS Code uses no state-file transport" \
  "$notify_home/.local/state/term-notify/signal"

vscode_no_home_err="$tmp/vscode-no-home.err"
vscode_no_home_tty="$tmp/vscode-no-home.tty"
env -u HOME -u TMUX -u XDG_STATE_HOME TERM_PROGRAM=xterm.js \
  TERM_NOTIFY_TTY="$vscode_no_home_tty" \
  PATH="$mock_bin:$PATH" \
  "$ROOT/bin/term-notify-sound" >/dev/null 2>"$vscode_no_home_err"
_assert_exit "notify: direct VS Code needs no filesystem state root" "0" "$?"
_assert_eq "notify: direct VS Code reports no state-path error" \
  "" "$(cat "$vscode_no_home_err")"
_assert_file_content "notify: HOME-less VS Code still emits one BEL" \
  $'\a' "$vscode_no_home_tty"

for terminal in WezTerm unknown-terminal; do
  terminal_tty="$tmp/direct-$terminal.tty"
  env -u HOME -u TMUX -u XDG_STATE_HOME TERM_PROGRAM="$terminal" \
    TERM_NOTIFY_TTY="$terminal_tty" \
    PATH="$mock_bin:$PATH" "$ROOT/bin/term-notify-sound" \
    >/dev/null 2>"$tmp/notify-$terminal.err"
  _assert_exit "notify: $terminal transport does not require a state root" "0" "$?"
