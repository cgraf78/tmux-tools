  TMUX_SET_LOG="$lifecycle_log" PATH="$mock_bin:$PATH" \
    "$ROOT/bin/term-pane-mark" "${argv[@]}" --pane %32
done
_assert_file_content "mark: success, ordinary notification, and clear remove stale failure" \
  'set-option -p -t %32 @term_notify_exit_status 7 ; set-option -p -t %32 @term_notify_pending 1
set-option -pu -t %32 @term_notify_exit_status ; set-option -p -t %32 @term_notify_pending 1
set-option -p -t %32 @term_notify_exit_status 9 ; set-option -p -t %32 @term_notify_pending 1
