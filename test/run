#!/usr/bin/env bash

set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# Shared CI owns one required inventory lint; local runs still lint by default.
if [[ "${TMUX_TOOLS_SKIP_SHELLCHECK:-0}" != 1 ]] &&
  command -v shellcheck >/dev/null 2>&1; then
  shell_files=()
  while IFS=$'\t' read -r record_type path ||
    [[ -n "$record_type$path" ]]; do
    if [[ "$record_type" == program ]]; then
      shell_files+=("$ROOT/$path")
    fi
  done <"$ROOT/.github/shellcheck-files.txt"
  ((${#shell_files[@]} > 0)) || {
    printf 'test/run: ShellCheck inventory has no programs\n' >&2
    exit 1
  }
  (
    cd "$ROOT"
    shellcheck -x -P SCRIPTDIR "${shell_files[@]}"
  )
fi

"$ROOT/test/tmux-tools-harness-test"
"$ROOT/test/tmux-continuum-test"
"$ROOT/test/tmux-tools-test"
"$ROOT/test/copy-mark-test"
"$ROOT/test/term-pane-state-test"
if command -v python3 >/dev/null 2>&1; then
  python3 "$ROOT/test/term-pane-state-client.py"
else
  if [[ ${TMUX_TOOLS_REQUIRE_TMUX:-0} == 1 ]]; then
    printf 'FAIL: Python required for real-client attention test\n' >&2
    exit 1
  fi
  printf 'SKIP: Python unavailable for real-client attention test\n'
fi
"$ROOT/test/term-pane-mark-token-test"
